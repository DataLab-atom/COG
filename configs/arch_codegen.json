{
  "preset": "fast",
  "description": "根据函数签名、调用上下文和类信息生成 Python 函数体",
  "long_running": false,
  "skills": [
    "skills/arch_to_project.json"
  ],
  "agent_name": "arch_codegen",
  "model": "openai/gpt-5-mini",
  "system_prompt_path": "./prompts/arch_codegen/system.txt",
  "user_prompt_path": "./prompts/arch_codegen/user.txt",
  "system_variables": [],
  "user_variables": [
    "metric_name",
    "fn_id",
    "description",
    "is_async",
    "is_init",
    "params_json",
    "returns_json",
    "calls_context_json",
    "calls_bodies_json",
    "class_context_json",
    "file_fns_json",
    "reference_code",
    "init_body",
    "data_files_json"
  ],
  "json_schema": {
    "type": "object",
    "required": [
      "body",
      "imports"
    ],
    "additionalProperties": false,
    "properties": {
      "body": {
        "type": "string",
        "minLength": 1,
        "description": "函数体代码，\\n 换行，4空格缩进，不含 def 行"
      },
      "imports": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "该函数体需要的外部库 import 语句列表，如 [\"import torch\", \"import numpy as np\"]；无外部依赖则填 []"
      }
    }
  }
}

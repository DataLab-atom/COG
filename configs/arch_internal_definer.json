{
  "preset": "fast",
  "description": "为单个 type:: 或 fn:: 定义内部节点（由 arch_internal_fanout 全量并发调用）",
  "long_running": false,
  "skills": [
    "skills/arch_builder.json"
  ],
  "agent_name": "arch_internal_definer",
  "model": "gpt-4o",
  "system_prompt_path": "./prompts/arch_internal_define/system.txt",
  "user_prompt_path": "./prompts/arch_internal_define/user.txt",
  "system_variables": [],
  "user_variables": [
    "requirement",
    "metric_name",
    "direction",
    "file_json",
    "global_ids_json",
    "target_id"
  ],
  "json_schema": {
    "type": "object",
    "required": [
      "types",
      "functions"
    ],
    "additionalProperties": false,
    "properties": {
      "types": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "base_class",
            "constants",
            "fields",
            "init_fn",
            "overloads"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^type::.+"
            },
            "base_class": {
              "type": [
                "string",
                "null"
              ]
            },
            "constants": {
              "type": "array",
              "description": "类级别常量，静态展开到 class body 顶部",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "description": "常量值的字符串表示"
                  }
                }
              }
            },
            "fields": {
              "type": "array",
              "description": "__init__ 参数列表，用于推导方法签名",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "init_fn": {
              "type": [
                "string",
                "null"
              ],
              "description": "null=静态 self.x=x；有值=fn:: id，该函数需标注 is_init:true，走 fn_codegen_fanout"
            },
            "overloads": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "method",
                  "fn",
                  "args"
                ],
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fn": {
                    "type": "string",
                    "pattern": "^fn::.+"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      },
      "functions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "description",
            "is_async",
            "params",
            "returns",
            "calls",
            "needs",
            "reference"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^fn::.+"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "is_async": {
              "type": "boolean"
            },
            "is_init": {
              "type": "boolean",
              "description": "是否为 __init__ 函数体；scaffold 会将其生成为 __init__ 占位符而非独立函数"
            },
            "params": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "returns": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "calls": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^fn::.+"
              }
            },
            "needs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "location",
                  "description",
                  "params",
                  "returns",
                  "depth"
                ],
                "additionalProperties": false,
                "properties": {
                  "location": {
                    "type": "string",
                    "pattern": "^file::.+"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "params": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "type"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "type": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "returns": {
                    "type": "object",
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "depth": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  }
                }
              }
            },
            "reference": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "source",
                    "target",
                    "note"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "timeout": 90.0,
  "params": {
    "temperature": 0.3
  }
}

{
  "preset": "default",
  "description": "分析架构树，制定需要补全的节点计划列表（每项只含 op/target/简短说明，不含完整数据）",
  "long_running": false,
  "agent_name": "arch_augment_plan",
  "model": "openai/gpt-5-mini",
  "system_prompt_path": "./prompts/arch_augment_plan/system.txt",
  "user_prompt_path": "./prompts/arch_augment_plan/user.txt",
  "system_variables": [],
  "user_variables": [
    "metric_name",
    "requirement",
    "tree_json"
  ],
  "json_schema": {
    "type": "object",
    "required": [
      "needs_augmentation",
      "reasoning",
      "plan_items"
    ],
    "additionalProperties": false,
    "properties": {
      "needs_augmentation": {
        "type": "boolean",
        "description": "是否需要补全"
      },
      "reasoning": {
        "type": "string",
        "description": "简短说明判断依据"
      },
      "plan_items": {
        "type": "array",
        "description": "需要新增或修改的节点计划，不需要补全时为空数组",
        "items": {
          "type": "object",
          "required": [
            "op",
            "target_id",
            "target_file",
            "brief_description"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "add_fn",
                "add_file",
                "modify_fn"
              ]
            },
            "target_id": {
              "type": "string"
            },
            "target_file": {
              "type": "string"
            },
            "brief_description": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "params": {
    "temperature": 0.1,
    "max_tokens": 4096
  }
}

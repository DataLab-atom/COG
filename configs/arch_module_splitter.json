{
  "description": "将需求描述划分为职责清晰的模块（文件夹）列表",
  "long_running": false,
  "skills": ["skills/arch_builder.json"],
  "agent_name": "arch_module_splitter",
  "model": "gpt-4o",
  "system_prompt_path": "./prompts/arch_module_split/system.txt",
  "user_prompt_path": "./prompts/arch_module_split/user.txt",
  "system_variables": [],
  "user_variables": ["requirement"],
  "json_output": true,
  "use_instructor": false,
  "json_schema": {
    "type": "array",
    "items": {
      "type": "object",
      "required": ["id", "root", "description", "imports", "exports", "files"],
      "properties": {
        "id":          { "type": "string", "description": "mod::<name>" },
        "root":        { "type": "boolean" },
        "description": { "type": "string" },
        "imports":     { "type": "array", "items": { "type": "string" } },
        "exports":     { "type": "array", "items": { "type": "string" } },
        "files":       { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "enable_history": false,
  "timeout": 60.0,
  "max_retries": 3,
  "params": {
    "max_tokens": 2048,
    "temperature": 0.2
  }
}

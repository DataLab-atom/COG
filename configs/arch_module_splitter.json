{
  "preset": "fast",
  "description": "将需求描述划分为职责清晰的模块（文件夹）列表",
  "long_running": false,
  "skills": [
    "skills/arch_builder.json"
  ],
  "agent_name": "arch_module_splitter",
  "model": "gpt-4o-mini",
  "system_prompt_path": "./prompts/arch_module_split/system.txt",
  "user_prompt_path": "./prompts/arch_module_split/user.txt",
  "system_variables": [],
  "user_variables": [
    "requirement",
    "metric_name",
    "direction"
  ],
  "json_schema": {
    "type": "object",
    "required": [
      "result"
    ],
    "additionalProperties": false,
    "properties": {
      "result": {
        "type": "array",
        "description": "模块列表",
        "items": {
          "type": "object",
          "required": [
            "id",
            "root",
            "description",
            "imports",
            "exports",
            "files"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^mod::.+",
              "description": "模块唯一标识，格式 mod::<name>"
            },
            "root": {
              "type": "boolean",
              "description": "是否为根模块（项目根目录）"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "模块职责边界描述"
            },
            "imports": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^mod::.+"
              },
              "description": "直接依赖的其它模块 id 列表"
            },
            "exports": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "对外暴露的 id 列表，本阶段留空"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "包含的 file id 列表，本阶段留空"
            }
          }
        }
      }
    }
  },
  "params": {
    "max_tokens": 2048
  }
}

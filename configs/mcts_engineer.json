{
  "description": "MCTS Engineer：根据原子任务（action/target/direction）生成一份替换或新建代码",
  "long_running": false,
  "skills": ["skills/mcts_engineer.json"],
  "agent_name": "mcts_engineer",
  "model": "gpt-4o",
  "system_prompt_path": "./prompts/mcts_engineer/system.txt",
  "user_prompt_path": "./prompts/mcts_engineer/user.txt",
  "system_variables": [],
  "user_variables": [
    "action",
    "target_file", "target_type", "target_name",
    "original_code",
    "direction", "reasoning"
  ],
  "json_output": true,
  "use_instructor": false,
  "json_schema": {
    "type": "object",
    "required": ["code"],
    "additionalProperties": false,
    "properties": {
      "code": {
        "type": "string",
        "minLength": 1,
        "description": "完整的替换或新建代码，以 ```python ... ``` 包裹"
      }
    }
  },
  "enable_history": false,
  "timeout": 90.0,
  "max_retries": 2,
  "params": {
    "max_tokens": 4096,
    "temperature": 0.8
  }
}

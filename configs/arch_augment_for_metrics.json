{
  "preset": "default",
  "description": "检查现有项目架构树是否具备计算目标指标的函数，缺失时生成 patch_chain 补全所需架构节点",
  "long_running": false,
  "skills": [
    "skills/arch_augment_for_metrics.json"
  ],
  "agent_name": "arch_augment_for_metrics",
  "model": "openai/gpt-5-mini",
  "system_prompt_path": "./prompts/arch_augment_for_metrics/system.txt",
  "user_prompt_path": "./prompts/arch_augment_for_metrics/user.txt",
  "system_variables": [],
  "user_variables": [
    "metric_name",
    "requirement",
    "tree_json"
  ],
  "json_schema": {
    "type": "object",
    "required": [
      "needs_augmentation",
      "reasoning",
      "patch_chain"
    ],
    "additionalProperties": false,
    "properties": {
      "needs_augmentation": {
        "type": "boolean",
        "description": "是否需要补全指标计算节点"
      },
      "reasoning": {
        "type": "string",
        "description": "简短说明判断依据"
      },
      "patch_chain": {
        "type": "array",
        "description": "设计级 patch 列表，不需要补全时为空数组",
        "items": {
          "type": "object",
          "required": [
            "op",
            "target_id",
            "target_file",
            "depends_on",
            "data"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "add_fn",
                "add_file",
                "modify_fn"
              ]
            },
            "target_id": {
              "type": "string"
            },
            "target_file": {
              "type": "string"
            },
            "depends_on": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description",
                "path",
                "module_id",
                "is_async",
                "calls",
                "params",
                "returns"
              ],
              "properties": {
                "description": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "path": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "module_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "is_async": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "calls": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "params": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "name",
                          "type"
                        ],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "returns": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "params": {
    "temperature": 0.1,
    "max_tokens": 4096
  }
}

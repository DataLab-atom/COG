{
  "preset": "default",
  "description": "将方法论章节所有子任务写作结果整合为连贯的 Methodology 章节",
  "long_running": false,
  "skills": [
    "skills/papw_method_writing.json"
  ],
  "agent_name": "papw_method_integration",
  "system_prompt_path": "./prompts/papw_method_integration/system.txt",
  "user_prompt_path": "./prompts/papw_method_integration/user.txt",
  "system_variables": [
    "overall_write_task"
  ],
  "user_variables": [
    "done_write"
  ],
  "json_schema": {
    "type": "object",
    "required": [
      "integration_result"
    ],
    "additionalProperties": false,
    "properties": {
      "integration_result": {
        "type": "string",
        "description": "整合后的方法论章节内容（Markdown 格式）"
      }
    }
  }
}

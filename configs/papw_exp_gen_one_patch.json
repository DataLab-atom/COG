{
  "preset": "strong",
  "description": "为单个函数生成实验 patch：根据变更意图、项目架构和已有 patches 生成代码修改",
  "long_running": false,
  "skills": [
    "skills/papw_experimenting.json"
  ],
  "agent_name": "papw_exp_gen_one_patch",
  "system_prompt_path": "./prompts/papw_exp_gen_one_patch/system.txt",
  "user_prompt_path": "./prompts/papw_exp_gen_one_patch/user.txt",
  "system_variables": [],
  "user_variables": [
    "current_change",
    "arch_tree",
    "best_patches",
    "patches_so_far"
  ],
  "json_schema": {
    "type": "object",
    "required": [
      "target_name",
      "file_path",
      "code"
    ],
    "additionalProperties": false,
    "properties": {
      "target_name": {
        "type": "string",
        "description": "目标函数名"
      },
      "file_path": {
        "type": "string",
        "description": "目标文件相对路径"
      },
      "code": {
        "type": "string",
        "description": "完整的替换函数代码"
      }
    }
  }
}

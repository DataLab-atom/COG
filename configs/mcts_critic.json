{
  "preset": "fast",
  "description": "MCTS Critic：针对指定 operator，分析项目代码并提出一个具体的优化目标",
  "long_running": false,
  "skills": [
    "skills/mcts_critic.json"
  ],
  "agent_name": "mcts_critic",
  "model": "openai/gpt-5-mini",
  "system_prompt_path": "./prompts/mcts_critic/system.txt",
  "user_prompt_path": "./prompts/mcts_critic/user.txt",
  "system_variables": [
    "op"
  ],
  "user_variables": [
    "demand",
    "tree_text",
    "history_prompt",
    "baseline_log",
    "node_summary"
  ],
  "json_schema": {
    "type": "object",
    "required": [
      "node_a_file",
      "node_a_type",
      "node_a_name",
      "node_b_file",
      "node_b_type",
      "node_b_name",
      "direction",
      "reasoning"
    ],
    "additionalProperties": false,
    "properties": {
      "node_a_file": {
        "type": "string",
        "description": "主节点（二元算子的 A，多元算子的入口节点）所在文件相对路径"
      },
      "node_a_type": {
        "type": "string",
        "enum": [
          "function",
          "class"
        ],
        "description": "主节点的类型"
      },
      "node_a_name": {
        "type": "string",
        "description": "主节点的函数名或类名"
      },
      "node_b_file": {
        "type": "string",
        "description": "次节点（二元算子的 B，多元算子的出口节点）所在文件相对路径"
      },
      "node_b_type": {
        "type": "string",
        "enum": [
          "function",
          "class"
        ],
        "description": "次节点的类型"
      },
      "node_b_name": {
        "type": "string",
        "description": "次节点的函数名或类名"
      },
      "direction": {
        "type": "string",
        "description": "一句话结构改造方向描述"
      },
      "reasoning": {
        "type": "string",
        "description": "为何该结构改造能提升指标的理由"
      },
      "new_nodes": {
        "type": "array",
        "description": "insert/split/extract 算子需要新建的节点列表；其他算子省略此字段",
        "items": {
          "type": "object",
          "required": [
            "name",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "新节点的函数名或类名"
            },
            "description": {
              "type": "string",
              "description": "新节点的职责说明（一句话）"
            }
          }
        }
      }
    }
  },
  "max_retries": 2,
  "params": {
    "temperature": 0.6
  }
}

{
  "preset": "default",
  "description": "分析人类对架构树的反馈，选择 patch_chain（局部修改）或 full_rebuild（全量重建）策略，并生成具体的设计级 patch 列表",
  "long_running": false,
  "agent_name": "arch_feedback_classifier",
  "model": "gpt-4o",
  "system_prompt_path": "./prompts/arch_feedback_classifier/system.txt",
  "user_prompt_path": "./prompts/arch_feedback_classifier/user.txt",
  "system_variables": [],
  "user_variables": [
    "tree_json",
    "requirement",
    "feedback"
  ],
  "json_schema": {
    "type": "object",
    "required": [
      "strategy",
      "use_patches",
      "reasoning",
      "patch_chain"
    ],
    "additionalProperties": false,
    "properties": {
      "strategy": {
        "type": "string",
        "enum": [
          "patch_chain",
          "full_rebuild"
        ],
        "description": "修改策略"
      },
      "use_patches": {
        "type": "boolean",
        "description": "true = 使用 patch_chain；false = 使用 full_rebuild"
      },
      "reasoning": {
        "type": "string",
        "description": "选择此策略的简短原因说明"
      },
      "patch_chain": {
        "type": "array",
        "description": "设计级 patch 列表（strategy=full_rebuild 时为空数组）",
        "items": {
          "type": "object",
          "required": [
            "op",
            "target_id",
            "target_file",
            "depends_on",
            "data"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "add_fn",
                "remove_fn",
                "modify_fn",
                "add_file",
                "remove_file",
                "modify_file",
                "add_module",
                "remove_module",
                "add_fn_call",
                "remove_fn_call",
                "add_file_import",
                "remove_file_import"
              ]
            },
            "target_id": {
              "type": "string"
            },
            "target_file": {
              "type": "string"
            },
            "depends_on": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description",
                "path",
                "module_id",
                "is_async",
                "calls",
                "params",
                "returns"
              ],
              "properties": {
                "description": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "path": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "module_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "is_async": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "file_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "add_file_import / remove_file_import 用，目标 file 节点 id（缺省时用 target_id）"
                },
                "import_from": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "add_file_import / remove_file_import 用，被导入的模块或 file::id"
                },
                "import_names": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "add_file_import / remove_file_import 用，导入的名称列表"
                },
                "calls": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "params": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "name",
                          "type"
                        ],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "returns": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "params": {
    "temperature": 0.1,
    "max_tokens": 4096
  }
}

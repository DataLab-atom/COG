{
  "preset": "fast",
  "description": "为单个文件定义所有叶子节点（无内部依赖的 type 和 fn）",
  "long_running": false,
  "skills": [
    "skills/arch_builder.json"
  ],
  "agent_name": "arch_leaf_definer",
  "model": "gpt-4o",
  "system_prompt_path": "./prompts/arch_leaf_define/system.txt",
  "user_prompt_path": "./prompts/arch_leaf_define/user.txt",
  "system_variables": [],
  "user_variables": [
    "requirement",
    "metric_name",
    "direction",
    "file_json",
    "global_ids_json"
  ],
  "json_schema": {
    "type": "object",
    "required": [
      "types",
      "functions"
    ],
    "additionalProperties": false,
    "properties": {
      "types": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "base_class",
            "constants",
            "fields",
            "init_fn",
            "overloads"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^type::.+"
            },
            "base_class": {
              "type": [
                "string",
                "null"
              ],
              "description": "父类名，纯数据类型填 null"
            },
            "constants": {
              "type": "array",
              "description": "类级别常量，静态展开到 class body 顶部",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "description": "常量值的字符串表示"
                  }
                }
              }
            },
            "fields": {
              "type": "array",
              "description": "__init__ 参数列表，用于推导方法签名",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "init_fn": {
              "type": [
                "string",
                "null"
              ],
              "description": "null=静态 self.x=x；有值=fn:: id，该函数需标注 is_init:true，走 fn_codegen_fanout"
            },
            "overloads": {
              "type": "array",
              "maxItems": 0,
              "items": {
                "type": "string"
              },
              "description": "叶子 type 不允许有 overloads"
            }
          }
        }
      },
      "functions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "description",
            "is_async",
            "params",
            "returns",
            "calls",
            "needs",
            "reference"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^fn::.+"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "is_async": {
              "type": "boolean"
            },
            "is_init": {
              "type": "boolean",
              "description": "是否为 __init__ 函数体；scaffold 会将其生成为 __init__ 占位符而非独立函数"
            },
            "params": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "returns": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "calls": {
              "type": "array",
              "maxItems": 0,
              "items": {
                "type": "string"
              },
              "description": "叶子 fn 不允许有 calls"
            },
            "needs": {
              "type": "array",
              "maxItems": 0,
              "items": {
                "type": "string"
              },
              "description": "叶子 fn 不允许有 needs"
            },
            "reference": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "source",
                    "target",
                    "note"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "timeout": 90.0
}

{
  "preset": "fast",
  "description": "从需求描述中解析优化目标，输出结构化 metric_spec（metric_name + direction）",
  "long_running": false,
  "skills": [
    "skills/validation_agent.json"
  ],
  "agent_name": "validation_agent",
  "model": "gpt-4o-mini",
  "system_prompt_path": "./prompts/validation_agent/system.txt",
  "user_prompt_path": "./prompts/validation_agent/user.txt",
  "system_variables": [],
  "user_variables": [
    "requirement"
  ],
  "json_schema": {
    "type": "object",
    "required": [
      "metric_name",
      "direction"
    ],
    "additionalProperties": false,
    "properties": {
      "metric_name": {
        "type": "string",
        "minLength": 1,
        "description": "标准化指标名称，小写下划线，例如 nmse、per_class_accuracy"
      },
      "direction": {
        "type": "string",
        "enum": [
          "minimize",
          "maximize"
        ],
        "description": "优化方向：minimize 表示越小越好，maximize 表示越大越好"
      }
    }
  },
  "params": {
    "max_tokens": 256
  }
}

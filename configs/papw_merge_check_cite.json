{
  "preset": "strong",
  "description": "检查论文引用一致性并修正",
  "long_running": false,
  "skills": [
    "skills/papw_merge_writing.json"
  ],
  "agent_name": "papw_merge_check_cite",
  "system_prompt_path": "./prompts/papw_merge_check_cite/system.txt",
  "user_prompt_path": "./prompts/papw_merge_check_cite/user.txt",
  "system_variables": [],
  "user_variables": [
    "tex_and_bib"
  ],
  "json_schema": {
    "type": "object",
    "required": [
      "verified",
      "corrected_tex"
    ],
    "additionalProperties": false,
    "properties": {
      "verified": {
        "type": "boolean",
        "description": "引用是否全部正确"
      },
      "corrected_tex": {
        "type": "string",
        "description": "修正后的 LaTeX 内容"
      }
    }
  },
  "timeout": 180.0
}

{
  "name": "papw_experimenting",
  "description": "实验分析子图：GET 模式（摘要提取 → 研究方向 → 方法命名 → 方法陈述 → 分析角度）+ DOING 模式（map 并行：实验代码生成 → 执行 → 绘图 → 分析）",
  "long_running": true,
  "skills": ["skills/papw_experimenting.json"],
  "variables": [
    "papw_root",
    "bib_path",
    "experiment_vb_path",
    "md_dir",
    "project_root",
    "arch_tree",
    "best_patches",
    "text_model_name",
    "embedding_model",
    "embedding_model_source",
    "reranker_path",
    "reranker_model_source",
    "database_device"
  ],
  "steps": [
    {
      "id": "paths",
      "type": "tool",
      "ref": "tools/papw_exp_paths.json",
      "inputs": {
        "papw_root": "$.papw_root"
      }
    },
    {
      "id": "list_papers",
      "type": "tool",
      "ref": "tools/papw_exp_list_papers.json",
      "inputs": {
        "md_dir": "$.md_dir"
      }
    },
    {
      "id": "extract_abstracts",
      "type": "map",
      "depends_on": ["list_papers"],
      "over": "list_papers.papers",
      "as": "paper",
      "step": {
        "type": "agent",
        "ref": "configs/papw_exp_extract_abstract.json",
        "inputs": {
          "paper_content": "$.paper.content"
        }
      },
      "collect": "abstract"
    },
    {
      "id": "collect_abstracts",
      "type": "tool",
      "ref": "tools/papw_exp_collect_abstracts.json",
      "depends_on": ["extract_abstracts", "list_papers"],
      "inputs": {
        "abstract_results": "extract_abstracts",
        "paper_names": "list_papers.papers"
      }
    },
    {
      "id": "main_research",
      "type": "agent",
      "ref": "configs/papw_exp_main_research.json",
      "depends_on": ["collect_abstracts"],
      "inputs": {
        "abstracts_text": "collect_abstracts.abstracts_text"
      }
    },
    {
      "id": "name_method",
      "type": "agent",
      "ref": "configs/papw_exp_name_method.json",
      "inputs": {
        "arch_tree": "$.arch_tree",
        "best_patches": "$.best_patches"
      }
    },
    {
      "id": "method_statement",
      "type": "agent",
      "ref": "configs/papw_exp_method_statement.json",
      "depends_on": ["name_method", "main_research"],
      "inputs": {
        "method_name": "name_method.method_naming",
        "main_research": "main_research.main_research",
        "arch_tree": "$.arch_tree",
        "best_patches": "$.best_patches"
      }
    },
    {
      "id": "save_research_info",
      "type": "tool",
      "ref": "tools/papw_exp_save_research_info.json",
      "depends_on": ["method_statement"],
      "inputs": {
        "research_info_path": "paths.research_info_path",
        "method_name": "name_method.method_naming",
        "main_research": "main_research.main_research",
        "method_statement": "method_statement.method_statement",
        "abstracts_count": "collect_abstracts.abstracts_count"
      }
    },
    {
      "id": "vdb_retrieve",
      "type": "input",
      "ref": "input/papw_vdb_search_rerank.json",
      "depends_on": ["method_statement"],
      "inputs": {
        "persist_directory_path": "$.experiment_vb_path",
        "query": "method_statement.method_statement",
        "retrieval_num": 20,
        "embedding_model": "$.embedding_model",
        "embedding_model_source": "$.embedding_model_source",
        "reranker_path": "$.reranker_path",
        "reranker_model_source": "$.reranker_model_source",
        "database_device": "$.database_device"
      }
    },
    {
      "id": "gen_perspectives",
      "type": "agent",
      "ref": "configs/papw_exp_perspectives.json",
      "depends_on": ["vdb_retrieve", "method_statement", "main_research"],
      "inputs": {
        "method_statement": "method_statement.method_statement",
        "main_research": "main_research.main_research",
        "reference_info": "vdb_retrieve.formatted_text",
        "num_perspectives": 3
      }
    },
    {
      "id": "save_perspectives",
      "type": "tool",
      "ref": "tools/papw_exp_save_perspectives.json",
      "depends_on": ["gen_perspectives"],
      "inputs": {
        "perspective_base": "paths.perspective_base",
        "perspectives": "gen_perspectives.perspectives"
      }
    },
    {
      "id": "do_experiments",
      "type": "map",
      "depends_on": ["save_perspectives"],
      "over": "save_perspectives.perspective_names",
      "as": "p_name",
      "step": {
        "type": "graph",
        "ref": "graphs/papw_exp_single_perspective.json",
        "inputs": {
          "perspective_base": "paths.perspective_base",
          "p_name": "$.p_name",
          "project_root": "$.project_root",
          "arch_tree": "$.arch_tree",
          "best_patches": "$.best_patches",
          "text_model_name": "$.text_model_name"
        }
      },
      "collect": {
        "experiment_results": "experiment_result"
      }
    },
    {
      "id": "write_explain",
      "type": "tool",
      "ref": "tools/papw_exp_write_data_explain.json",
      "depends_on": ["do_experiments"],
      "inputs": {
        "papw_root": "$.papw_root",
        "perspective_base": "paths.perspective_base",
        "perspective_names": "save_perspectives.perspective_names"
      }
    }
  ],
  "outputs": {
    "result_perspective_path": "paths.perspective_base",
    "research_info_path": "paths.research_info_path",
    "perspectives": "save_perspectives.perspective_names",
    "experiment_results": "do_experiments.experiment_results"
  }
}

{
  "name": "arch_codegen_single",
  "description": "单函数体生成子图：从任务上下文和依赖输出准备变量，调用 arch_codegen agent",
  "long_running": false,
  "skills": ["skills/arch_codegen_single.json"],
  "variables": ["task", "_deps", "metric_name", "data_files"],
  "steps": [
    {
      "id": "prepare",
      "type": "tool",
      "ref": "arch_prepare_codegen_vars",
      "inputs": {
        "task": "$.task",
        "deps": "$._deps",
        "data_files": "$.data_files"
      }
    },
    {
      "id": "codegen",
      "type": "agent",
      "ref": "configs/arch_codegen.json",
      "depends_on": ["prepare"],
      "inputs": {
        "fn_id":              "prepare.fn_id",
        "description":        "prepare.description",
        "is_async":           "prepare.is_async",
        "is_init":            "prepare.is_init",
        "params_json":        "prepare.params_json",
        "returns_json":       "prepare.returns_json",
        "calls_context_json": "prepare.calls_context_json",
        "calls_bodies_json":  "prepare.calls_bodies_json",
        "class_context_json": "prepare.class_context_json",
        "file_fns_json":      "prepare.file_fns_json",
        "reference_code":     "prepare.reference_code",
        "init_body":          "prepare.init_body",
        "metric_name":        "$.metric_name",
        "data_files_json":    "prepare.data_files_json"
      }
    }
  ],
  "outputs": {
    "body":    "codegen.body",
    "imports": "codegen.imports"
  }
}

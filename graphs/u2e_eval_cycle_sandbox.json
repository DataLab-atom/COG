{
  "name": "u2e_eval_cycle_sandbox",
  "description": "U2E 沙盒评估子图（patch 模式）：将含 patches 的 individual 列表构建为沙盒任务 → 并发评估 → 聚合结果，替代 HTTP 评估的 u2e_eval_cycle.json",
  "long_running": true,
  "skills": ["skills/u2e_eval_cycle_sandbox.json"],
  "variables": ["population", "sandbox_in_ch", "function_evals"],
  "steps": [
    {
      "id": "build_eval_tasks",
      "type": "tool",
      "ref": "tools/u2e_build_sandbox_eval_tasks.json",
      "inputs": {
        "population":    "$.population",
        "sandbox_in_ch": "$.sandbox_in_ch"
      }
    },
    {
      "id": "eval",
      "type": "map",
      "depends_on": ["build_eval_tasks"],
      "over": "build_eval_tasks.tasks",
      "as": "task",
      "step": {
        "type": "input",
        "ref": "input/u2e_eval_via_mcts_sandbox.json",
        "long_running": true,
        "inputs": {
          "sandbox_in_ch":    "$.task.sandbox_in_ch",
          "ancestor_patches": [],
          "new_patches":      "$.task.patches"
        }
      }
    },
    {
      "id": "aggregate",
      "type": "tool",
      "ref": "tools/u2e_aggregate_sandbox_results.json",
      "depends_on": ["eval", "build_eval_tasks"],
      "inputs": {
        "eval_results":       "eval",
        "valid_population":   "build_eval_tasks.valid_population",
        "invalid_population": "build_eval_tasks.invalid_population",
        "function_evals":     "$.function_evals"
      }
    }
  ],
  "outputs": {
    "population":     "aggregate.population",
    "function_evals": "aggregate.function_evals"
  }
}

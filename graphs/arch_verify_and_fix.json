{
  "name": "arch_verify_and_fix",
  "description": "在沙盒中验证代码库是否能运行，失败时由 LLM 生成修复 patch 并写回磁盘，最多循环三次。位于 arch_to_project 的 syntax_check 与 enrich_tree 步骤之间",
  "long_running": true,
  "skills": ["skills/arch_verify_and_fix.json"],
  "variables": ["output_dir", "metric_name"],
  "steps": [
    {
      "id": "batch_fix_imports",
      "type": "tool",
      "ref": "arch_batch_fix_imports",
      "inputs": {
        "output_dir": "$.output_dir"
      }
    },
    {
      "id": "initial_run",
      "type": "input",
      "ref": "sandbox_run",
      "long_running": true,
      "depends_on": ["batch_fix_imports"],
      "inputs": {
        "project_root": "$.output_dir",
        "patches":      [],
        "timeout":      120
      }
    },
    {
      "id": "init_state",
      "type": "tool",
      "ref": "arch_init_fix_state",
      "depends_on": ["initial_run"],
      "inputs": {
        "run_ok": "initial_run.ok"
      }
    },
    {
      "id": "fix_loop",
      "type": "loop",
      "depends_on": ["init_state"],
      "max_iterations": 8,
      "while": "{{needs_fix}}",
      "state": {
        "needs_fix":   "init_state.needs_fix",
        "run_ok":      "init_state.run_ok",
        "stderr_log":  "initial_run.stderr_log",
        "error_msg":   "initial_run.error",
        "output_log":  "initial_run.output_log",
        "metric_name": "$.metric_name"
      },
      "body": [
        {
          "id": "collect_context",
          "type": "tool",
          "ref": "arch_collect_error_context",
          "inputs": {
            "stderr_log": "$.stderr_log",
            "error":      "$.error_msg",
            "output_log": "$.output_log",
            "output_dir": "$.output_dir"
          }
        },
        {
          "id": "fix_agent",
          "type": "agent",
          "ref": "configs/arch_runtime_fixer.json",
          "depends_on": ["collect_context"],
          "inputs": {
            "error_info":         "collect_context.error_info",
            "file_contents_json": "collect_context.file_contents_json",
            "metric_name":        "$.metric_name"
          }
        },
        {
          "id": "apply_fix",
          "type": "tool",
          "ref": "arch_write_patches",
          "depends_on": ["fix_agent"],
          "inputs": {
            "patches":    "fix_agent.patches",
            "output_dir": "$.output_dir"
          }
        },
        {
          "id": "post_fix_imports",
          "type": "tool",
          "ref": "arch_batch_fix_imports",
          "depends_on": ["apply_fix"],
          "inputs": {
            "output_dir": "$.output_dir"
          }
        },
        {
          "id": "rerun",
          "type": "input",
          "ref": "sandbox_run",
          "long_running": true,
          "depends_on": ["post_fix_imports"],
          "inputs": {
            "project_root": "$.output_dir",
            "patches":      [],
            "timeout":      120
          }
        },
        {
          "id": "check_state",
          "type": "tool",
          "ref": "arch_update_fix_state",
          "depends_on": ["rerun"],
          "inputs": {
            "run_ok": "rerun.ok"
          }
        }
      ],
      "state_update": {
        "needs_fix":  "check_state.needs_fix",
        "run_ok":     "check_state.run_ok",
        "stderr_log": "rerun.stderr_log",
        "error_msg":  "rerun.error",
        "output_log": "rerun.output_log"
      }
    }
  ],
  "outputs": {
    "ok":         "fix_loop.run_ok",
    "needs_fix":  "fix_loop.needs_fix"
  }
}

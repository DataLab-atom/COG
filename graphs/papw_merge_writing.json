{
  "name": "papw_merge_writing",
  "description": "论文合并写作子图：收集各章节 → 结论 → 摘要 → 标题 → 合并模板 → 改进循环 → 引用检查 → 提交检查 → 保存",
  "long_running": true,
  "skills": ["skills/papw_merge_writing.json"],
  "variables": [
    "papw_root",
    "method_tex_path",
    "related_work_tex_path",
    "experiment_tex_path",
    "introduction_tex_path",
    "related_work_bib_path",
    "introduction_bib_path",
    "tex_template_path",
    "write_model_name",
    "improve_round",
    "check_round"
  ],
  "steps": [
    {
      "id": "paths",
      "type": "tool",
      "ref": "tools/papw_merge_writing_paths.json",
      "inputs": {
        "papw_root": "$.papw_root"
      }
    },
    {
      "id": "collect",
      "type": "tool",
      "ref": "tools/papw_collect_chapters.json",
      "inputs": {
        "method_tex_path": "$.method_tex_path",
        "related_work_tex_path": "$.related_work_tex_path",
        "experiment_tex_path": "$.experiment_tex_path",
        "introduction_tex_path": "$.introduction_tex_path",
        "related_work_bib_path": "$.related_work_bib_path",
        "introduction_bib_path": "$.introduction_bib_path"
      }
    },
    {
      "id": "read_template",
      "type": "tool",
      "ref": "tools/papw_read_file.json",
      "inputs": {
        "file_path": "$.tex_template_path"
      }
    },
    {
      "id": "format_chapters",
      "type": "tool",
      "ref": "tools/papw_format_chapters.json",
      "depends_on": ["collect"],
      "inputs": {
        "introduction": "collect.introduction",
        "related_work": "collect.related_work",
        "methodology": "collect.methodology",
        "experiments": "collect.experiments"
      }
    },
    {
      "id": "conclusion",
      "type": "agent",
      "ref": "configs/papw_merge_conclusion.json",
      "depends_on": ["format_chapters"],
      "inputs": {
        "chapters_content": "format_chapters.chapters_text"
      }
    },
    {
      "id": "abstract",
      "type": "agent",
      "ref": "configs/papw_merge_abstract.json",
      "depends_on": ["conclusion", "format_chapters"],
      "inputs": {
        "chapters_and_conclusion": "format_chapters.chapters_text",
        "conclusion": "conclusion.conclusion"
      }
    },
    {
      "id": "title",
      "type": "agent",
      "ref": "configs/papw_merge_title.json",
      "depends_on": ["abstract"],
      "inputs": {
        "abstract_and_chapters": "abstract.abstract"
      }
    },
    {
      "id": "build_texts",
      "type": "tool",
      "ref": "tools/papw_build_merge_texts.json",
      "depends_on": ["title", "read_template"],
      "inputs": {
        "introduction": "collect.introduction",
        "related_work": "collect.related_work",
        "methodology": "collect.methodology",
        "experiments": "collect.experiments",
        "bibliography": "collect.bibliography",
        "conclusion": "conclusion.conclusion",
        "abstract": "abstract.abstract",
        "title": "title.recommended",
        "tex_template": "read_template.content"
      }
    },
    {
      "id": "merge",
      "type": "agent",
      "ref": "configs/papw_merge_merge.json",
      "depends_on": ["build_texts"],
      "inputs": {
        "merge_content": "build_texts.merge_content"
      }
    },
    {
      "id": "improve_loop",
      "type": "loop",
      "depends_on": ["merge"],
      "max_iterations": 5,
      "while": "{{should_continue}}",
      "state": {
        "content": "merge.merged_tex",
        "should_continue": true
      },
      "body": [
        {
          "id": "improve",
          "type": "agent",
          "ref": "configs/papw_merge_improve.json",
          "inputs": {
            "content": "$.content"
          }
        },
        {
          "id": "check",
          "type": "tool",
          "ref": "tools/papw_merge_check_improve.json",
          "depends_on": ["improve"],
          "inputs": {
            "improve_result": "improve.improved_tex",
            "previous_content": "$.content"
          }
        }
      ],
      "state_update": {
        "content": "check.content",
        "should_continue": "check.should_continue"
      }
    },
    {
      "id": "check_cite_loop",
      "type": "loop",
      "depends_on": ["improve_loop"],
      "max_iterations": 3,
      "while": "{{should_continue}}",
      "state": {
        "content": "improve_loop.content",
        "bib": "collect.bibliography",
        "should_continue": true
      },
      "body": [
        {
          "id": "check_cite",
          "type": "agent",
          "ref": "configs/papw_merge_check_cite.json",
          "inputs": {
            "tex_and_bib": "$.content"
          }
        },
        {
          "id": "check_done",
          "type": "tool",
          "ref": "tools/papw_merge_check_cite_done.json",
          "depends_on": ["check_cite"],
          "inputs": {
            "verified": "check_cite.verified",
            "corrected_tex": "check_cite.corrected_tex",
            "previous_content": "$.content"
          }
        }
      ],
      "state_update": {
        "content": "check_done.content",
        "should_continue": "check_done.should_continue"
      }
    },
    {
      "id": "check_submit",
      "type": "agent",
      "ref": "configs/papw_merge_check_submit.json",
      "depends_on": ["check_cite_loop"],
      "inputs": {
        "content": "check_cite_loop.content"
      }
    },
    {
      "id": "save_result",
      "type": "tool",
      "ref": "tools/papw_save_file.json",
      "depends_on": ["check_submit"],
      "inputs": {
        "file_path": "paths.result_write_path",
        "content": "check_submit.corrected_tex"
      }
    }
  ],
  "outputs": {
    "paper_tex_path": "save_result.file_path",
    "paper_tex": "check_submit.corrected_tex"
  }
}

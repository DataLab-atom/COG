{
  "name": "arch_internal_define",
  "description": "内部定义阶段：两阶段全量并发定义有依赖的 type/fn，解析 needs，回填，验证调用 DAG，静态检查",
  "long_running": false,
  "skills": ["skills/arch_internal_define.json"],
  "variables": ["files", "requirement", "global_ids", "modules"],
  "steps": [
    {
      "id": "internal_fanout",
      "type": "input",
      "ref": "arch_internal_fanout",
      "inputs": {
        "files":       "$.files",
        "requirement": "$.requirement",
        "global_ids":  "$.global_ids",
        "modules":     "$.modules"
      }
    },
    {
      "id": "resolve_needs",
      "type": "tool",
      "ref": "arch_resolve_needs",
      "depends_on": ["internal_fanout"],
      "inputs": {
        "tree": "internal_fanout.tree"
      }
    },
    {
      "id": "backfill",
      "type": "tool",
      "ref": "arch_backfill",
      "depends_on": ["resolve_needs"],
      "inputs": {
        "tree": "resolve_needs.tree"
      }
    },
    {
      "id": "validate_calls_dag",
      "type": "tool",
      "ref": "arch_validate_dag",
      "depends_on": ["resolve_needs"],
      "inputs": {
        "tree":          "resolve_needs.tree",
        "check_targets": ["fn_calls"]
      }
    },
    {
      "id": "static_check",
      "type": "tool",
      "ref": "arch_static_check",
      "depends_on": ["backfill", "validate_calls_dag"],
      "inputs": {
        "tree": "backfill.tree"
      }
    }
  ],
  "outputs": {
    "ok":       "static_check.ok",
    "errors":   "static_check.errors",
    "warnings": "static_check.warnings",
    "tree":     "backfill.tree"
  }
}

{
  "name": "arch_then_mcts_then_u2e",
  "description": "端到端科学代码生成与双阶段优化：需求描述 → 架构生成（或从现有项目解析）→ 人工审核与重构 → 代码生成 → MCTS Beam Search 优化（一阶段）→ U2E 进化优化（二阶段，patch 模式）→ 写回最优结果。支持两种启动方式：①提供 requirement 由 LLM 生成架构；②提供 existing_project_root 从现有代码库解析架构。两种方式均通过顶层 arch_gate 接收人类反馈：有反馈则自动选择 patch_chain 或 full_rebuild 整体重构，无反馈则直接进入代码生成",
  "long_running": true,
  "skills": [
    "skills/arch_then_mcts_then_u2e.json"
  ],
  "variables": [
    "requirement",
    "output_dir",
    "arch_gate_channel_id",
    "mcts_gate_channel_id",
    "sandbox_timeout",
    "beam_width",
    "consecutive_bad_limit",
    "max_generations",
    "pop_size",
    "mutation_rate",
    "max_fe",
    "user_generator_prompt",
    "external_knowledge",
    "existing_project_root",
    "existing_direction"
  ],
  "steps": [
    {
      "id": "arch_step",
      "type": "cond",
      "condition": "{{existing_project_root}}",
      "if_true": {
        "type": "graph",
        "ref": "graphs/arch_from_existing_design.json",
        "inputs": {
          "project_root": "$.existing_project_root",
          "direction":    "$.existing_direction",
          "requirement":  "$.requirement"
        }
      },
      "if_false": {
        "type": "graph",
        "ref": "graphs/arch_build.json",
        "inputs": {
          "requirement": "$.requirement"
        }
      }
    },
    {
      "id": "arch_gate",
      "type": "input",
      "ref": "read_channel",
      "long_running": true,
      "depends_on": ["arch_step"],
      "inputs": {
        "channel_id": "$.arch_gate_channel_id"
      }
    },
    {
      "id": "arch_refine",
      "type": "cond",
      "depends_on": ["arch_gate"],
      "condition": "{{arch_gate.data.feedback}}",
      "if_true": {
        "type": "graph",
        "ref": "graphs/arch_refine_with_feedback.json",
        "inputs": {
          "tree":        "arch_step.tree",
          "requirement": "$.requirement",
          "metric_name": "arch_step.metric_name",
          "direction":   "arch_step.direction",
          "feedback":    "arch_gate.data.feedback"
        }
      },
      "if_false": {
        "type": "tool",
        "ref": "arch_pick_tree",
        "inputs": {
          "original_tree": "arch_step.tree"
        }
      }
    },
    {
      "id": "final_arch_tree",
      "type": "tool",
      "ref": "arch_pick_tree",
      "depends_on": ["arch_refine"],
      "inputs": {
        "original_tree": "arch_step.tree",
        "rebuilt_tree":  "arch_refine.tree",
        "feedback":      "arch_gate.data.feedback"
      }
    },
    {
      "id": "arch_to_project",
      "type": "graph",
      "ref": "graphs/arch_to_project.json",
      "depends_on": ["final_arch_tree"],
      "inputs": {
        "tree":        "final_arch_tree.tree",
        "output_dir":  "$.output_dir",
        "metric_name": "arch_step.metric_name",
        "data_files":  "arch_step.data_files"
      }
    },
    {
      "id": "gen_requirements",
      "type": "tool",
      "ref": "arch_gen_requirements",
      "depends_on": ["arch_to_project"],
      "inputs": {
        "written":    "arch_to_project.written",
        "output_dir": "$.output_dir"
      }
    },
    {
      "id": "start_mcts_sandbox",
      "type": "input",
      "ref": "start_sandbox_session",
      "depends_on": ["gen_requirements"],
      "inputs": {
        "project_root": "$.output_dir",
        "tree":         "arch_to_project.tree",
        "max_workers":  "$.beam_width",
        "timeout":      "$.sandbox_timeout"
      }
    },
    {
      "id": "baseline",
      "type": "input",
      "ref": "mcts_sandbox_via_session",
      "long_running": true,
      "depends_on": ["start_mcts_sandbox"],
      "inputs": {
        "sandbox_in_ch":    "start_mcts_sandbox.sandbox_in_ch",
        "ancestor_patches": [],
        "new_patches":      []
      }
    },
    {
      "id": "mcts_optimize",
      "type": "cond",
      "depends_on": ["baseline"],
      "condition": "{{baseline.ok}}",
      "if_true": {
        "type": "graph",
        "ref": "graphs/mcts_run.json",
        "inputs": {
          "project_root":          "$.output_dir",
          "demand":                "$.requirement",
          "sandbox_timeout":       "$.sandbox_timeout",
          "gate_channel_id":       "$.mcts_gate_channel_id",
          "beam_width":            "$.beam_width",
          "consecutive_bad_limit": "$.consecutive_bad_limit",
          "max_generations":       "$.max_generations",
          "tree":                  "arch_to_project.tree",
          "sandbox_in_ch":         "start_mcts_sandbox.sandbox_in_ch",
          "baseline_score":        "baseline.score",
          "baseline_log":          "baseline.output_log"
        }
      },
      "if_false": {
        "type": "tool",
        "ref": "echo",
        "inputs": {
          "text": "baseline failed, skipping MCTS and U2E optimization"
        }
      }
    },
    {
      "id": "close_mcts_sandbox",
      "type": "tool",
      "ref": "close_sandbox_session",
      "depends_on": ["mcts_optimize"],
      "inputs": {
        "sandbox_in_ch": "start_mcts_sandbox.sandbox_in_ch"
      }
    },
    {
      "id": "u2e_block",
      "type": "cond",
      "depends_on": ["close_mcts_sandbox"],
      "condition": "{{baseline.ok}}",
      "if_true": {
        "type": "graph",
        "ref": "graphs/u2e_optimize_block.json",
        "inputs": {
          "tree":                  "arch_to_project.tree",
          "requirement":           "$.requirement",
          "mcts_best_patches":     "mcts_optimize.best_node.patches",
          "output_dir":            "$.output_dir",
          "beam_width":            "$.beam_width",
          "sandbox_timeout":       "$.sandbox_timeout",
          "pop_size":              "$.pop_size",
          "mutation_rate":         "$.mutation_rate",
          "max_fe":                "$.max_fe",
          "user_generator_prompt": "$.user_generator_prompt",
          "external_knowledge":    "$.external_knowledge"
        }
      },
      "if_false": {
        "type": "tool",
        "ref": "echo",
        "inputs": {
          "text": "baseline failed, skipping U2E optimization"
        }
      }
    }
  ],
  "outputs": {
    "arch_ok":          "arch_step.ok",
    "arch_errors":      "arch_step.errors",
    "metric_name":      "arch_step.metric_name",
    "direction":        "arch_step.direction",
    "written_files":    "arch_to_project.written",
    "baseline_ok":      "baseline.ok",
    "baseline_score":   "baseline.score",
    "mcts_best_node":   "mcts_optimize.best_node",
    "u2e_elitist":      "u2e_block.elitist",
    "u2e_best_obj":     "u2e_block.best_obj_overall",
    "function_evals":   "u2e_block.function_evals",
    "apply_u2e_result": "u2e_block.apply_result",
    "project_tree":     "arch_to_project.tree"
  }
}

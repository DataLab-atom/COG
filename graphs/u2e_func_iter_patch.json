{
  "name": "u2e_func_iter_patch",
  "description": "U2E 单函数单代进化子图（patch 模式）：多样性感知选择 → 短期反思 → 交叉生成 → 沙盒评估 → 结构化长期反思 → 变异生成 → 沙盒评估，返回本代所有已评估 individual（含 patches 字段）与更新后的结构化记忆",
  "long_running": true,
  "skills": ["skills/u2e_func_iter_patch.json"],
  "variables": [
    "func_index",
    "func_name",
    "func_desc",
    "func_signature",
    "target_file",
    "target_type",
    "initial_funcs",
    "user_generator_prompt",
    "external_knowledge",
    "func_population",
    "problem_desc",
    "structured_memory",
    "func_elitist_for_func",
    "elitist",
    "elite_archive",
    "pop_size",
    "mutation_rate",
    "sandbox_in_ch",
    "iteration",
    "function_evals"
  ],
  "steps": [
    {
      "id": "select",
      "type": "tool",
      "ref": "tools/u2e_diversity_select.json",
      "inputs": {
        "population":    "$.func_population",
        "elite_archive": "$.elite_archive",
        "pop_size":      "$.pop_size"
      }
    },
    {
      "id": "build_reflect_tasks",
      "type": "tool",
      "ref": "tools/u2e_build_reflect_tasks.json",
      "depends_on": ["select"],
      "inputs": {
        "selected_population": "select.selected",
        "func_name":           "$.func_name",
        "func_desc":           "$.func_desc",
        "problem_desc":        "$.problem_desc"
      }
    },
    {
      "id": "reflect",
      "type": "map",
      "depends_on": ["build_reflect_tasks"],
      "over": "build_reflect_tasks.tasks",
      "as": "task",
      "step": {
        "type": "agent",
        "ref": "configs/u2e_short_term_reflector.json",
        "inputs": {
          "func_name":    "$.task.func_name",
          "problem_desc": "$.task.problem_desc",
          "func_desc":    "$.task.func_desc",
          "worse_code":   "$.task.worse_code",
          "better_code":  "$.task.better_code"
        }
      }
    },
    {
      "id": "retrieve_memory_for_crossover",
      "type": "tool",
      "ref": "tools/u2e_retrieve_relevant_memory.json",
      "inputs": {
        "structured_memory": "$.structured_memory",
        "func_name":         "$.func_name",
        "context":           "crossover"
      }
    },
    {
      "id": "build_crossover_tasks",
      "type": "tool",
      "ref": "tools/u2e_build_crossover_tasks.json",
      "depends_on": ["reflect", "build_reflect_tasks", "retrieve_memory_for_crossover"],
      "inputs": {
        "reflections":           "reflect",
        "reflect_tasks":         "build_reflect_tasks.tasks",
        "user_generator_prompt": "$.user_generator_prompt",
        "func_signature":        "$.func_signature",
        "long_term_reflection":  "retrieve_memory_for_crossover.text",
        "func_name":             "$.func_name"
      }
    },
    {
      "id": "crossover_gen",
      "type": "map",
      "depends_on": ["build_crossover_tasks"],
      "over": "build_crossover_tasks.tasks",
      "as": "task",
      "step": {
        "type": "agent",
        "ref": "configs/u2e_crossover_generator.json",
        "inputs": {
          "user_generator":  "$.task.user_generator",
          "func_signature":  "$.task.func_signature",
          "worse_code":      "$.task.worse_code",
          "better_code":     "$.task.better_code",
          "reflection":      "$.task.reflection",
          "func_name":       "$.task.func_name"
        }
      }
    },
    {
      "id": "parse_crossed",
      "type": "tool",
      "ref": "tools/u2e_parse_responses_patch.json",
      "depends_on": ["crossover_gen", "select"],
      "inputs": {
        "responses":       "crossover_gen",
        "parent_funcs":    "select.parent_funcs",
        "parent_patches":  "select.parent_patches",
        "func_index":      "$.func_index",
        "iteration":       "$.iteration",
        "target_file":     "$.target_file",
        "func_name":       "$.func_name",
        "target_type":     "$.target_type",
        "id_offset":       0
      }
    },
    {
      "id": "aggregate_crossed",
      "type": "graph",
      "ref": "graphs/u2e_eval_cycle_sandbox.json",
      "depends_on": ["parse_crossed"],
      "inputs": {
        "population":     "parse_crossed.population",
        "sandbox_in_ch":  "$.sandbox_in_ch",
        "function_evals": "$.function_evals"
      }
    },
    {
      "id": "join_reflections",
      "type": "tool",
      "ref": "tools/u2e_join_texts.json",
      "depends_on": ["reflect"],
      "inputs": {
        "texts": "reflect"
      }
    },
    {
      "id": "long_term_reflect",
      "type": "agent",
      "ref": "configs/u2e_structured_reflector.json",
      "depends_on": ["join_reflections"],
      "inputs": {
        "problem_desc":    "$.problem_desc",
        "prior_memory":    "$.structured_memory",
        "new_reflections": "join_reflections.text"
      }
    },
    {
      "id": "retrieve_memory_for_mutate",
      "type": "tool",
      "ref": "tools/u2e_retrieve_relevant_memory.json",
      "depends_on": ["long_term_reflect"],
      "inputs": {
        "structured_memory": "long_term_reflect",
        "func_name":         "$.func_name",
        "context":           "mutate"
      }
    },
    {
      "id": "build_mutate_tasks",
      "type": "tool",
      "ref": "tools/u2e_build_mutate_tasks.json",
      "depends_on": ["retrieve_memory_for_mutate", "select"],
      "inputs": {
        "elitist":               "$.elitist",
        "user_generator_prompt": "$.user_generator_prompt",
        "func_signature":        "$.func_signature",
        "long_term_reflection":  "retrieve_memory_for_mutate.text",
        "external_knowledge":    "$.external_knowledge",
        "func_name":             "$.func_name",
        "pop_size":              "$.pop_size",
        "mutation_rate":         "$.mutation_rate"
      }
    },
    {
      "id": "mutate_gen",
      "type": "map",
      "depends_on": ["build_mutate_tasks"],
      "over": "build_mutate_tasks.tasks",
      "as": "task",
      "step": {
        "type": "agent",
        "ref": "configs/u2e_mutator.json",
        "inputs": {
          "user_generator":  "$.task.user_generator",
          "reflection":      "$.task.reflection",
          "func_signature":  "$.task.func_signature",
          "elitist_code":    "$.task.elitist_code",
          "func_name":       "$.task.func_name"
        }
      }
    },
    {
      "id": "parse_mutated",
      "type": "tool",
      "ref": "tools/u2e_parse_responses_patch.json",
      "depends_on": ["mutate_gen", "select"],
      "inputs": {
        "responses":       "mutate_gen",
        "parent_funcs":    "select.parent_funcs",
        "parent_patches":  "select.parent_patches",
        "func_index":      "$.func_index",
        "iteration":       "$.iteration",
        "target_file":     "$.target_file",
        "func_name":       "$.func_name",
        "target_type":     "$.target_type",
        "id_offset":       500
      }
    },
    {
      "id": "aggregate_mutated",
      "type": "graph",
      "ref": "graphs/u2e_eval_cycle_sandbox.json",
      "depends_on": ["parse_mutated", "aggregate_crossed"],
      "inputs": {
        "population":     "parse_mutated.population",
        "sandbox_in_ch":  "$.sandbox_in_ch",
        "function_evals": "aggregate_crossed.function_evals"
      }
    }
  ],
  "outputs": {
    "population":            "aggregate_mutated.population",
    "crossed_population":    "aggregate_crossed.population",
    "new_structured_memory": "long_term_reflect",
    "function_evals":        "aggregate_mutated.function_evals"
  }
}

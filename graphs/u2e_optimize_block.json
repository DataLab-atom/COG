{
  "name": "u2e_optimize_block",
  "description": "U2E 进化优化子图：func_tasks 构建 → sandbox 会话 → 迭代进化循环 → 应用最优结果 → 关闭 sandbox。从主图中抽出，供 baseline.ok 条件分支调用",
  "long_running": true,
  "skills": ["skills/u2e_optimize_block.json"],
  "variables": [
    "tree",
    "requirement",
    "mcts_best_patches",
    "output_dir",
    "beam_width",
    "sandbox_timeout",
    "pop_size",
    "mutation_rate",
    "max_fe",
    "user_generator_prompt",
    "external_knowledge"
  ],
  "steps": [
    {
      "id": "tree_to_func_tasks",
      "type": "tool",
      "ref": "tools/u2e_tree_to_func_tasks.json",
      "inputs": {
        "tree":         "$.tree",
        "problem_desc": "$.requirement",
        "base_patches": "$.mcts_best_patches"
      }
    },
    {
      "id": "start_u2e_sandbox",
      "type": "input",
      "ref": "start_sandbox_session",
      "depends_on": ["tree_to_func_tasks"],
      "inputs": {
        "project_root": "$.output_dir",
        "tree":         "$.tree",
        "max_workers":  "$.beam_width",
        "timeout":      "$.sandbox_timeout",
        "base_patches": "$.mcts_best_patches"
      }
    },
    {
      "id": "u2e_optimize",
      "type": "loop",
      "depends_on": ["tree_to_func_tasks", "start_u2e_sandbox"],
      "max_iterations": 200,
      "while": "{{should_continue}}",
      "state": {
        "func_tasks":                   "tree_to_func_tasks.func_tasks",
        "func_names":                   "tree_to_func_tasks.func_names",
        "sandbox_in_ch":                "start_u2e_sandbox.sandbox_in_ch",
        "func_individual":              "tree_to_func_tasks.initial_func_individual",
        "func_elitist":                 {},
        "func_structured_memory":       {},
        "elitist":                      null,
        "elite_archive":                [],
        "function_evals":               0,
        "func_best_obj_overall":        {},
        "best_obj_overall":             null,
        "best_code_overall":            null,
        "best_code_func_index_overall": null,
        "iteration":                    0,
        "should_continue":              true
      },
      "body": [
        {
          "id": "build_func_iter_tasks",
          "type": "tool",
          "ref": "tools/u2e_build_func_iter_tasks.json",
          "inputs": {
            "func_tasks":             "$.func_tasks",
            "func_individual":        "$.func_individual",
            "func_elitist":           "$.func_elitist",
            "func_structured_memory": "$.func_structured_memory",
            "elitist":                "$.elitist",
            "elite_archive":          "$.elite_archive",
            "iteration":              "$.iteration",
            "function_evals":         "$.function_evals",
            "sandbox_in_ch":          "$.sandbox_in_ch",
            "pop_size":               "$.pop_size",
            "mutation_rate":          "$.mutation_rate",
            "user_generator_prompt":  "$.user_generator_prompt",
            "external_knowledge":     "$.external_knowledge",
            "problem_desc":           "$.requirement"
          }
        },
        {
          "id": "func_evolve",
          "type": "map",
          "depends_on": ["build_func_iter_tasks"],
          "over": "build_func_iter_tasks.func_iter_tasks",
          "as": "task",
          "item_key": "task.func_name",
          "step": {
            "type": "graph",
            "ref": "graphs/u2e_func_iter_patch.json",
            "inputs": {
              "func_index":            "$.task.func_index",
              "func_name":             "$.task.func_name",
              "func_desc":             "$.task.func_desc",
              "func_signature":        "$.task.func_signature",
              "target_file":           "$.task.target_file",
              "target_type":           "$.task.target_type",
              "initial_funcs":         "$.task.initial_funcs",
              "func_population":       "$.task.func_population",
              "func_elitist_for_func": "$.task.func_elitist_for_func",
              "structured_memory":     "$.task.structured_memory",
              "elitist":               "$.task.elitist",
              "elite_archive":         "$.task.elite_archive",
              "iteration":             "$.task.iteration",
              "function_evals":        "$.task.function_evals",
              "sandbox_in_ch":         "$.task.sandbox_in_ch",
              "pop_size":              "$.task.pop_size",
              "mutation_rate":         "$.task.mutation_rate",
              "user_generator_prompt": "$.task.user_generator_prompt",
              "external_knowledge":    "$.task.external_knowledge",
              "problem_desc":          "$.task.problem_desc"
            }
          },
          "collect": "keyed"
        },
        {
          "id": "collect_results",
          "type": "tool",
          "ref": "tools/u2e_collect_func_results.json",
          "depends_on": ["func_evolve"],
          "inputs": {
            "keyed_results":  "func_evolve",
            "func_tasks":     "$.func_tasks",
            "function_evals": "$.function_evals"
          }
        },
        {
          "id": "update_state",
          "type": "tool",
          "ref": "tools/u2e_update_iter.json",
          "depends_on": ["collect_results"],
          "inputs": {
            "population":                   "collect_results.population",
            "func_names":                   "$.func_names",
            "func_individual":              "$.func_individual",
            "func_best_obj_overall":        "$.func_best_obj_overall",
            "func_elitist":                 "$.func_elitist",
            "elitist":                      "$.elitist",
            "best_obj_overall":             "$.best_obj_overall",
            "best_code_overall":            "$.best_code_overall",
            "best_code_func_index_overall": "$.best_code_func_index_overall",
            "iteration":                    "$.iteration",
            "function_evals":               "collect_results.function_evals",
            "max_fe":                       "$.max_fe",
            "elite_archive":                "$.elite_archive"
          }
        }
      ],
      "state_update": {
        "func_tasks":                   "$.func_tasks",
        "func_names":                   "$.func_names",
        "sandbox_in_ch":                "$.sandbox_in_ch",
        "func_individual":              "update_state.func_individual",
        "func_elitist":                 "update_state.func_elitist",
        "func_structured_memory":       "collect_results.func_structured_memory",
        "elitist":                      "update_state.elitist",
        "elite_archive":                "update_state.elite_archive",
        "function_evals":               "collect_results.function_evals",
        "func_best_obj_overall":        "update_state.func_best_obj_overall",
        "best_obj_overall":             "update_state.best_obj_overall",
        "best_code_overall":            "update_state.best_code_overall",
        "best_code_func_index_overall": "update_state.best_code_func_index_overall",
        "iteration":                    "update_state.iteration",
        "should_continue":              "update_state.should_continue"
      }
    },
    {
      "id": "apply_u2e_best",
      "type": "tool",
      "ref": "mcts_apply_best",
      "depends_on": ["u2e_optimize"],
      "inputs": {
        "best_node":    "u2e_optimize.elitist",
        "project_root": "$.output_dir"
      }
    },
    {
      "id": "close_u2e_sandbox",
      "type": "tool",
      "ref": "close_sandbox_session",
      "depends_on": ["u2e_optimize"],
      "inputs": {
        "sandbox_in_ch": "start_u2e_sandbox.sandbox_in_ch"
      }
    }
  ],
  "outputs": {
    "elitist":        "u2e_optimize.elitist",
    "best_obj_overall": "u2e_optimize.best_obj_overall",
    "function_evals": "u2e_optimize.function_evals",
    "apply_result":   "apply_u2e_best"
  }
}

{
  "name": "channel_echo",
  "long_running": true,
  "variables": ["channel_id"],
  "steps": [
    {
      "id": "recv",
      "type": "input",
      "ref": "read_channel",
      "inputs": {"channel_id": "$.channel_id"}
    },
    {
      "id": "echo_out",
      "type": "tool",
      "ref": "echo",
      "depends_on": ["recv"],
      "inputs": {"text": "recv.data"}
    }
  ]
}

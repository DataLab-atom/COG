{
  "name": "papw_introduction_writing",
  "description": "引言章节写作子图：规划大纲 → 递归执行子任务（含/不含引用检索）→ 整合 → 清理 bib → 保存",
  "long_running": true,
  "skills": ["skills/papw_introduction_writing.json"],
  "variables": [
    "papw_root",
    "arch_tree",
    "best_patches",
    "full_text_vb_path",
    "related_work_bib_list_path",
    "tex_template_path",
    "text_model_name",
    "integration_model_name",
    "embedding_model",
    "embedding_model_source",
    "reranker_path",
    "reranker_model_source",
    "database_device"
  ],
  "steps": [
    {
      "id": "paths",
      "type": "tool",
      "ref": "tools/papw_intro_writing_paths.json",
      "inputs": {
        "papw_root": "$.papw_root"
      }
    },
    {
      "id": "build_req",
      "type": "tool",
      "ref": "tools/papw_intro_build_req.json",
      "depends_on": ["paths"],
      "inputs": {
        "arch_tree": "$.arch_tree",
        "best_patches": "$.best_patches",
        "research_information_path": "paths.research_information_path",
        "papw_root": "$.papw_root"
      }
    },
    {
      "id": "read_template",
      "type": "tool",
      "ref": "tools/papw_read_file.json",
      "inputs": {
        "file_path": "$.tex_template_path"
      }
    },
    {
      "id": "outline",
      "type": "agent",
      "ref": "configs/papw_intro_outline.json",
      "depends_on": ["build_req"],
      "inputs": {
        "writing_requirement": "build_req.writing_requirement"
      }
    },
    {
      "id": "normalize",
      "type": "tool",
      "ref": "tools/papw_intro_normalize_outline.json",
      "depends_on": ["outline"],
      "inputs": {
        "outline": "outline.outline"
      }
    },
    {
      "id": "execute_tasks",
      "type": "loop",
      "depends_on": ["normalize", "read_template"],
      "max_iterations": 50,
      "while": "{{has_more_tasks}}",
      "state": {
        "tasks": "normalize.leaf_tasks",
        "task_index": 0,
        "done_write": "",
        "all_bib_content": "",
        "used_bib_set": [],
        "has_more_tasks": true,
        "all_write_task": "build_req.writing_requirement",
        "all_write_task_plan": "normalize.task_plan_text",
        "tex_template": "read_template.content",
        "full_text_vb_path": "$.full_text_vb_path",
        "embedding_model": "$.embedding_model",
        "embedding_model_source": "$.embedding_model_source",
        "reranker_path": "$.reranker_path",
        "reranker_model_source": "$.reranker_model_source",
        "database_device": "$.database_device"
      },
      "body": [
        {
          "id": "current",
          "type": "tool",
          "ref": "tools/papw_get_loop_task.json",
          "inputs": {
            "tasks": "$.tasks",
            "index": "$.task_index"
          }
        },
        {
          "id": "think",
          "type": "agent",
          "ref": "configs/papw_intro_think.json",
          "depends_on": ["current"],
          "inputs": {
            "all_write_task_plan": "$.all_write_task_plan",
            "all_write_task": "$.all_write_task",
            "task_goal": "current.task_goal"
          }
        },
        {
          "id": "dispatch",
          "type": "cond",
          "depends_on": ["think"],
          "condition": "{{current.need_cite}}",
          "if_true": {
            "type": "graph",
            "ref": "graphs/papw_intro_cite_branch.json",
            "inputs": {
              "full_text_vb_path": "$.full_text_vb_path",
              "embedding_model": "$.embedding_model",
              "embedding_model_source": "$.embedding_model_source",
              "reranker_path": "$.reranker_path",
              "reranker_model_source": "$.reranker_model_source",
              "database_device": "$.database_device",
              "used_bib_set": "$.used_bib_set",
              "all_write_task_plan": "$.all_write_task_plan",
              "done_write": "$.done_write",
              "all_write_task": "$.all_write_task",
              "tex_template": "$.tex_template",
              "task_goal": "current.task_goal",
              "think_content": "think.think"
            }
          },
          "if_false": {
            "type": "agent",
            "ref": "configs/papw_intro_write_nocite.json",
            "inputs": {
              "all_write_task_plan": "$.all_write_task_plan",
              "done_write": "$.done_write",
              "all_write_task": "$.all_write_task",
              "task_goal": "current.task_goal"
            }
          }
        },
        {
          "id": "update_state",
          "type": "tool",
          "ref": "tools/papw_intro_update_state.json",
          "depends_on": ["dispatch"],
          "inputs": {
            "dispatch_result": "dispatch",
            "current_done_write": "$.done_write",
            "current_all_bib": "$.all_bib_content",
            "current_used_bib_set": "$.used_bib_set",
            "task_index": "$.task_index",
            "total_tasks": "current.total_tasks"
          }
        }
      ],
      "state_update": {
        "done_write": "update_state.done_write",
        "all_bib_content": "update_state.all_bib_content",
        "used_bib_set": "update_state.used_bib_set",
        "task_index": "update_state.next_index",
        "has_more_tasks": "update_state.has_more_tasks"
      }
    },
    {
      "id": "integrate",
      "type": "agent",
      "ref": "configs/papw_intro_integrate.json",
      "depends_on": ["execute_tasks"],
      "inputs": {
        "tex_template": "read_template.content",
        "all_write_task": "build_req.writing_requirement",
        "bib_content": "execute_tasks.all_bib_content",
        "done_write": "execute_tasks.done_write"
      }
    },
    {
      "id": "clean_bib",
      "type": "tool",
      "ref": "tools/papw_rw_clean_bib_by_content.json",
      "depends_on": ["integrate"],
      "inputs": {
        "all_bib_content": "execute_tasks.all_bib_content",
        "tex_content": "integrate.tex_code"
      }
    },
    {
      "id": "save_tex",
      "type": "tool",
      "ref": "tools/papw_save_file.json",
      "depends_on": ["integrate"],
      "inputs": {
        "file_path": "paths.result_write_path",
        "content": "integrate.tex_code"
      }
    },
    {
      "id": "save_bib",
      "type": "tool",
      "ref": "tools/papw_save_file.json",
      "depends_on": ["clean_bib"],
      "inputs": {
        "file_path": "paths.bib_result_path",
        "content": "clean_bib.cleaned_bib"
      }
    }
  ],
  "outputs": {
    "tex_path": "save_tex.file_path",
    "tex_code": "integrate.tex_code",
    "bib_result_path": "save_bib.file_path",
    "bib_result_list_path": "paths.bib_result_list_path"
  }
}

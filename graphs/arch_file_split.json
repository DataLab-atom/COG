{
  "name": "arch_file_split",
  "description": "文件划分阶段：并发将每个模块拆为文件列表，回填，并验证文件间无循环依赖",
  "long_running": false,
  "skills": ["skills/arch_file_split.json"],
  "variables": ["modules", "requirement"],
  "steps": [
    {
      "id": "file_fanout_raw",
      "type": "map",
      "over": "$.modules",
      "as": "module",
      "step": {
        "type": "agent",
        "ref": "configs/arch_file_splitter.json",
        "inputs": {
          "module_json":      "$.module",
          "all_modules_json": "$.modules",
          "requirement":      "$.requirement"
        }
      }
    },
    {
      "id": "file_fanout",
      "type": "tool",
      "ref": "arch_backfill_files",
      "depends_on": ["file_fanout_raw"],
      "inputs": {
        "modules":    "$.modules",
        "file_lists": "file_fanout_raw"
      }
    },
    {
      "id": "validate_file_dag",
      "type": "tool",
      "ref": "arch_validate_dag",
      "depends_on": ["file_fanout"],
      "inputs": {
        "tree":          "file_fanout.files",
        "check_targets": ["file_imports"]
      }
    }
  ],
  "outputs": {
    "files": "file_fanout.files"
  }
}

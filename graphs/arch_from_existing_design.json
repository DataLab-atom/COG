{
  "name": "arch_from_existing_design",
  "description": "从现有 Python 项目目录 AST 解析生成含代码体的架构树，补全缺失描述，并检查是否具备目标指标的计算能力——缺失时通过 plan→loop 逐个生成 patch 补全所需架构节点。仅输出设计树，不生成 requirements.txt，供 arch_then_mcts_then_u2e 的顶层 gate 流程使用",
  "long_running": false,
  "skills": ["skills/arch_from_existing_design.json"],
  "variables": ["project_root", "direction", "requirement"],
  "steps": [
    {
      "id": "parse_tree",
      "type": "tool",
      "ref": "tools/arch_parse_project.json",
      "inputs": {
        "project_root": "$.project_root",
        "metric_name":  "",
        "direction":    "$.direction"
      }
    },
    {
      "id": "extract_metric",
      "type": "agent",
      "ref": "configs/arch_extract_metric.json",
      "depends_on": ["parse_tree"],
      "inputs": {
        "requirement": "$.requirement",
        "tree_json":   "parse_tree.tree"
      }
    },
    {
      "id": "extract_undescribed",
      "type": "tool",
      "ref": "tools/arch_extract_undescribed.json",
      "depends_on": ["parse_tree"],
      "inputs": {
        "tree": "parse_tree.tree"
      }
    },
    {
      "id": "enrich_descriptions",
      "type": "agent",
      "ref": "configs/arch_enrich_descriptions.json",
      "depends_on": ["extract_undescribed"],
      "inputs": {
        "undescribed_json": "extract_undescribed.undescribed"
      }
    },
    {
      "id": "apply_descriptions",
      "type": "tool",
      "ref": "tools/arch_apply_descriptions.json",
      "depends_on": ["parse_tree", "enrich_descriptions"],
      "inputs": {
        "tree":         "parse_tree.tree",
        "descriptions": "enrich_descriptions.descriptions"
      }
    },
    {
      "id": "augment_plan",
      "type": "agent",
      "ref": "configs/arch_augment_plan.json",
      "depends_on": ["apply_descriptions", "extract_metric"],
      "inputs": {
        "metric_name": "extract_metric.metric_name",
        "requirement": "$.requirement",
        "tree_json":   "apply_descriptions.tree"
      }
    },
    {
      "id": "gen_patches",
      "type": "loop",
      "depends_on": ["augment_plan"],
      "max_iterations": 20,
      "while": "{{has_remaining}}",
      "state": {
        "remaining_items": "augment_plan.plan_items",
        "patches_so_far": [],
        "has_remaining": "augment_plan.needs_augmentation"
      },
      "body": [
        {
          "id": "get_next_item",
          "type": "tool",
          "ref": "tools/arch_augment_get_next_item.json",
          "inputs": {
            "remaining_items": "$.remaining_items"
          }
        },
        {
          "id": "gen_one_patch",
          "type": "agent",
          "ref": "configs/arch_augment_gen_patch.json",
          "depends_on": ["get_next_item"],
          "inputs": {
            "metric_name":       "extract_metric.metric_name",
            "current_item_json": "get_next_item.current_item",
            "tree_json":         "apply_descriptions.tree",
            "patches_so_far_json": "$.patches_so_far"
          }
        },
        {
          "id": "update_patches",
          "type": "tool",
          "ref": "tools/arch_augment_update_patches.json",
          "depends_on": ["gen_one_patch"],
          "inputs": {
            "patches_so_far":  "$.patches_so_far",
            "new_patch":       "gen_one_patch",
            "remaining_items": "get_next_item.remaining_items"
          }
        }
      ],
      "state_update": {
        "remaining_items": "update_patches.remaining_items",
        "patches_so_far":  "update_patches.patches_so_far",
        "has_remaining":   "update_patches.has_remaining"
      }
    },
    {
      "id": "apply_augmentation",
      "type": "tool",
      "ref": "arch_apply_design_patches",
      "depends_on": ["gen_patches", "apply_descriptions"],
      "inputs": {
        "tree":        "apply_descriptions.tree",
        "patch_chain": "gen_patches.patches_so_far"
      }
    }
  ],
  "outputs": {
    "ok":          "parse_tree.ok",
    "errors":      "parse_tree.errors",
    "tree":        "apply_augmentation.tree",
    "metric_name": "extract_metric.metric_name",
    "direction":   "parse_tree.direction",
    "written":     "parse_tree.written",
    "data_files":  "parse_tree.data_files"
  }
}

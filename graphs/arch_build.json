{
  "name": "arch_build",
  "description": "完整架构构建流程：模块划分 → 文件划分 → 叶子定义 → 内部定义",
  "long_running": false,
  "skills": ["skills/arch_builder.json"],
  "variables": ["requirement"],
  "steps": [
    {
      "id": "module_split",
      "type": "graph",
      "ref": "graphs/arch_module_split.json",
      "inputs": {
        "requirement": "$.requirement"
      }
    },
    {
      "id": "file_split",
      "type": "graph",
      "ref": "graphs/arch_file_split.json",
      "depends_on": ["module_split"],
      "inputs": {
        "modules":     "module_split.modules",
        "requirement": "$.requirement"
      }
    },
    {
      "id": "leaf_define",
      "type": "graph",
      "ref": "graphs/arch_leaf_define.json",
      "depends_on": ["file_split"],
      "inputs": {
        "files":       "file_split.files",
        "requirement": "$.requirement"
      }
    },
    {
      "id": "internal_define",
      "type": "graph",
      "ref": "graphs/arch_internal_define.json",
      "depends_on": ["leaf_define"],
      "inputs": {
        "files":       "leaf_define.files",
        "requirement": "$.requirement",
        "global_ids":  "leaf_define.global_ids"
      }
    }
  ],
  "outputs": {
    "ok":       "internal_define.ok",
    "errors":   "internal_define.errors",
    "warnings": "internal_define.warnings",
    "tree":     "internal_define.tree"
  }
}

{
  "name": "arch_backfill_files",
  "description": "将 map 步骤逐模块文件列表回填到模块，设置 kind: \"file\"，汇总为全量文件列表",
  "long_running": false,
  "module": "arch.backfill_files",
  "function": "arch_backfill_files",
  "parameters": {
    "type": "object",
    "required": ["modules", "file_lists"],
    "properties": {
      "modules": {
        "type": "array",
        "description": "模块列表（来自 module_split.result）"
      },
      "file_lists": {
        "type": "array",
        "description": "每个模块对应的文件列表（来自 map 步骤原始结果，list[list[dict]]）"
      }
    }
  }
}

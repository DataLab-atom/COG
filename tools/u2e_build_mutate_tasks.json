{
  "name": "u2e_build_mutate_tasks",
  "description": "基于精英个体构建变异提示任务列表：产出 int(pop_size × mutation_rate) 个相同任务，由下游 map+agent 并发多样化生成",
  "long_running": false,
  "module": "utils.u2e_tools",
  "function": "u2e_build_mutate_tasks",
  "parameters": {
    "type": "object",
    "required": [
      "elitist", "user_generator_prompt", "func_signature",
      "long_term_reflection", "external_knowledge",
      "func_name", "pop_size", "mutation_rate"
    ],
    "properties": {
      "elitist": {
        "type": "object",
        "description": "当前精英个体（含 funcs / code 字段）"
      },
      "user_generator_prompt": {
        "type": "string",
        "description": "当前函数的 user_generator 提示词"
      },
      "func_signature": {
        "type": "string",
        "description": "当前函数签名"
      },
      "long_term_reflection": {
        "type": "string",
        "description": "当前长期反思字符串"
      },
      "external_knowledge": {
        "type": "string",
        "description": "外部知识字符串（与 long_term_reflection 拼接后作为 reflection）"
      },
      "func_name": {
        "type": "string",
        "description": "当前函数名"
      },
      "pop_size": {
        "type": "integer",
        "description": "种群大小"
      },
      "mutation_rate": {
        "type": "number",
        "description": "变异比例，产出 int(pop_size × mutation_rate) 个变异任务"
      }
    }
  }
}

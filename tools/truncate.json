{
  "name": "truncate",
  "description": "将文本截断到指定字符数上限，返回截断后的文本及是否发生截断的标志",
  "module": "utils.text_utils",
  "function": "truncate",
  "parameters": {
    "type": "object",
    "required": ["text", "max_chars"],
    "properties": {
      "text": {
        "type": "string",
        "description": "待截断的原始文本"
      },
      "max_chars": {
        "type": "integer",
        "description": "允许的最大字符数（含 suffix）"
      },
      "suffix": {
        "type": "string",
        "description": "超出时附加到末尾的省略符，默认为 \"...\""
      }
    }
  }
}

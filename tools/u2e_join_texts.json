{
  "name": "u2e_join_texts",
  "description": "将字符串列表（map 步骤输出）拼合为单一字符串，供 Agent prompt 模板的 user_variables 使用",
  "long_running": false,
  "module": "utils.u2e_tools",
  "function": "u2e_join_texts",
  "parameters": {
    "type": "object",
    "required": ["texts"],
    "properties": {
      "texts": {
        "type": "array",
        "description": "字符串列表，通常来自 map 步骤的输出"
      },
      "separator": {
        "type": "string",
        "description": "拼合分隔符（默认换行 \\n）",
        "default": "\n"
      }
    }
  }
}

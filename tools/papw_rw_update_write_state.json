{
  "name": "papw_rw_update_write_state",
  "description": "更新相关工作写作循环状态",
  "module": "utils.papw_tools",
  "function": "papw_rw_update_write_state",
  "parameters": {
    "type": "object",
    "required": ["tex_code", "selected_bib_entries", "current_done_write", "current_all_bib", "current_used_bib_set", "field_index", "sentence_index", "sentence_num", "total_fields"],
    "properties": {
      "tex_code": { "type": "string", "description": "写作内容" },
      "selected_bib_entries": { "type": "array", "description": "选中的 bib 条目列表" },
      "current_done_write": { "type": "string", "description": "当前已完成写作" },
      "current_all_bib": { "type": "string", "description": "当前累计 bib" },
      "current_used_bib_set": { "type": "array", "description": "当前已用 bib 集合" },
      "field_index": { "type": "integer", "description": "当前领域索引" },
      "sentence_index": { "type": "integer", "description": "当前句子索引" },
      "sentence_num": { "type": "integer", "description": "每领域句子数" },
      "total_fields": { "type": "integer", "description": "总领域数" }
    }
  }
}

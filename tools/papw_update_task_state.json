{
  "name": "papw_update_task_state",
  "description": "根据任务执行结果更新循环状态（done_write / related_think / index）",
  "module": "utils.papw_tools",
  "function": "papw_update_task_state",
  "parameters": {
    "type": "object",
    "required": ["task_type", "dispatch_result", "current_done_write", "current_related_think", "task_index", "total_tasks"],
    "properties": {
      "task_type": {
        "type": "string",
        "description": "任务类型：'think' 或 'write'"
      },
      "dispatch_result": {
        "type": "object",
        "description": "agent 返回的结果 dict"
      },
      "current_done_write": {
        "type": "string",
        "description": "当前已完成的写作内容"
      },
      "current_related_think": {
        "type": "string",
        "description": "当前已积累的思考内容"
      },
      "task_index": {
        "type": "integer",
        "description": "当前任务索引"
      },
      "total_tasks": {
        "type": "integer",
        "description": "总任务数"
      }
    }
  }
}

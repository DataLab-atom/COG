{
  "name": "papw_select_citations",
  "description": "从检索结果中选择未使用的引用并格式化",
  "module": "utils.papw_tools",
  "function": "papw_select_citations",
  "parameters": {
    "type": "object",
    "required": ["retrieval_results", "used_bib_set"],
    "properties": {
      "retrieval_results": { "type": "array", "description": "VDB 检索结果列表" },
      "used_bib_set": { "type": "array", "description": "已使用的 bib 条目列表" },
      "max_cite_num": { "type": "integer", "description": "最多引用数", "default": 3 },
      "max_data_per_cite": { "type": "integer", "description": "每引用最大数据条数", "default": 3 }
    }
  }
}

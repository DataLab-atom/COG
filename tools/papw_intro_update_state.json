{
  "name": "papw_intro_update_state",
  "description": "根据引言子任务（cite/no-cite 分支）执行结果更新循环状态",
  "module": "utils.papw_tools",
  "function": "papw_intro_update_state",
  "parameters": {
    "type": "object",
    "required": [
      "dispatch_result",
      "current_done_write",
      "current_all_bib",
      "current_used_bib_set",
      "task_index",
      "total_tasks"
    ],
    "properties": {
      "dispatch_result": {
        "type": "object",
        "description": "cond 分支执行结果（cite 分支含 tex_code + selected_bib_entries，no-cite 分支含 tex_code）"
      },
      "current_done_write": {
        "type": "string",
        "description": "已完成的写作内容"
      },
      "current_all_bib": {
        "type": "string",
        "description": "已累积的 bib 内容"
      },
      "current_used_bib_set": {
        "type": "array",
        "description": "已使用的引用 key 集合"
      },
      "task_index": {
        "type": "integer",
        "description": "当前任务索引"
      },
      "total_tasks": {
        "type": "integer",
        "description": "总任务数"
      }
    }
  }
}

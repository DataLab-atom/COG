{
  "name": "mcts_create_root_node",
  "description": "创建 MCTS 搜索树根节点，返回初始 frontier 列表和 all_nodes 注册表",
  "long_running": false,
  "module": "utils.mcts.tools",
  "function": "mcts_create_root_node",
  "parameters": {
    "type": "object",
    "required": ["baseline_score", "baseline_log"],
    "properties": {
      "baseline_score": {
        "type": "number",
        "description": "基线分数（来自 mcts_init）"
      },
      "baseline_log": {
        "type": "string",
        "description": "基线运行的 main.py stdout 输出"
      }
    }
  }
}

{
  "name": "papw_intro_build_req",
  "description": "构建引言写作需求：从架构树、最优 patches、研究信息和已完成章节构建完整需求文本",
  "module": "utils.papw_tools",
  "function": "papw_intro_build_req",
  "parameters": {
    "type": "object",
    "required": ["arch_tree", "best_patches", "research_information_path", "papw_root"],
    "properties": {
      "arch_tree": {
        "type": "array",
        "description": "项目架构树（含函数依赖关系）"
      },
      "best_patches": {
        "type": "array",
        "description": "最优代码 patch 链"
      },
      "research_information_path": {
        "type": "string",
        "description": "研究信息路径"
      },
      "papw_root": {
        "type": "string",
        "description": "papw 工作根目录（用于读取已完成章节）"
      }
    }
  }
}

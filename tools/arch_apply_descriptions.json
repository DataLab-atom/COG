{
  "name": "arch_apply_descriptions",
  "description": "将 agent 生成的描述列表写回 arch tree 节点的 description 字段",
  "module": "utils.arch.enrich_tools",
  "function": "arch_apply_descriptions",
  "parameters": {
    "type": "object",
    "required": ["tree", "descriptions"],
    "properties": {
      "tree": {
        "type": "array",
        "description": "arch_parse_project 输出的 tree"
      },
      "descriptions": {
        "type": "array",
        "description": "agent 返回的描述列表，每项含 fn_id 和 description",
        "items": {
          "type": "object",
          "properties": {
            "fn_id":       { "type": "string" },
            "description": { "type": "string" }
          }
        }
      }
    }
  }
}

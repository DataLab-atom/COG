{
  "name": "mcts_apply_best",
  "description": "将最优节点的累积 patch 链按顺序写回到项目文件（写入前保留 .bak 备份）",
  "long_running": false,
  "module": "utils.mcts.tools",
  "function": "mcts_apply_best",
  "parameters": {
    "type": "object",
    "required": ["best_node", "project_root"],
    "properties": {
      "best_node": {
        "type": "object",
        "description": "全局最优节点 dict，含 patches 列表"
      },
      "project_root": {
        "type": "string",
        "description": "项目根目录绝对路径"
      }
    }
  }
}

{
  "name": "papw_exp_save_research_info",
  "description": "保存研究信息到 JSON 文件",
  "module": "utils.papw_tools",
  "function": "papw_exp_save_research_info",
  "parameters": {
    "type": "object",
    "required": ["research_info_path", "method_name", "main_research", "method_statement", "abstracts_count"],
    "properties": {
      "research_info_path": { "type": "string", "description": "输出路径" },
      "method_name": { "type": "string", "description": "方法名称" },
      "main_research": { "type": "string", "description": "主要研究方向" },
      "method_statement": { "type": "string", "description": "方法陈述" },
      "abstracts_count": { "type": "integer", "description": "摘要数量" }
    }
  }
}

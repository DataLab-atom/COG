{
  "name": "u2e_update_iter",
  "description": "更新全局精英、最优目标值和 func_individual 分类存储，并判断进化是否继续（should_continue）",
  "long_running": false,
  "module": "utils.u2e_tools",
  "function": "u2e_update_iter",
  "parameters": {
    "type": "object",
    "required": [
      "population", "func_names", "func_individual",
      "func_best_obj_overall", "func_elitist",
      "elitist", "best_obj_overall", "best_code_overall",
      "best_code_func_index_overall",
      "iteration", "function_evals", "max_fe"
    ],
    "properties": {
      "population": {
        "type": "array",
        "description": "本轮新产出的已评估 individual 列表"
      },
      "func_names": {
        "type": "array",
        "description": "全量函数名列表"
      },
      "func_individual": {
        "type": "object",
        "description": "{func_name: [individual, ...]} 历史汇总（循环状态）"
      },
      "func_best_obj_overall": {
        "type": "object",
        "description": "{func_name: best_obj} 各函数最优目标值历史"
      },
      "func_elitist": {
        "type": "object",
        "description": "{func_name: elitist_individual} 各函数精英"
      },
      "elitist": {
        "type": ["object", "null"],
        "description": "当前全局精英个体（初始为 null）"
      },
      "best_obj_overall": {
        "type": ["number", "null"],
        "description": "当前全局最优目标值（初始为 null）"
      },
      "best_code_overall": {
        "type": ["string", "null"],
        "description": "当前最优代码字符串（初始为 null）"
      },
      "best_code_func_index_overall": {
        "type": ["integer", "null"],
        "description": "当前最优代码对应的 func_index（初始为 null）"
      },
      "iteration": {
        "type": "integer",
        "description": "当前迭代号（返回时 +1）"
      },
      "function_evals": {
        "type": "integer",
        "description": "当前累计函数评估次数"
      },
      "max_fe": {
        "type": "integer",
        "description": "最大评估次数上限，超过后 should_continue=false"
      },
      "elite_archive": {
        "type": "array",
        "description": "当前精英档案（循环状态），初始为 []",
        "default": []
      },
      "archive_size": {
        "type": "integer",
        "description": "精英档案最大容量（默认 10）",
        "default": 10
      },
      "min_diversity": {
        "type": "number",
        "description": "档案成员间最小代码多样性距离阈值（0~1，默认 0.1）",
        "default": 0.1
      }
    }
  }
}

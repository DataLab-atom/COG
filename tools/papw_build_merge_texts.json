{
  "name": "papw_build_merge_texts",
  "description": "构建合并写作各阶段所需的文本拼接",
  "module": "utils.papw_tools",
  "function": "papw_build_merge_texts",
  "parameters": {
    "type": "object",
    "required": ["introduction", "related_work", "methodology", "experiments", "bibliography", "conclusion", "abstract", "title", "tex_template"],
    "properties": {
      "introduction": { "type": "string", "description": "引言 LaTeX 内容" },
      "related_work": { "type": "string", "description": "相关工作 LaTeX 内容" },
      "methodology": { "type": "string", "description": "方法论 LaTeX 内容" },
      "experiments": { "type": "string", "description": "实验 LaTeX 内容" },
      "bibliography": { "type": "string", "description": "bib 内容" },
      "conclusion": { "type": "string", "description": "结论内容" },
      "abstract": { "type": "string", "description": "摘要内容" },
      "title": { "type": "string", "description": "论文标题" },
      "tex_template": { "type": "string", "description": "LaTeX 模板内容" }
    }
  }
}

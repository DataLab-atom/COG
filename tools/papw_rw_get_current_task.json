{
  "name": "papw_rw_get_current_task",
  "description": "获取当前要处理的领域和句子索引",
  "module": "utils.papw_tools",
  "function": "papw_rw_get_current_task",
  "parameters": {
    "type": "object",
    "required": ["fields", "field_index", "sentence_index", "sentence_num"],
    "properties": {
      "fields": { "type": "array", "description": "研究领域列表" },
      "field_index": { "type": "integer", "description": "当前领域索引" },
      "sentence_index": { "type": "integer", "description": "当前句子索引" },
      "sentence_num": { "type": "integer", "description": "每领域句子数" }
    }
  }
}

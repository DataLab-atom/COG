{
  "name": "mcts_parse_atomic_ops",
  "description": "将 Critic 的结构优化提案拆解为原子级 Engineer 任务列表：node_a 生成 rewrite 任务，new_nodes 生成 create 任务",
  "long_running": false,
  "module": "utils.mcts.tools",
  "function": "mcts_parse_atomic_ops",
  "parameters": {
    "type": "object",
    "required": [
      "op",
      "node_a_file", "node_a_type", "node_a_name",
      "node_b_file", "node_b_type", "node_b_name",
      "direction", "reasoning",
      "tree", "ancestor_patches"
    ],
    "properties": {
      "op": {
        "type": "string",
        "description": "结构算子名称（insert/merge/decouple/split/extract/parallelize/pipeline/stratify）"
      },
      "node_a_file":  { "type": "string", "description": "主节点所在文件相对路径" },
      "node_a_type":  { "type": "string", "description": "主节点类型：function 或 class" },
      "node_a_name":  { "type": "string", "description": "主节点名称" },
      "node_b_file":  { "type": "string", "description": "次节点所在文件相对路径" },
      "node_b_type":  { "type": "string", "description": "次节点类型：function 或 class" },
      "node_b_name":  { "type": "string", "description": "次节点名称" },
      "direction":    { "type": "string", "description": "一句话结构改造方向描述" },
      "reasoning":    { "type": "string", "description": "改造理由" },
      "new_nodes": {
        "type": "array",
        "description": "insert/split/extract 算子需要新建的节点列表，每项含 name 和 description",
        "items": {
          "type": "object",
          "properties": {
            "name":        { "type": "string" },
            "description": { "type": "string" }
          }
        }
      },
      "tree": {
        "type": "array",
        "description": "架构树节点列表（含 id/kind/code 字段）"
      },
      "ancestor_patches": {
        "type": "array",
        "description": "父节点累积 patch 链，用于计算各目标节点的当前代码"
      }
    }
  }
}

"root": false, "imports": [{"import": "numpy", "as": "np"}, {"import": "pandas", "as": "pd"}, {"from": "sklearn.neighbors", "names": ["NearestNeighbors"]}, {"from": "typing", "names": ["Iterable"]}], "constants": [], "types": [], "functions": ["fn::compute_lisi", "fn::compute_simpson"], "standalone_functions": ["fn::compute_lisi", "fn::compute_simpson"]}, {"id": "file::tests/__init__", "kind": "file", "path": "tests/__init__.py", "root": false, "imports": [], "constants": [], "types": [], "functions": [], "standalone_functions": []}, {"id": "file::tests/test_harmony", "kind": "file", "path": "tests/test_harmony.py", "root": false, "imports": [{"from": "time", "names": ["time"]}, {"import": "numpy", "as": "np"}, {"import": "pandas", "as": "pd"}, {"from": "scipy.stats", "names": ["pearsonr"]}, {"import": "os"}, {"import": "harmonypy", "as": "hm"}, {"import": "torch"}], "constants": [], "types": [], "functions": ["fn::test_run_harmony_small", "fn::test_random_seed", "fn::run_harmony_2", "fn::download_data"], "standalone_functions": ["fn::test_run_harmony_small", "fn::test_random_seed", "fn::run_harmony_2", "fn::download_data"]}, {"id": "file::tests/test_lisi", "kind": "file", "path": "tests/test_lisi.py", "root": false, "imports": [{"import": "harmonypy", "as": "hm"}, {"import": "pandas", "as": "pd"}, {"import": "numpy", "as": "np"}], "constants": [], "types": [], "functions": ["fn::test_lisi"], "standalone_functions": ["fn::test_lisi"]}, {"id": "fn::get_device", "kind": "function", "params": [{"name": "device", "type": "Any"}], "returns": {"type": "Any"}, "is_async": false, "description": "Get the appropriate device for PyTorch operations.", "code": "def get_device(device=None):\\n    \\"\\"\\"Get the appropriate device for PyTorch operations.\\"\\"\\"\\n    if device is not None:\\n        return torch.device(device)\\n\\n    # Check for available accelerators\\n    if torch.cuda.is_available():\\n        return torch.device(\'cuda\')\\n    elif hasattr(torch.backends, \'mps\') and torch.backends.mps.is_available():\\n        return torch.device(\'mps\')\\n    else:\\n        return torch.device(\'cpu\')"}, {"id": "fn::run_harmony", "kind": "function", "params": [{"name": "data_mat", "type": "np.ndarray"}, {"name": "meta_data", "type": "pd.DataFrame"}, {"name": "vars_use", "type": "Any"}, {"name": "theta", "type": "Any"}, {"name": "lamb", "type": "Any"}, {"name": "sigma", "type": "Any"}, {"name": "nclust", "type": "Any"}, {"name": "tau", "type": "Any"}, {"name": "block_size", "type": "Any"}, {"name": "max_iter_harmony", "type": "Any"}, {"name": "max_iter_kmeans", "type": "Any"}, {"name": "epsilon_cluster", "type": "Any"}, {"name": "epsilon_harmony", "type": "Any"}, {"name": "alpha", "type": "Any"}, {"name": "verbose", "type": "Any"}, {"name": "random_state", "type": "Any"}, {"name": "device", "type": "Any"}], "returns": {"type": "Any"}, "is_async": false, "description": "Run Harmony batch effect correction.\\n\\nThis is a PyTorch implementation matching the R package formulas.\\nSupports CPU and GPU (CUDA, MPS) acceleration.\\n\\nParameters\\n----------\\ndata_mat : np.ndarray\\n    PCA embedding matrix (cells x PCs or PCs x cells)\\nmeta_data : pd.DataFrame\\n    Metadata with batch variables (cells x variables)\\nvars_use : str or list\\n    Column name(s) in meta_data to use for batch correction\\ntheta : float or list, optional\\n    Diversity penalty parameter(s). Default is 2 for each batch.\\nlamb : float or list, optional\\n    Ridge regression penalty. Default is 1 for each batch.\\n    If -1, lambda is estimated automatically (matches R package).\\nsigma : float, optional\\n    Kernel bandwidth for soft clustering. Default is 0.1.\\nnclust : int, optional\\n    Number of clusters. Default is min(N/30, 100).\\ntau : float, optional\\n    Protection against overcorrection. Default is 0.\\nblock_size : float, optional\\n    Proportion of cells to update in each block. Default is 0.05.\\nmax_iter_harmony : int, optional\\n    Maximum Harmony iterations. Default is 10.\\nmax_iter_kmeans : int, optional\\n    Maximum k-means iterations per Harmony iteration. Default is 20.\\nepsilon_cluster : float, optional\\n    K-means convergence threshold. Default is 1e-5.\\nepsilon_harmony : float, optional\\n    Harmony convergence threshold. Default is 1e-4.\\nalpha : float, optional\\n    Alpha parameter for lambda estimation (when lamb=-1). Default is 0.2.\\nverbose : bool, optional\\n    Print progress messages. Default is True.\\nrandom_state : int, optional\\n    Random seed for reproducibility. Default is 0.\\ndevice : str, optional\\n    Device to use (\'cpu\', \'cuda\', \'mps\'). Default is auto-detect.\\n    \\nReturns\\n-------\\nHarmony\\n    Harmony object with corrected data in Z_corr attribute.", "code": "def run_harmony(\\n    data_mat: np.ndarray,\\n    meta_data: pd.DataFrame,\\n    vars_use,\\n    theta=None,\\n    lamb=None,\\n    sigma=0.1, \\n    nclust=None,\\n    tau=0,\\n    block_size=0.05, \\n    max_iter_harmony=10,\\n    max_iter_kmeans=20,\\n    epsilon_cluster=1e-5,\\n    epsilon_harmony=1e-4, \\n    alpha=0.2,\\n    verbose=True,\\n    random_state=0,\\n    device=None\\n):\\n    \\"\\"\\"Run Harmony batch effect correction.\\n\\n    This is a PyTorch implementation matching the R package formulas.\\n    Supports CPU and GPU (CUDA, MPS) acceleration.\\n\\n    Parameters\\n    ----------\\n    data_mat : np.ndarray\\n        PCA embedding matrix (cells x PCs or PCs x cells)\\n    meta_data : pd.DataFrame\\n        Metadata with batch variables (cells x variables)\\n    vars_use : str or list\\n        Column name(s) in meta_data to use for batch correction\\n    theta : float or list, optional\\n        Diversity penalty parameter(s). Default is 2 for each batch.\\n    lamb : float or list, optional\\n        Ridge regression penalty. Default is 1 for each batch.\\n        If -1, lambda is estimated automatically (matches R package).\\n    sigma : float, optional\\n        Kernel bandwidth for soft clustering. Default is 0.1.\\n    nclust : int, optional\\n        Number of clusters. Default is min(N/30, 100).\\n    tau : float, optional\\n        Protection against overcorrection. Default is 0.\\n    block_size : float, optional\\n        Proportion of cells to update in each block. Default is 0.05.\\n    max_iter_harmony : int, optional\\n        Maximum Harmony iterations. Default is 10.\\n    max_iter_kmeans : int, optional\\n        Maximum k-means iterations per Harmony iteration. Default is 20.\\n    epsilon_cluster : float, optional\\n        K-means convergence threshold. Default is 1e-5.\\n    epsilon_harmony : float, optional\\n        Harmony convergence threshold. Default is 1e-4.\\n    alpha : float, optional\\n        Alpha parameter for lambda estimation (when lamb=-1). Default is 0.2.\\n    verbose : bool, optional\\n        Print progress messages. Default is True.\\n    random_state : int, optional\\n        Random seed for reproducibility. Default is 0.\\n    device : str, optional\\n        Device to use (\'cpu\', \'cuda\', \'mps\'). Default is auto-detect.\\n\\n    Returns\\n    -------\\n    Harmony\\n        Harmony object with corrected data in Z_corr attribute.\\n    \\"\\"\\"\\n    N = meta_data.shape[0]\\n    if data_mat.shape[1] != N:\\n        data_mat = data_mat.T\\n\\n    assert data_mat.shape[1] == N, \\\\\\n       \\"data_mat and meta_data do not have the same number of cells\\" \\n\\n    if nclust is None:\\n        nclust = int(min(round(N / 30.0), 100))\\n\\n    if isinstance(sigma, float) and nclust > 1:\\n        sigma = np.repeat(sigma, nclust)\\n\\n    if isinstance(vars_use, str):\\n        vars_use = [vars_use]\\n\\n    # Create batch indicator matrix (one-hot encoded)\\n    phi = pd.get_dummies(meta_data[vars_use]).to_numpy().T.astype(np.float32)\\n    phi_n = meta_data[vars_use].describe().loc[\'unique\'].to_numpy().astype(int)\\n\\n    # Theta handling - default is 2 (matches R package)\\n    if theta is None:\\n        theta = np.repeat([2] * len(phi_n), phi_n).astype(np.float32)\\n    elif isinstance(theta, (float, int)):\\n        theta = np.repeat([theta] * len(phi_n), phi_n).astype(np.float32)\\n    elif len(theta) == len(phi_n):\\n        theta = np.repeat([theta], phi_n).astype(np.float32)\\n    else:\\n        theta = np.asarray(theta, dtype=np.float32)\\n\\n    assert len(theta) == np.sum(phi_n), \\\\\\n        \\"each batch variable must have a theta\\"\\n\\n    # Lambda handling (matches R package)\\n    lambda_estimation = False\\n    if lamb is None:\\n        lamb = np.repeat([1] * len(phi_n), phi_n).astype(np.float32)\\n        lamb = np.insert(lamb, 0, 0).astype(np.float32)\\n    elif lamb == -1:\\n        lambda_estimation = True\\n        lamb = np.zeros(1, dtype=np.float32)\\n    elif isinstance(lamb, (float, int)):\\n        lamb = np.repeat([lamb] * len(phi_n), phi_n).astype(np.float32)\\n        lamb = np.insert(lamb, 0, 0).astype(np.float32)\\n    elif len(lamb) == len(phi_n):\\n        lamb = np.repeat([lamb], phi_n).astype(np.float32)\\n        lamb = np.insert(lamb, 0, 0).astype(np.float32)\\n    else:\\n        lamb = np.asarray(lamb, dtype=np.float32)\\n        if len(lamb) == np.sum(phi_n):\\n            lamb = np.insert(lamb, 0, 0).astype(np.float32)\\n\\n    # Number of items in each category\\n    N_b = phi.sum(axis=1)\\n    Pr_b = (N_b / N).astype(np.float32)\\n\\n    if tau > 0:\\n        theta = theta * (1 - np.exp(-(N_b / (nclust * tau)) ** 2))\\n\\n    # Get device\\n    device_obj = get_device(device)\\n\\n    if verbose:\\n        logger.info(f\\"Running Harmony (PyTorch on {device_obj})\\")\\n        logger.info(\\"  Parameters:\\")\\n        logger.info(f\\"    max_iter_harmony: {max_iter_harmony}\\")\\n        logger.info(f\\"    max_iter_kmeans: {max_iter_kmeans}\\")\\n        logger.info(f\\"    epsilon_cluster: {epsilon_cluster}\\")\\n        logger.info(f\\"    epsilon_harmony: {epsilon_harmony}\\")\\n        logger.info(f\\"    nclust: {nclust}\\")\\n        logger.info(f\\"    block_size: {block_size}\\")\\n        if lambda_estimation:\\n            logger.info(f\\"    lamb: dynamic (alpha={alpha})\\")\\n        else:\\n            logger.info(f\\"    lamb: {lamb[1:]}\\")\\n        logger.info(f\\"    theta: {theta}\\")\\n        logger.info(f\\"    sigma: {sigma[:5]}...\\" if len(sigma) > 5 else f\\"    sigma: {sigma}\\")\\n        logger.info(f\\"    verbose: {verbose}\\")\\n        logger.info(f\\"    random_state: {random_state}\\")\\n        logger.info(f\\"  Data: {data_mat.shape[0]} PCs × {N} cells\\")\\n        logger.info(f\\"  Batch variables: {vars_use}\\")\\n\\n    # Set random seeds\\n    np.random.seed(random_state)\\n    torch.manual_seed(random_state)\\n\\n    # Ensure data_mat is a proper numpy array\\n    if hasattr(data_mat, \'values\'):\\n        data_mat = data_mat.values\\n    data_mat = np.asarray(data_mat, dtype=np.float32)\\n\\n    ho = Harmony(\\n        data_mat, phi, Pr_b, sigma.astype(np.float32), \\n        theta, lamb, alpha, lambda_estimation,\\n        max_iter_harmony, max_iter_kmeans,\\n        epsilon_cluster, epsilon_harmony, nclust, block_size, verbose,\\n        random_state, device_obj\\n    )\\n\\n    return ho"}, {"id": "fn::__init__", "kind": "function", "params": [{"name": "Z", "type": "Any"}, {"name": "Phi", "type": "Any"}, {"name": "Pr_b", "type": "Any"}, {"name": "sigma", "type": "Any"}, {"name": "theta", "type": "Any"}, {"name": "lamb", "type": "Any"}, {"name": "alpha", "type": "Any"}, {"name": "lambda_estimation", "type": "Any"}, {"name": "max_iter_harmony", "type": "Any"}, {"name": "max_iter_kmeans", "type": "Any"}, {"name": "epsilon_kmeans", "type": "Any"}, {"name": "epsilon_harmony", "type": "Any"}, {"name": "K", "type": "Any"}, {"name": "block_size", "type": "Any"}, {"name": "verbose", "type": "Any"}, {"name": "random_state", "type": "Any"}, {"name": "device", "type": "Any"}], "returns": {"type": "Any"}, "is_async": false, "description": "初始化函数用于设置模型的基本参数和数据，包括将输入数据转换为PyTorch张量，并进行L2归一化处理。", "code": "def __init__(\\n        self, Z, Phi, Pr_b, sigma, theta, lamb, alpha, lambda_estimation,\\n        max_iter_harmony, max_iter_kmeans, \\n        epsilon_kmeans, epsilon_harmony, K, block_size, verbose,\\n        random_state, device\\n):\\n    self.device = device\\n\\n    # Convert to PyTorch tensors on device\\n    # Store with underscore prefix internally, expose as properties returning NumPy arrays\\n    self._Z_corr = torch.tensor(Z, dtype=torch.float32, device=device)\\n    self._Z_orig = torch.tensor(Z, dtype=torch.float32, device=device)\\n\\n    # Simple L2 normalization\\n    self._Z_cos = self._Z_orig / torch.linalg.norm(self._Z_orig, ord=2, dim=0)\\n\\n    # Batch indicators\\n    self._Phi = torch.tensor(Phi, dtype=torch.float32, device=device)\\n    self._Pr_b = torch.tensor(Pr_b, dtype=torch.float32, device=device)\\n\\n    self.N = self._Z_corr.shape[1]\\n    self.B = Phi.shape[0]\\n    self.d = self._Z_corr.shape[0]\\n\\n    # Build batch index for fast ridge correction\\n    self._batch_index = []\\n    for b in range(self.B):\\n        idx = torch.where(self._Phi[b, :] > 0)[0]\\n        self._batch_index.append(idx)\\n\\n    # Create Phi_moe with intercept\\n    ones = torch.ones(1, self.N, dtype=torch.float32, device=device)\\n    self._Phi_moe = torch.cat([ones, self._Phi], dim=0)\\n\\n    self.window_size = 3\\n    self.epsilon_kmeans = epsilon_kmeans\\n    self.epsilon_harmony = epsilon_harmony\\n\\n    self._lamb = torch.tensor(lamb, dtype=torch.float32, device=device)\\n    self.alpha = alpha\\n    self.lambda_estimation = lambda_estimation\\n    self._sigma = torch.tensor(sigma, dtype=torch.float32, device=device)\\n    self.block_size = block_size\\n    self.K = K\\n    self.max_iter_harmony = max_iter_harmony\\n    self.max_iter_kmeans = max_iter_kmeans\\n    self.verbose = verbose\\n    self._theta = torch.tensor(theta, dtype=torch.float32, device=device)\\n\\n    self.objective_harmony = []\\n    self.objective_kmeans = []\\n    self.objective_kmeans_dist = []\\n    self.objective_kmeans_entropy = []\\n    self.objective_kmeans_cross = []\\n    self.kmeans_rounds = []\\n\\n    self.allocate_buffers()\\n    self.init_cluster(random_state)\\n    self.harmonize(self.max_iter_harmony, self.verbose)"}, {"id": "fn::Z_corr", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "Corrected embedding matrix (N x d). Batch effects removed.", "code": "@property\\ndef Z_corr(self):\\n    \\"\\"\\"Corrected embedding matrix (N x d). Batch effects removed.\\"\\"\\"\\n    return self._Z_corr.cpu().numpy().T"}, {"id": "fn::Z_orig", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "Original embedding matrix (N x d). Input data before correction.", "code": "@property\\ndef Z_orig(self):\\n    \\"\\"\\"Original embedding matrix (N x d). Input data before correction.\\"\\"\\"\\n    return self._Z_orig.cpu().numpy().T"}, {"id": "fn::Z_cos", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "L2-normalized embedding matrix (N x d). Used for clustering.", "code": "@property\\ndef Z_cos(self):\\n    \\"\\"\\"L2-normalized embedding matrix (N x d). Used for clustering.\\"\\"\\"\\n    return self._Z_cos.cpu().numpy().T"}, {"id": "fn::R", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "Soft cluster assignment matrix (N x K). R[i,k] = P(cell i in cluster k).", "code": "@property\\ndef R(self):\\n    \\"\\"\\"Soft cluster assignment matrix (N x K). R[i,k] = P(cell i in cluster k).\\"\\"\\"\\n    return self._R.cpu().numpy().T"}, {"id": "fn::Y", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "Cluster centroids matrix (d x K). Columns are cluster centers.", "code": "@property\\ndef Y(self):\\n    \\"\\"\\"Cluster centroids matrix (d x K). Columns are cluster centers.\\"\\"\\"\\n    return self._Y.cpu().numpy()"}, {"id": "fn::O", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "Observed batch-cluster counts (K x B). O[k,b] = sum of R[k,:] for batch b.", "code": "@property\\ndef O(self):\\n    \\"\\"\\"Observed batch-cluster counts (K x B). O[k,b] = sum of R[k,:] for batch b.\\"\\"\\"\\n    return self._O.cpu().numpy()"}, {"id": "fn::E", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "Expected batch-cluster counts (K x B). E[k,b] = cluster_size[k] * batch_proportion[b].", "code": "@property\\ndef E(self):\\n    \\"\\"\\"Expected batch-cluster counts (K x B). E[k,b] = cluster_size[k] * batch_proportion[b].\\"\\"\\"\\n    return self._E.cpu().numpy()"}, {"id": "fn::Phi", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "Batch indicator matrix (N x B). One-hot encoding of batch membership.", "code": "@property\\ndef Phi(self):\\n    \\"\\"\\"Batch indicator matrix (N x B). One-hot encoding of batch membership.\\"\\"\\"\\n    return self._Phi.cpu().numpy().T"}, {"id": "fn::Phi_moe", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "Batch indicator with intercept (N x (B+1)). First column is all ones.", "code": "@property\\ndef Phi_moe(self):\\n    \\"\\"\\"Batch indicator with intercept (N x (B+1)). First column is all ones.\\"\\"\\"\\n    return self._Phi_moe.cpu().numpy().T"}, {"id": "fn::Pr_b", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "Batch proportions (B,). Pr_b[b] = cells in batch b / total cells.", "code": "@property\\ndef Pr_b(self):\\n    \\"\\"\\"Batch proportions (B,). Pr_b[b] = cells in batch b / total cells.\\"\\"\\"\\n    return self._Pr_b.cpu().numpy()"}, {"id": "fn::theta", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "Diversity penalty parameters (B,). Higher = more mixing encouraged.", "code": "@property\\ndef theta(self):\\n    \\"\\"\\"Diversity penalty parameters (B,). Higher = more mixing encouraged.\\"\\"\\"\\n    return self._theta.cpu().numpy()"}, {"id": "fn::sigma", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "Clustering bandwidth parameters (K,). Soft assignment kernel width.", "code": "@property\\ndef sigma(self):\\n    \\"\\"\\"Clustering bandwidth parameters (K,). Soft assignment kernel width.\\"\\"\\"\\n    return self._sigma.cpu().numpy()"}, {"id": "fn::lamb", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "Ridge regression penalty ((B+1),). Regularization for batch correction.", "code": "@property \\ndef lamb(self):\\n    \\"\\"\\"Ridge regression penalty ((B+1),). Regularization for batch correction.\\"\\"\\"\\n    return self._lamb.cpu().numpy()"}, {"id": "fn::result", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "Return corrected data as NumPy array.", "code": "def result(self):\\n    \\"\\"\\"Return corrected data as NumPy array.\\"\\"\\"\\n    return self._Z_corr.cpu().numpy().T"}, {"id": "fn::allocate_buffers", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "分配必要的缓冲区以存储模型计算中使用的中间结果，确保在设备上创建合适的张量。", "code": "def allocate_buffers(self):\\n    self._scale_dist = torch.zeros((self.K, self.N), dtype=torch.float32, device=self.device)\\n    self._dist_mat = torch.zeros((self.K, self.N), dtype=torch.float32, device=self.device)\\n    self._O = torch.zeros((self.K, self.B), dtype=torch.float32, device=self.device)\\n    self._E = torch.zeros((self.K, self.B), dtype=torch.float32, device=self.device)\\n    self._W = torch.zeros((self.B + 1, self.d), dtype=torch.float32, device=self.device)\\n    self._R = torch.zeros((self.K, self.N), dtype=torch.float32, device=self.device)\\n    self._Y = torch.zeros((self.d, self.K), dtype=torch.float32, device=self.device)"}, {"id": "fn::init_cluster", "kind": "function", "params": [{"name": "random_state", "type": "Any"}], "returns": {"type": "Any"}, "is_async": false, "description": "使用KMeans算法初始化聚类中心，并计算距离矩阵和相关统计信息，以便后续的聚类操作。", "code": "def init_cluster(self, random_state):\\n    logger.info(\\"Computing initial centroids with sklearn.KMeans...\\")\\n    # KMeans needs CPU numpy array\\n    Z_cos_np = self._Z_cos.cpu().numpy()\\n    model = KMeans(n_clusters=self.K, init=\'k-means++\',\\n                   n_init=1, max_iter=25, random_state=random_state)\\n    model.fit(Z_cos_np.T)\\n    self._Y = torch.tensor(model.cluster_centers_.T, dtype=torch.float32, device=self.device)\\n    logger.info(\\"KMeans initialization complete.\\")\\n\\n    # Normalize centroids\\n    self._Y = self._Y / torch.linalg.norm(self._Y, ord=2, dim=0)\\n\\n    # Compute distance matrix: dist = 2 * (1 - Y.T @ Z_cos)\\n    self._dist_mat = 2 * (1 - self._Y.T @ self._Z_cos)\\n\\n    # Compute R\\n    self._R = -self._dist_mat / self._sigma[:, None]\\n    self._R = torch.exp(self._R)\\n    self._R = self._R / self._R.sum(dim=0)\\n\\n    # Batch diversity statistics\\n    self._E = torch.outer(self._R.sum(dim=1), self._Pr_b)\\n    self._O = self._R @ self._Phi.T\\n\\n    self.compute_objective()\\n    self.objective_harmony.append(self.objective_kmeans[-1])"}, {"id": "fn::compute_objective", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "计算当前模型的目标函数值，包括K-means误差、熵和交叉熵，以评估模型的性能。", "code": "def compute_objective(self):\\n    # Normalization constant\\n    norm_const = 2000.0 / self.N\\n\\n    # K-means error\\n    kmeans_error = torch.sum(self._R * self._dist_mat).item()\\n\\n    # Entropy\\n    _entropy = torch.sum(safe_entropy_torch(self._R) * self._sigma[:, None]).item()\\n\\n    # Cross entropy (R package formula) with numerical stability\\n    R_sigma = self._R * self._sigma[:, None]\\n    # Clamp to avoid log(0) or division by zero\\n    O_clamped = torch.clamp(self._O, min=1e-8)\\n    E_clamped = torch.clamp(self._E, min=1e-8)\\n    ratio = (O_clamped + E_clamped) / E_clamped\\n    theta_log = self._theta.unsqueeze(0).expand(self.K, -1) * torch.log(ratio)\\n    _cross_entropy = torch.sum(R_sigma * (theta_log @ self._Phi)).item()\\n\\n    # Store with normalization constant\\n    self.objective_kmeans.append((kmeans_error + _entropy + _cross_entropy) * norm_const)\\n    self.objective_kmeans_dist.append(kmeans_error * norm_const)\\n    self.objective_kmeans_entropy.append(_entropy * norm_const)\\n    self.objective_kmeans_cross.append(_cross_entropy * norm_const)"}, {"id": "fn::harmonize", "kind": "function", "params": [{"name": "iter_harmony", "type": "Any"}, {"name": "verbose", "type": "Any"}], "returns": {"type": "Any"}, "is_async": false, "description": "执行和谐化过程，通过多次迭代更新聚类和模型参数，直到收敛或达到最大迭代次数。", "code": "def harmonize(self, iter_harmony=10, verbose=True):\\n    converged = False\\n    for i in range(1, iter_harmony + 1):\\n        if verbose:\\n            logger.info(f\\"Iteration {i} of {iter_harmony}\\")\\n\\n        self.cluster()\\n        self.moe_correct_ridge()\\n\\n        converged = self.check_convergence(1)\\n        if converged:\\n            if verbose:\\n                logger.info(f\\"Converged after {i} iteration{\'s\' if i > 1 else \'\'}\\")\\n            break\\n\\n    if verbose and not converged:\\n        logger.info(\\"Stopped before convergence\\")"}, {"id": "fn::cluster", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "进行聚类操作，通过更新聚类中心和距离矩阵来优化模型，并检查收敛性。", "code": "def cluster(self):\\n    self._dist_mat = 2 * (1 - self._Y.T @ self._Z_cos)\\n\\n    rounds = 0\\n    for i in range(self.max_iter_kmeans):\\n        # Update Y\\n        self._Y = self._Z_cos @ self._R.T\\n        self._Y = self._Y / torch.linalg.norm(self._Y, ord=2, dim=0)\\n\\n        # Update distance matrix\\n        self._dist_mat = 2 * (1 - self._Y.T @ self._Z_cos)\\n\\n        # Update R\\n        self.update_R()\\n\\n        # Compute objective and check convergence\\n        self.compute_objective()\\n\\n        if i > self.window_size:\\n            if self.check_convergence(0):\\n                rounds = i + 1\\n                break\\n        rounds = i + 1\\n\\n    self.kmeans_rounds.append(rounds)\\n    self.objective_harmony.append(self.objective_kmeans[-1])"}, {"id": "fn::update_R", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "更新R矩阵，计算缩放距离并处理数据块，以提高计算效率和稳定性。", "code": "def update_R(self):\\n    # Compute scaled distances\\n    self._scale_dist = -self._dist_mat / self._sigma[:, None]\\n    self._scale_dist = torch.exp(self._scale_dist)\\n    self._scale_dist = self._scale_dist / self._scale_dist.sum(dim=0)\\n\\n    # Create shuffled update order\\n    update_order = torch.randperm(self.N, device=self.device)\\n\\n    # Process in blocks\\n    n_blocks = int(np.ceil(1.0 / self.block_size))\\n    cells_per_block = int(self.N * self.block_size)\\n\\n    # Permute matrices\\n    R_perm = self._R[:, update_order]\\n    scale_perm = self._scale_dist[:, update_order]\\n    Phi_perm = self._Phi[:, update_order]\\n\\n    for blk in range(n_blocks):\\n        idx_min = blk * cells_per_block\\n        idx_max = self.N if blk == n_blocks - 1 else (blk + 1) * cells_per_block\\n\\n        R_block = R_perm[:, idx_min:idx_max]\\n        scale_block = scale_perm[:, idx_min:idx_max]\\n        Phi_block = Phi_perm[:, idx_min:idx_max]\\n\\n        # Remove cells from statistics\\n        self._E -= torch.outer(R_block.sum(dim=1), self._Pr_b)\\n        self._O -= R_block @ Phi_block.T\\n\\n        # Recompute R for this block (R package formula) with numerical stability\\n        O_E_sum = self._O + self._E\\n        O_E_sum = torch.clamp(O_E_sum, min=1e-8)\\n        ratio = self._E / O_E_sum\\n        ratio = torch.clamp(ratio, min=1e-8, max=1.0)\\n        ratio_powered = harmony_pow_torch(ratio, self._theta)\\n        R_block_new = scale_block * (ratio_powered @ Phi_block)\\n        R_block_sum = R_block_new.sum(dim=0)\\n        R_block_sum = torch.clamp(R_block_sum, min=1e-8)\\n        R_block_new = R_block_new / R_block_sum\\n\\n        # Put cells back\\n        self._E += torch.outer(R_block_new.sum(dim=1), self._Pr_b)\\n        self._O += R_block_new @ Phi_block.T\\n\\n        R_perm[:, idx_min:idx_max] = R_block_new\\n\\n    # Restore original order\\n    inverse_order = torch.argsort(update_order)\\n    self._R = R_perm[:, inverse_order]"}, {"id": "fn::check_convergence", "kind": "function", "params": [{"name": "i_type", "type": "Any"}], "returns": {"type": "Any"}, "is_async": false, "description": "检查模型是否收敛，根据不同类型的收敛标准评估目标函数的变化。", "code": "def check_convergence(self, i_type):\\n    if i_type == 0:\\n        if len(self.objective_kmeans) <= self.window_size + 1:\\n            return False\\n\\n        w = self.window_size\\n        obj_old = sum(self.objective_kmeans[-w-1:-1])\\n        obj_new = sum(self.objective_kmeans[-w:])\\n        return abs(obj_old - obj_new) / abs(obj_old) < self.epsilon_kmeans\\n\\n    if i_type == 1:\\n        if len(self.objective_harmony) < 2:\\n            return False\\n\\n        obj_old = self.objective_harmony[-2]\\n        obj_new = self.objective_harmony[-1]\\n        return (obj_old - obj_new) / abs(obj_old) < self.epsilon_harmony\\n\\n    return True"}, {"id": "fn::moe_correct_ridge", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "Ridge regression correction for batch effects.", "code": "def moe_correct_ridge(self):\\n    \\"\\"\\"Ridge regression correction for batch effects.\\"\\"\\"\\n    self._Z_corr = self._Z_orig.clone()\\n\\n    for k in range(self.K):\\n        # Compute lambda if estimating\\n        if self.lambda_estimation:\\n            lamb_vec = find_lambda_torch(self.alpha, self._E[k, :], self.device)\\n        else:\\n            lamb_vec = self._lamb\\n\\n        # Phi_Rk = Phi_moe scaled by R[k,:]\\n        Phi_Rk = self._Phi_moe * self._R[k, :]\\n\\n        # Compute covariance\\n        cov_mat = Phi_Rk @ self._Phi_moe.T + torch.diag(lamb_vec)\\n\\n        # Invert\\n        inv_cov = torch.linalg.inv(cov_mat)\\n\\n        # Calculate R-scaled PCs\\n        Z_tmp = self._Z_orig * self._R[k, :]\\n\\n        # Generate betas using the batch index\\n        W = inv_cov[:, 0:1] @ Z_tmp.sum(dim=1, keepdim=True).T\\n\\n        for b in range(self.B):\\n            batch_sum = Z_tmp[:, self._batch_index[b]].sum(dim=1, keepdim=True)\\n            W = W + inv_cov[:, b+1:b+2] @ batch_sum.T\\n\\n        W[0, :] = 0  # Do not remove intercept\\n        self._Z_corr = self._Z_corr - W.T @ Phi_Rk\\n\\n    # Update Z_cos\\n    self._Z_cos = self._Z_corr / torch.linalg.norm(self._Z_corr, ord=2, dim=0)"}, {"id": "type::Harmony", "kind": "type", "base_class": "", "description": "Harmony class for batch effect correction using PyTorch.\\n\\nSupports CPU and GPU acceleration.", "fields": [{"name": "device", "type": "Any"}, {"name": "_Z_corr", "type": "Any"}, {"name": "_Z_orig", "type": "Any"}, {"name": "_Z_cos", "type": "Any"}, {"name": "_Phi", "type": "Any"}, {"name": "_Pr_b", "type": "Any"}, {"name": "N", "type": "Any"}, {"name": "B", "type": "Any"}, {"name": "d", "type": "Any"}, {"name": "_batch_index", "type": "Any"}, {"name": "_Phi_moe", "type": "Any"}, {"name": "window_size", "type": "Any"}, {"name": "epsilon_kmeans", "type": "Any"}, {"name": "epsilon_harmony", "type": "Any"}, {"name": "_lamb", "type": "Any"}, {"name": "alpha", "type": "Any"}, {"name": "lambda_estimation", "type": "Any"}, {"name": "_sigma", "type": "Any"}, {"name": "block_size", "type": "Any"}, {"name": "K", "type": "Any"}, {"name": "max_iter_harmony", "type": "Any"}, {"name": "max_iter_kmeans", "type": "Any"}, {"name": "verbose", "type": "Any"}, {"name": "_theta", "type": "Any"}, {"name": "objective_harmony", "type": "Any"}, {"name": "objective_kmeans", "type": "Any"}, {"name": "objective_kmeans_dist", "type": "Any"}, {"name": "objective_kmeans_entropy", "type": "Any"}, {"name": "objective_kmeans_cross", "type": "Any"}, {"name": "kmeans_rounds", "type": "Any"}], "constants": [], "overloads": [{"fn": "fn::Z_corr", "method": "Z_corr"}, {"fn": "fn::Z_orig", "method": "Z_orig"}, {"fn": "fn::Z_cos", "method": "Z_cos"}, {"fn": "fn::R", "method": "R"}, {"fn": "fn::Y", "method": "Y"}, {"fn": "fn::O", "method": "O"}, {"fn": "fn::E", "method": "E"}, {"fn": "fn::Phi", "method": "Phi"}, {"fn": "fn::Phi_moe", "method": "Phi_moe"}, {"fn": "fn::Pr_b", "method": "Pr_b"}, {"fn": "fn::theta", "method": "theta"}, {"fn": "fn::sigma", "method": "sigma"}, {"fn": "fn::lamb", "method": "lamb"}, {"fn": "fn::result", "method": "result"}, {"fn": "fn::allocate_buffers", "method": "allocate_buffers"}, {"fn": "fn::init_cluster", "method": "init_cluster"}, {"fn": "fn::compute_objective", "method": "compute_objective"}, {"fn": "fn::harmonize", "method": "harmonize"}, {"fn": "fn::cluster", "method": "cluster"}, {"fn": "fn::update_R", "method": "update_R"}, {"fn": "fn::check_convergence", "method": "check_convergence"}, {"fn": "fn::moe_correct_ridge", "method": "moe_correct_ridge"}], "init_fn": "fn::__init__"}, {"id": "fn::safe_entropy_torch", "kind": "function", "params": [{"name": "x", "type": "Any"}], "returns": {"type": "Any"}, "is_async": false, "description": "Compute x * log(x), returning 0 where x is 0 or negative.", "code": "def safe_entropy_torch(x):\\n    \\"\\"\\"Compute x * log(x), returning 0 where x is 0 or negative.\\"\\"\\"\\n    result = x * torch.log(x)\\n    result = torch.where(torch.isfinite(result), result, torch.zeros_like(result))\\n    return result"}, {"id": "fn::harmony_pow_torch", "kind": "function", "params": [{"name": "A", "type": "Any"}, {"name": "T", "type": "Any"}], "returns": {"type": "Any"}, "is_async": false, "description": "Element-wise power with different exponents per column.", "code": "def harmony_pow_torch(A, T):\\n    \\"\\"\\"Element-wise power with different exponents per column.\\"\\"\\"\\n    result = torch.empty_like(A)\\n    for c in range(A.shape[1]):\\n        result[:, c] = torch.pow(A[:, c], T[c])\\n    return result"}, {"id": "fn::find_lambda_torch", "kind": "function", "params": [{"name": "alpha", "type": "Any"}, {"name": "cluster_E", "type": "Any"}, {"name": "device", "type": "Any"}], "returns": {"type": "Any"}, "is_async": false, "description": "Compute dynamic lambda based on cluster expected counts.", "code": "def find_lambda_torch(alpha, cluster_E, device):\\n    \\"\\"\\"Compute dynamic lambda based on cluster expected counts.\\"\\"\\"\\n    lamb = torch.zeros(len(cluster_E) + 1, dtype=torch.float32, device=device)\\n    lamb[1:] = cluster_E * alpha\\n    return lamb"}, {"id": "fn::compute_lisi", "kind": "function", "params": [{"name": "X", "type": "np.array"}, {"name": "metadata", "type": "pd.DataFrame"}, {"name": "label_colnames", "type": "Iterable[str]"}, {"name": "perplexity", "type": "float"}], "returns": {"type": "Any"}, "is_async": false, "description": "Compute the Local Inverse Simpson Index (LISI) for each column in metadata.\\n\\nLISI is a statistic computed for each item (row) in the data matrix X.\\n\\nThe following example may help to interpret the LISI values.\\n\\nSuppose one of the columns in metadata is a categorical variable with 3 categories.\\n\\n    - If LISI is approximately equal to 3 for an item in the data matrix,\\n      that means that the item is surrounded by neighbors from all 3\\n      categories.\\n\\n    - If LISI is approximately equal to 1, then the item is surrounded by\\n      neighbors from 1 category.\\n\\nThe LISI statistic is useful to evaluate whether multiple datasets are\\nwell-integrated by algorithms such as Harmony [1].\\n\\n[1]: Korsunsky et al. 2019 doi: 10.1038/s41592-019-0619-0", "code": "def compute_lisi(\\n    X: np.array,\\n    metadata: pd.DataFrame,\\n    label_colnames: Iterable[str],\\n    perplexity: float=30\\n):\\n    \\"\\"\\"Compute the Local Inverse Simpson Index (LISI) for each column in metadata.\\n\\n    LISI is a statistic computed for each item (row) in the data matrix X.\\n\\n    The following example may help to interpret the LISI values.\\n\\n    Suppose one of the columns in metadata is a categorical variable with 3 categories.\\n\\n        - If LISI is approximately equal to 3 for an item in the data matrix,\\n          that means that the item is surrounded by neighbors from all 3\\n          categories.\\n\\n        - If LISI is approximately equal to 1, then the item is surrounded by\\n          neighbors from 1 category.\\n\\n    The LISI statistic is useful to evaluate whether multiple datasets are\\n    well-integrated by algorithms such as Harmony [1].\\n\\n    [1]: Korsunsky et al. 2019 doi: 10.1038/s41592-019-0619-0\\n    \\"\\"\\"\\n    n_cells = metadata.shape[0]\\n    n_labels = len(label_colnames)\\n    # We need at least 3 * n_neigbhors to compute the perplexity\\n    knn = NearestNeighbors(n_neighbors = perplexity * 3, algorithm = \'kd_tree\').fit(X)\\n    distances, indices = knn.kneighbors(X)\\n    # Don\'t count yourself\\n    indices = indices[:,1:]\\n    distances = distances[:,1:]\\n    # Save the result\\n    lisi_df = np.zeros((n_cells, n_labels))\\n    for i, label in enumerate(label_colnames):\\n        labels = pd.Categorical(metadata[label])\\n        n_categories = len(labels.categories)\\n        simpson = compute_simpson(distances.T, indices.T, labels, n_categories, perplexity)\\n        lisi_df[:,i] = 1 / simpson\\n    return lisi_df"}, {"id": "fn::compute_simpson", "kind": "function", "params": [{"name": "distances", "type": "np.ndarray"}, {"name": "indices", "type": "np.ndarray"}, {"name": "labels", "type": "pd.Categorical"}, {"name": "n_categories", "type": "int"}, {"name": "perplexity", "type": "float"}, {"name": "tol", "type": "float"}], "returns": {"type": "Any"}, "is_async": false, "description": "计算Simpson指数，评估不同类别之间的相似性，使用给定的距离和标签信息进行归一化处理。", "code": "def compute_simpson(\\n    distances: np.ndarray,\\n    indices: np.ndarray,\\n    labels: pd.Categorical,\\n    n_categories: int,\\n    perplexity: float,\\n    tol: float=1e-5\\n):\\n    n = distances.shape[1]\\n    P = np.zeros(distances.shape[0])\\n    simpson = np.zeros(n)\\n    logU = np.log(perplexity)\\n    # Loop through each cell.\\n    for i in range(n):\\n        beta = 1\\n        betamin = -np.inf\\n        betamax = np.inf\\n        # Compute Hdiff\\n        P = np.exp(-distances[:,i] * beta)\\n        P_sum = np.sum(P)\\n        if P_sum == 0:\\n            H = 0\\n            P = np.zeros(distances.shape[0])\\n        else:\\n            H = np.log(P_sum) + beta * np.sum(distances[:,i] * P) / P_sum\\n            P = P / P_sum\\n        Hdiff = H - logU\\n        n_tries = 50\\n        for t in range(n_tries):\\n            # Stop when we reach the tolerance\\n            if abs(Hdiff) < tol:\\n                break\\n            # Update beta\\n            if Hdiff > 0:\\n                betamin = beta\\n                if not np.isfinite(betamax):\\n                    beta *= 2\\n                else:\\n                    beta = (beta + betamax) / 2\\n            else:\\n                betamax = beta\\n                if not np.isfinite(betamin):\\n                    beta /= 2\\n                else:\\n                    beta = (beta + betamin) / 2\\n            # Compute Hdiff\\n            P = np.exp(-distances[:,i] * beta)\\n            P_sum = np.sum(P)\\n            if P_sum == 0:\\n                H = 0\\n                P = np.zeros(distances.shape[0])\\n            else:\\n                H = np.log(P_sum) + beta * np.sum(distances[:,i] * P) / P_sum\\n                P = P / P_sum\\n            Hdiff = H - logU\\n        # distancesefault value\\n        if H == 0:\\n            simpson[i] = -1\\n        # Simpson\'s index\\n        for label_category in labels.categories:\\n            ix = indices[:,i]\\n            q = labels[ix] == label_category\\n            if np.any(q):\\n                P_sum = np.sum(P[q])\\n                simpson[i] += P_sum * P_sum\\n    return simpson"}, {"id": "fn::test_run_harmony_small", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "测试小规模和谐化运行，验证数据处理的正确性和一致性。", "code": "def test_run_harmony_small():\\n    run_harmony(\\n        meta_tsv=\\"data/pbmc_3500_meta.tsv.gz\\",\\n        pcs_tsv=\\"data/pbmc_3500_pcs.tsv.gz\\",\\n        harmonized_tsv=\\"data/pbmc_3500_pcs_harmonized.tsv.gz\\",\\n        batch_var=\\"donor\\"\\n    )"}, {"id": "fn::test_random_seed", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "测试随机种子的影响，确保在相同种子下结果一致，并验证不同种子下结果的差异性。", "code": "def test_random_seed():\\n    print(\\"\\\\n\\" + \\"=\\" * 60)\\n    print(\\"TEST: test_random_seed\\")\\n    print(\\"=\\" * 60)\\n\\n    meta_data = pd.read_csv(\\"data/pbmc_3500_meta.tsv.gz\\", sep=\\"\\\\t\\")\\n    data_mat = pd.read_csv(\\"data/pbmc_3500_pcs.tsv.gz\\", sep=\\"\\\\t\\")\\n\\n    def run(random_state):\\n        ho = hm.run_harmony(data_mat,\\n                            meta_data, [\'donor\'],\\n                            max_iter_harmony=2,\\n                            max_iter_kmeans=2,\\n                            verbose=False,\\n                            random_state=random_state)\\n        return ho.Z_corr\\n\\n    # Assert same results when random_state is set.\\n    # Note: MPS (Apple Silicon) has slight non-determinism, so we use relaxed tolerance\\n    print(\\"\\\\n--- Testing reproducibility with random_state=42 ---\\")\\n    result1 = run(42)\\n    result2 = run(42)\\n    diff_same_seed = np.abs(result1 - result2).sum()\\n    print(f\\"Difference between two runs with same seed: {diff_same_seed:.6f}\\")\\n    np.testing.assert_allclose(result1, result2, rtol=1e-3, atol=1e-4)\\n    print(\\"✓ Same seed produces similar results (PASSED)\\")\\n\\n    # Assert different values when random_state is different\\n    print(\\"\\\\n--- Testing variability with different seeds ---\\")\\n    result3 = run(123)\\n    result4 = run(456)\\n    diff_diff_seed = np.abs(result3 - result4).sum()\\n    print(f\\"Difference between runs with different seeds: {diff_diff_seed:.2f}\\")\\n    assert diff_diff_seed > 1000, f\\"Expected diff > 1000, got {diff_diff_seed}\\"\\n    print(\\"✓ Different seeds produce different results (PASSED)\\")"}, {"id": "fn::run_harmony_2", "kind": "function", "params": [{"name": "meta_tsv", "type": "Any"}, {"name": "pcs_tsv", "type": "Any"}, {"name": "harmonized_tsv", "type": "Any"}, {"name": "batch_var", "type": "Any"}], "returns": {"type": "Any"}, "is_async": false, "description": "run_harmony(meta_tsv, pcs_tsv, harmonized_tsv, batch_var) -> Any", "code": "def run_harmony(meta_tsv, pcs_tsv, harmonized_tsv, batch_var):\\n    print(\\"\\\\n\\" + \\"=\\" * 60)\\n    print(\\"TEST: test_run_harmony (PyTorch)\\")\\n    print(\\"=\\" * 60)\\n\\n    if not os.path.exists(meta_tsv):\\n        return 0\\n\\n    # Load input data\\n    meta_data = pd.read_csv(meta_tsv, sep=\\"\\\\t\\", low_memory=False)\\n    data_mat = pd.read_csv(pcs_tsv, sep=\\"\\\\t\\", low_memory=False)\\n\\n    if data_mat.iloc[:,0].dtype == \'object\':\\n        data_mat = data_mat.iloc[:, 1:]\\n\\n    print(\\"\\\\n--- Input Data ---\\")\\n    print(f\\"data_mat shape: {data_mat.shape} (cells × PCs)\\")\\n    print(f\\"meta_data shape: {meta_data.shape}\\")\\n    print(f\\"meta_data columns: {list(meta_data.columns)[:10]}...\\")\\n    print(f\\"Batch variable \'{batch_var}\' unique values: {meta_data[batch_var].unique()}\\")\\n    print(f\\"Cells per {batch_var}:\\\\n{meta_data[batch_var].value_counts()}\\")\\n\\n    print(\\"\\\\n--- Running Harmony (PyTorch) ---\\")\\n    start = time()\\n    ho = hm.run_harmony(data_mat, meta_data, [batch_var])\\n    end = time()\\n    print(f\\"\\\\n✓ Harmony completed in {end - start:.2f} seconds\\")\\n\\n    print(\\"\\\\n--- Harmony Object Info ---\\")\\n    print(f\\"Number of clusters (K): {ho.K}\\")\\n    print(f\\"Number of harmony iterations: {len(ho.objective_harmony)}\\")\\n    print(f\\"K-means rounds per iteration: {ho.kmeans_rounds}\\")\\n    print(f\\"Z_corr shape: {ho.Z_corr.shape} (cells × PCs)\\")\\n    print(f\\"Z_orig shape: {ho.Z_orig.shape}\\")\\n\\n    # Check convergence\\n    print(\\"\\\\n--- Convergence ---\\")\\n    print(f\\"Objective (harmony) history: {[f\'{x:.2f}\' for x in ho.objective_harmony]}\\")\\n\\n    # Z_corr is now cells × PCs (same as input)\\n    res = pd.DataFrame(ho.Z_corr)\\n    res.columns = [\'PC{}\'.format(i + 1) for i in range(res.shape[1])]\\n\\n    # Compare to expected results from R\\n    harm = pd.read_csv(harmonized_tsv, sep=\\"\\\\t\\")\\n    if harm.iloc[:,0].dtype == \'object\':\\n        harm = harm.iloc[:, 1:]\\n    print(\\"\\\\n--- Comparison with R Results ---\\")\\n    print(f\\"Expected result shape: {harm.shape}\\")\\n\\n    cors = []\\n    for i in range(res.shape[1]):\\n        cors.append(pearsonr(res.iloc[:, i].values, harm.iloc[:, i].values))\\n\\n    cors_values = [x[0] for x in cors]\\n    print(f\\"Correlations (Python vs R) per PC: {[f\'{x:.3f}\' for x in cors_values]}\\")\\n    print(f\\"Min correlation: {min(cors_values):.3f}\\")\\n    print(f\\"Mean correlation: {np.mean(cors_values):.3f}\\")\\n\\n    # Correlation between test PCs and observed PCs is high\\n    assert np.all(np.array(cors_values) >= 0.9), f\\"Some correlations < 0.9: {cors_values}\\"\\n    print(\\"✓ All correlations >= 0.9 (PASSED)\\")\\n\\n    return end - start"}, {"id": "fn::download_data", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "下载所需的数据文件，如果数据目录不存在则创建，并确保所有文件都被下载。", "code": "def download_data():\\n    if not os.path.exists(\\"data\\"):\\n        os.makedirs(\\"data\\")\\n    remote_url = \\"https://immunogenomics.io/downloads\\"\\n    files = [\\n        \\"acute_myeloid_obs.tsv.gz\\",\\n        \\"acute_myeloid_pcs.tsv.gz\\",\\n        \\"acute_myeloid_pcs_harmonized.tsv.gz\\",\\n    ]\\n    for file in files:\\n        if not os.path.exists(f\\"data/{file}\\"):\\n            import wget\\n            print(f\\"Downloading {file}\\")\\n            wget.download(f\\"{remote_url}/{file}\\", f\\"data/{file}\\")"}, {"id": "fn::test_lisi", "kind": "function", "params": [], "returns": {"type": "Any"}, "is_async": false, "description": "测试LISI计算的正确性，通过比较计算结果与预期结果来验证实现的准确性。", "code": "def test_lisi():\\n\\n    X = pd.read_csv(\\"data/lisi_x.tsv.gz\\", sep = \\"\\\\t\\")\\n    metadata = pd.read_csv(\\"data/lisi_metadata.tsv.gz\\", sep = \\"\\\\t\\")\\n    label_colnames = metadata.columns\\n    perplexity = 30\\n\\n    lisi = hm.compute_lisi(X, metadata, label_colnames, perplexity)\\n\\n    lisi_test = pd.read_csv(\\"data/lisi_lisi.tsv.gz\\", sep=\\"\\\\t\\")\\n    lisi_test = lisi_test.iloc[:,-2:].to_numpy()\\n\\n    assert np.allclose(lisi, lisi_test)"}, {"kind": "data_files", "description": "项目中可用的数据文件，main 函数应优先加载这些文件而非生成合成数据", "files": [{"path": "data/ircolitis_blood_cd8_obs.tsv.gz", "size_mb": 21.11, "ext": ".gz"}, {"path": "data/ircolitis_blood_cd8_pcs.tsv.gz", "size_mb": 28.15, "ext": ".gz"}, {"path": "data/ircolitis_blood_cd8_pcs_harmonized.tsv.gz", "size_mb": 28.16, "ext": ".gz"}, {"path": "data/lisi_lisi.tsv.gz", "size_mb": 0.01, "ext": ".gz"}, {"path": "data/lisi_metadata.tsv.gz", "size_mb": 0.0, "ext": ".gz"}, {"path": "data/lisi_x.tsv.gz", "size_mb": 0.01, "ext": ".gz"}, {"path": "data/pbmc_3500_meta.tsv.gz", "size_mb": 0.01, "ext": ".gz"}, {"path": "data/pbmc_3500_pcs.tsv.gz", "size_mb": 0.91, "ext": ".gz"}, {"path": "data/pbmc_3500_pcs_harmonized.tsv.gz", "size_mb": 0.91, "ext": ".gz"}]}]\n\n## 已生成的 patches（patches_so_far）\n[{"op": "add_file", "target_id": "file::harmonypy/metrics", "target_file": "", "depends_on": [], "data": {"description": "Module harmonypy.metrics: implementations of evaluation metrics and measurement utilities for Harmony outputs. This file will provide: (1) compute_kbet(Z, batch_labels, k) implementing kBET (k-nearest-neighbor batch-effect test) following the project API; (2) compute_asw_batch(Z, batch_labels) computing Average Silhouette Width per-batch (ASW_batch); (3) helper wrappers to compute runtime and peak-memory for a callable (measure_runtime(func, *args, **kwargs) and measure_peak_memory(func, *args, **kwargs)) using time and a lightweight peak-memory measurement; (4) compute_rare_population_preservation_score(Z_orig, Z_corr, labels) that quantifies preservation of rare cell populations after correction; (5) compute_all_metrics(...) high-level function that runs LISI (delegating to harmonypy.lisi.compute_lisi), kBET, ASW_batch, runtime and peak-memory measurements, and rare-population score and returns a dict with exact keys: \\"LISI\\", \\"kBET\\", \\"ASW_batch\\", \\"Runtime\\", \\"Peak Memory\\", \\"Rare Population Preservation Score\\". The implementations will accept NumPy arrays for embeddings and 1D arrays/Series for labels, use sklearn/neighbors for NN operations, and document assumptions (e.g. k choice for kBET). Functions follow the project\'s metric function signatures to enable integration and testing.", "path": "harmonypy/metrics.py", "module_id": "mod::harmonypy", "is_async": null, "calls": null, "params": null, "returns": null}}, {"op": "add_fn", "target_id": "fn::harmonypy/metrics::compute_kbet", "target_file": "file::harmonypy/metrics", "depends_on": [0], "data": {"description": "Compute the kBET (k-nearest-neighbor Batch Effect Test) statistic for an embedding Z given batch labels. For each cell, the function finds the k nearest neighbors in embedding space (using sklearn NearestNeighbors), counts the batch composition in that neighborhood and compares it to the global batch proportions using a chi-square goodness-of-fit test (degrees of freedom = n_batches - 1). Neighborhoods where the null hypothesis (neighborhood follows global batch proportions) is rejected at alpha=0.05 are counted as rejections. The function returns the kBET rejection rate: fraction of neighborhoods rejected (value in [0,1]; higher indicates stronger remaining batch effect). The implementation documents recommended k choices (e.g. between ~1% and 5% of total cells) and handles edge cases: if a neighborhood has too-small expected counts for a chi-square approximation, the neighborhood is skipped and not counted in the denominator; if all neighborhoods are skipped the function returns NaN. Input assumptions: Z is (n_cells × n_features) numpy array; batch_labels is 1D array-like with categorical labels (will be converted to integer categories). The function is pure-NumPy/Scikit-learn and returns a single float rejection rate.", "path": null, "module_id": null, "is_async": false, "calls": [], "params": [{"name": "Z", "type": "np.ndarray"}, {"name": "batch_labels", "type": "np.ndarray"}, {"name": "k", "type": "int"}], "returns": {"type": "float"}}}, {"op": "add_fn", "target_id": "fn::harmonypy/metrics::compute_asw_batch", "target_file": "file::harmonypy/metrics", "depends_on": [0], "data": {"description": "Compute Average Silhouette Width using batch labels (ASW_batch) on an embedding to assess batch mixing. Given an embedding Z (n_cells × n_features) and a 1D array of batch_labels, this function treats batch_labels as cluster assignments and computes the silhouette width for each cell (using Euclidean distance) then returns the mean silhouette width across all cells. A value near +1 indicates cells are closer to cells of the same batch (poor mixing), near 0 indicates good mixing, and negative values indicate cells are closer to other batches. The implementation handles edge cases: if there is only one unique batch label, returns NaN; if any batch has a single member (which sklearn.silhouette_samples cannot handle) a safe fallback computes per-sample intra- and inter-batch mean distances using pairwise distances to produce silhouette-like scores. The function documents assumptions on input shapes and types and returns a single float (mean ASW_batch).", "path": null, "module_id": null, "is_async": false, "calls": [], "params": [{"name": "Z", "type": "np.ndarray"}, {"name": "batch_labels", "type": "np.ndarray"}], "returns": {"type": "float"}}}, {"op": "add_fn", "target_id": "fn::harmonypy/metrics::measure_runtime_and_peak_memory", "target_file": "file::harmonypy/metrics", "depends_on": [0], "data": {"description": "Run a provided callable and measure wall-clock runtime and peak memory usage. The function will: (1) measure wall-clock runtime using time.perf_counter for high-resolution timing; (2) attempt to measure peak Python memory allocations using tracemalloc (if available) by starting tracing before the call and reading peak traced memory after the call; (3) if tracemalloc is not available or not suitable, fall back to psutil to sample process RSS before and after execution and return the maximum observed RSS change as an approximate peak memory (in MB). The callable is executed once with the provided args/kwargs. The returned dict contains keys \'runtime_seconds\' (float) and \'peak_memory_mb\' (float). The function documents limitations: tracemalloc reports only Python memory allocations, not native extensions; psutil RSS includes total memory but may miss short-lived peaks unless polled; for robust peak measurement users should run in an environment with tracemalloc available or external profilers.", "path": null, "module_id": null, "is_async": false, "calls": [], "params": [{"name": "func", "type": "Callable"}, {"name": "args", "type": "tuple"}, {"name": "kwargs", "type": "dict"}, {"name": "use_tracemalloc_first", "type": "bool"}], "returns": {"type": "dict"}}}, {"op": "add_fn", "target_id": "fn::harmonypy/metrics::compute_rare_population_preservation", "target_file": "file::harmonypy/metrics", "depends_on": [0], "data": {"description": "Compute a Rare Population Preservation Score that quantifies how well rare label(s) (e.g. rare cell types) maintain their local neighborhood composition after batch-correction. The function accepts either an explicit list of rare_labels or will automatically detect rare labels whose global frequency is below rare_fraction. For each cell belonging to each rare label, it finds k nearest neighbors in the original embedding (Z_orig) and in the corrected embedding (Z_corr) using Euclidean distance, computes the Jaccard overlap between the two neighbor sets (optionally restricting neighbors to the same rare label), and averages those overlaps across rare cells and rare labels to produce a score in [0,1] (1 = perfect preservation). The function documents choices and edge-case handling: if no rare labels are identified it returns NaN; if k is larger than available cells it will use min(k, n_cells-1); small-sample situations are handled gracefully. This metric complements global mixing metrics by focusing on preservation of rare populations after correction.", "path": null, "module_id": null, "is_async": false, "calls": [], "params": [{"name": "Z_orig", "type": "np.ndarray"}, {"name": "Z_corr", "type": "np.ndarray"}, {"name": "labels", "type": "np.ndarray"}, {"name": "rare_labels", "type": "Iterable"}, {"name": "rare_fraction", "type": "float"}, {"name": "k", "type": "int"}, {"name": "restrict_to_same_label", "type": "bool"}], "returns": {"type": "float"}}}, {"op": "modify_fn", "target_id": "file::harmonypy/__init__", "target_file": "", "depends_on": [0, 1, 2, 3, 4, 5], "data": {"description": "Update harmonypy/__init__.py to import and re-export the new metric functions implemented in harmonypy.metrics so they are available as harmonypy.compute_kbet, harmonypy.compute_asw_batch, harmonypy.measure_runtim
2026-03-14 14:41:54  DEBUG     [b7c14b12]  [u2e_pipeline → arch_to_project → fn_codegen → ? → codegen]  llm_config      LLM 输出(structured)  agent=arch_codegen  raw_content:
{"body":"    batch_labels = np.asarray(batch_labels).ravel()\n    n_samples = Z.shape[0]\n    uniq, counts = np.unique(batch_labels, return_counts=True)\n    if uniq.size <= 1:\n        return float(np.nan)\n    if np.all(counts >= 2):\n        scores = silhouette_samples(Z, batch_labels, metric='euclidean')\n        return float(np.mean(scores))\n    D = pairwise_distances(Z, metric='euclidean')\n    label_to_idx = {lab: np.where(batch_labels == lab)[0] for lab in uniq}\n    scores = np.zeros(n_samples, dtype=float)\n    for i in range(n_samples):\n        lab = batch_labels[i]\n        same_idx = label_to_idx[lab]\n        same_idx = same_idx[same_idx != i]\n        if same_idx.size > 0:\n            a = float(np.mean(D[i, same_idx]))\n        else:\n            a = 0.0\n        b_vals = []\n        for olab, idx in label_to_idx.items():\n            if olab == lab:\n                continue\n            b_vals.append(float(np.mean(D[i, idx])))\n        b = float(np.min(b_vals))\n        denom = max(a, b)\n        if denom > 0:\n            scores[i] = (b - a) / denom\n        else:\n            scores[i] = 0.0\n    return float(np.mean(scores))","imports":["import numpy as np","from sklearn.metrics import silhouette_samples, pairwise_distances"]}

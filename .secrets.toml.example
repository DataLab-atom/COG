# .secrets.toml.example — 复制为 .secrets.toml 并填入真实密钥
# .secrets.toml 已被 .gitignore 忽略，不会提交到 git
#
# 使用方式：
#   cp .secrets.toml.example .secrets.toml
#   然后编辑 .secrets.toml 填入真实值
#
# 配置后前端表单中对应字段可留空，系统会自动从此文件读取

[default]
# OpenAI / OpenRouter API Key（LLM 调用必需）
OPENAI_API_KEY = "sk-..."

# PDF 解析 Token（MineRU，pdf_transform_mode=api 时必需）
PDF_MD_TOKEN = ""

# 嵌入/重排模型 API Key（embedding_model_source=api 时必需）
EMBEDDING_API_KEY = ""

# Semantic Scholar API Key（扩展参考文献时建议配置）
S2_API_KEY = ""

# Unpaywall Email（下载论文 PDF 时建议配置）
UNPAYWALL_EMAIL = ""

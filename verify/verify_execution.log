s_tokenizer_and_vocab()\n│   │   ├── [Func] tokenize_and_map_smiles_sequences()\n│   │   └── [Func] pad_truncate_sequences_and_generate_attention_mask()\n│   └── stratified_split_train_val_test.py\n│       ├── [Class] StratifiedSplitIndices\n│       │   └── __init__()\n│       └── [Func] stratified_split_train_val_test()\n├── imbalance_strategy_design/\n│   ├── compute_class_priors_effective_numbers.py\n│   │   ├── [Class] ClassImbalanceStats\n│   │   │   ├── __init__()\n│   │   │   └── __repr__()\n│   │   └── [Func] compute_class_priors_effective_numbers()\n│   ├── implement_class_balanced_focal_loss.py\n│   │   ├── [Class] ClassBalancedFocalLoss\n│   │   │   ├── __init__()\n│   │   │   └── forward()\n│   │   └── [Func] implement_class_balanced_focal_loss()\n│   └── inference_logit_adjustment.py\n│       ├── [Class] LogitAdjustment\n│       │   ├── __init__()\n│       │   └── adjust()\n│       └── [Func] inference_logit_adjustment()\n├── sequence_encoder_architecture/\n│   ├── masked_mean_pooling_and_classifier_head.py\n│   │   ├── [Class] MaskedMeanPoolingClassifier\n│   │   │   ├── __init__()\n│   │   │   └── forward()\n│   │   └── [Func] masked_mean_pooling_and_classifier_head()\n│   ├── pre_layernorm_transformer_encoder.py\n│   │   ├── [Class] MultiheadSelfAttentionWithMask\n│   │   │   ├── __init__()\n│   │   │   └── forward()\n│   │   ├── [Class] MultiheadSelfAttentionWithMask\n│   │   │   ├── __init__()\n│   │   │   └── forward()\n│   │   ├── [Class] FeedForwardPreLayerNorm\n│   │   │   ├── __init__()\n│   │   │   └── forward()\n│   │   ├── [Class] TransformerEncoderLayer\n│   │   │   ├── __init__()\n│   │   │   └── forward()\n│   │   ├── [Class] TransformerEncoderStack\n│   │   │   ├── __init__()\n│   │   │   └── forward()\n│   │   ├── [Func] multihead_attention_with_padding_mask()\n│   │   └── [Func] encoder_layer_stacking_and_residuals()\n│   └── smiles_embedding_and_positional_encoding.py\n│       ├── [Class] SmilesTokenEmbedding\n│       │   ├── __init__()\n│       │   └── forward()\n│       ├── [Class] EmbeddingTokenDropoutLayerNorm\n│       │   ├── __init__()\n│       │   └── forward()\n│       ├── [Class] SinusoidalPositionalEncoding\n│       │   ├── __init__()\n│       │   └── add()\n│       ├── [Func] smiles_token_embedding_layer()\n│       ├── [Func] embedding_token_dropout_and_layernorm()\n│       └── [Func] sinusoidal_positional_encoding_addition()\n└── training_evaluation_pipeline/\n    ├── final_testset_evaluation_reporting.py\n    │   ├── [Class] TestSetEvaluationReport\n    │   │   ├── __init__()\n    │   │   └── __repr__()\n    │   └── [Func] final_testset_evaluation_reporting()\n    ├── setup_optim_scheduler_amp.py\n    │   ├── [Class] TrainingSetup\n    │   │   └── __init__()\n    │   └── [Func] setup_optim_scheduler_amp()\n    └── train_loop_with_early_stopping.py\n        ├── [Class] ValidationMetrics\n        │   ├── __init__()\n        │   └── __repr__()\n        ├── [Func] epoch_train_pass()\n        └── [Func] epoch_validation_pass()\n\n\n【main.py】\nimport sys\nimport os\nimport time\nfrom typing import Dict\nimport numpy as np\nimport torch\n\n# Ensure project root is in path\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.abspath(os.path.join(current_dir, ".."))\nif project_root not in sys.path:\n    sys.path.append(project_root)\n\n"""\nMain executable for the Zinc-Fluor molecular classification pipeline.\n\nRefactored into a function-based structure.\n"""\n\n# Data preparation modules\nfrom data_preparation_zinc_fluor.load_and_analyze_csv import load_zinc_fluor_csv_data\nfrom data_preparation_zinc_fluor.label_encoding_and_mapping import label_encoding_and_mapping\nfrom data_preparation_zinc_fluor.stratified_split_train_val_test import stratified_split_train_val_test\nfrom data_preparation_zinc_fluor.smiles_tokenization_and_sequence_processing import (\n    construct_smiles_tokenizer_and_vocab,\n    tokenize_and_map_smiles_sequences,\n    pad_truncate_sequences_and_generate_attention_mask,\n)\nfrom data_preparation_zinc_fluor.create_dataloader_and_attention_mask import create_dataloader_and_attention_mask\nfrom data_preparation_zinc_fluor.global_deterministic_setup import global_deterministic_setup\n\n# Imbalance strategy modules\nfrom imbalance_strategy_design.compute_class_priors_effective_numbers import compute_class_priors_effective_numbers\nfrom imbalance_strategy_design.implement_class_balanced_focal_loss import implement_class_balanced_focal_loss\nfrom imbalance_strategy_design.inference_logit_adjustment import inference_logit_adjustment\n\n# Sequence encoder architecture modules\nfrom sequence_encoder_architecture.smiles_embedding_and_positional_encoding import (\n    smiles_token_embedding_layer,\n    embedding_token_dropout_and_layernorm,\n    sinusoidal_positional_encoding_addition,\n)\nfrom sequence_encoder_architecture.pre_layernorm_transformer_encoder import encoder_layer_stacking_and_residuals\nfrom sequence_encoder_architecture.masked_mean_pooling_and_classifier_head import masked_mean_pooling_and_classifier_head\n\n# Training / evaluation modules\nfrom training_evaluation_pipeline.setup_optim_scheduler_amp import setup_optim_scheduler_amp\nfrom training_evaluation_pipeline.train_loop_with_early_stopping import epoch_train_pass, epoch_validation_pass\nfrom training_evaluation_pipeline.final_testset_evaluation_reporting import final_testset_evaluation_reporting\n\n\ndef build_model(\n    vocab_size: int,\n    embedding_dim: int,\n    num_classes: int,\n    pad_idx: int,\n    unk_idx: int,\n    token_dropout_p: float = 0.02,\n    dropout: float = 0.1,\n) -> torch.nn.Module:\n    """\n    Builds a model composed of embedding -> token dropout+ln -> sinusoidal pos enc ->\n    transformer encoder stack -> masked mean pooling classifier.\n    """\n\n    emb_layer = smiles_token_embedding_layer(vocab_size=vocab_size, embedding_dim=embedding_dim, pad_idx=pad_idx, unk_idx=unk_idx)\n    tok_dropout_ln = embedding_token_dropout_and_layernorm(embedding_dim=embedding_dim, dropout_p=token_dropout_p, eps=1e-5)\n    pos_enc = sinusoidal_positional_encoding_addition(max_length=60, embedding_dim=embedding_dim)\n    encoder_stack = encoder_layer_stacking_and_residuals(num_layers=4, embedding_dim=embedding_dim, num_heads=6, ff_hidden_dim=768, dropout=dropout, eps=1e-5)\n    classifier_head = masked_mean_pooling_and_classifier_head(embedding_dim=embedding_dim, num_classes=num_classes)\n\n    class FullModel(torch.nn.Module):\n        def __init__(self, emb, tdln, pos, enc, clf):\n            super().__init__()\n            self.emb = emb\n            self.tdln = tdln\n            self.pos = pos\n            self.enc = enc\n            self.clf = clf\n\n        def forward(self, tokens: torch.Tensor, pad_mask: torch.Tensor) -> torch.Tensor:\n            x = self.emb(tokens)            # [B, L, D]\n            x = self.tdln(x)                # token-level dropout + layernorm (noop in eval)\n            x = self.pos.add(x)             # add positional encodings\n            x = self.enc(x, pad_mask)       # transformer encoder stack\n            logits = self.clf(x, pad_mask)  # classifier head -> [B, num_classes]\n            return logits\n\n    return FullModel(emb_layer, tok_dropout_ln, pos_enc, encoder_stack, classifier_head)\n\n\ndef save_checkpoint(model: torch.nn.Module, path: str):\n    torch.save(model.state_dict(), path)\n\n\ndef load_checkpoint_to_model(model: torch.nn.Module, path: str):\n    state = torch.load(path, map_location="cpu")\n    model.load_state_dict(state)\n\n\ndef run_pipeline() -> float:\n    """\n    Executes the full training and evaluation pipeline.\n    \n    Returns:\n        float: The macro accuracy on the test set.\n    """\n    # Setup deterministic config\n    det_config = global_deterministic_setup(seed=42)\n\n    # Dataset path (full dataset)\n    csv_path = (\n        r"C:\\Users\\17640\\Desktop\\HMACF_PRO_MAX\\problems\\classfiy\\dataset_simles\\fluor_colour_subset_with_color_value.csv"\n    )\n\n    # Hyperparameters\n    embedding_dim = 192\n    batch_size = 128\n    # Important: set num_workers=0 to avoid multiprocessing pickling issues with local worker_init functions\n    num_workers = 0\n    epochs = 10\n    weight_decay = 0.01\n    lr = 2e-4\n    warmup_epochs = 4\n    patience = 8\n    save_path = "best_checkpoint.pt"\n\n    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")\n    print(f"[INFO] Device: {device}")\n\n    # 1) Load dataset\n    print("[STEP] Loading dataset...")\n    zinc_data = load_zinc_fluor_csv_data(csv_path)\n    print(f"[INFO] Loaded dataset with shape: {zinc_data.df.shape}")\n\n    # 2) Encode labels\n    print("[STEP] Encoding labels...")\n    encoded_labels = label_encoding_and_mapping(zinc_data)\n    num_classes = len(encoded_labels.label_map)\n    print(f"[INFO] Number of classes: {num_classes}")\n\n    # 3) Stratified split\n    print("[STEP] Creating stratified splits...")\n    split_indices = stratified_split_train_val_test(zinc_data, encoded_labels, seed=det_config.seed)\n    print(f"[INFO] Train/Val/Test sizes: {len(split_indices.indices[\'train\'])}/{len(split_indices.indices[\'val\'])}/{len(split_indices.indices[\'test\'])}")\n\n    # 4) Compute imbalance stats\n    print("[STEP] Computing class priors/effective numbers...")\n    imbalance_stats = compute_class_priors_effective_numbers(encoded_labels, split_indices, beta=0.9999)\n    print("[INFO] Class counts (train):", imbalance_stats.class_counts)\n\n    # 5) Tokenizer and tokenization\n    print("[STEP] Constructing tokenizer and tokenizing SMILES...")\n    tokenizer = construct_smiles_tokenizer_and_vocab()\n    tokenized_sequences = tokenize_and_map_smiles_sequences(zinc_data, tokenizer)\n\n    # 6) Pad/truncate and attention masks\n    print("[STEP] Padding/truncating sequences to length 60 and generating attention masks...")\n    padded_and_masked = pad_truncate_sequences_and_generate_attention_mask(tokenized_sequences, pad_idx=tokenizer.pad_idx, fixed_length=60)\n    print("[INFO] Padded sequences shape:", padded_and_masked.sequences.shape)\n\n    # 7) Create DataLoaders with num_workers=0 to avoid multiprocessing pickling issues\n    print("[STEP] Creating DataLoaders (num_workers=0 for safe multiprocessing behavior)...")\n    dataloaders = create_dataloader_and_attention_mask(\n        padded_and_masked,\n        encoded_labels,\n        split_indices,\n        batch_size=batch_size,\n        num_workers=num_workers,\n        seed=det_config.seed,\n    )\n    train_loader = dataloaders["train"]\n    val_loader = dataloaders["val"]\n    test_loader = dataloaders["test"]\n    steps_per_epoch = max(1, len(train_loader))\n    print(f"[INFO] Steps per epoch: {steps_per_epoch}")\n\n    # 8) Loss (Class-Balanced Focal Loss)\n    print("[STEP] Instantiating Class-Balanced Focal Loss...")\n    loss_fn = implement_class_balanced_focal_loss(alpha=imbalance_stats.alpha, gamma=1.5, label_smoothing=0.05)\n    loss_fn.to(device)\n\n    # 9) Build model\n    print("[STEP] Building model...")\n    max_idx = max(tokenizer.vocab.values()) if len(tokenizer.vocab) > 0 else 1\n    vocab_size = int(max_idx) + 1\n    model = build_model(\n        vocab_size=vocab_size,\n        embedding_dim=embedding_dim,\n        num_classes=num_classes,\n        pad_idx=tokenizer.pad_idx,\n        unk_idx=tokenizer.unk_idx,\n        token_dropout_p=0.02,\n        dropout=0.1,\n    )\n    model.to(device)\n\n    # 10) Optimizer, scheduler, AMP scaler\n    print("[STEP] Setting up optimizer, scheduler, and AMP scaler...")\n    training_setup = setup_optim_scheduler_amp(\n        model_params=model.parameters(),\n        epochs=epochs,\n        steps_per_epoch=steps_per_epoch,\n        seed=det_config.seed,\n        lr=lr,\n        weight_decay=weight_decay,\n        warmup_epochs=warmup_epochs,\n    )\n    optimizer = training_setup.optimizer\n    scheduler = training_setup.scheduler\n\n    # Replace the scaler created inside the module with a modern torch.amp.GradScaler where appropriate.\n    # Use device-aware construction to satisfy deprecation guidance.\n    try:\n        if torch.cuda.is_available():\n            scaler = torch.amp.GradScaler(device="cuda")\n        else:\n            # On CPU, GradScaler can be constructed without cuda device; it\'s effectively a no-op.\n            scaler = torch.amp.GradScaler()\n    except Exception:\n        # Fallback to older API if newer one not available in this torch version\n        try:\n            scaler = torch.cuda.amp.GradScaler()\n        except Exception:\n            scaler = None  # If no scaler available, training will proceed without AMP\n    if scaler is None:\n        # Create a dummy replacement that has the expected interface but does nothing (safe fallback)\n        class _DummyScaler:\n            def scale(self, x): return x\n            def step(self, optim): optim.step()\n            def update(self): pass\n            def unscale_(self, optim): pass\n        scaler = _DummyScaler()\n\n    # 11) Training loop with validation-driven early stopping & checkpointing\n    print("[STEP] Starting training loop...")\n    best_macro_acc = -1.0\n    patience_counter = 0\n    best_epoch = -1\n    start_time = time.time()\n\n    for epoch in range(1, epochs + 1):\n        print(f"\\n[TRAIN] Epoch {epoch}/{epochs} - training...")\n        avg_train_loss = epoch_train_pass(\n            model=model,\n            train_loader=train_loader,\n            loss_fn=loss_fn,\n            optimizer=optimizer,\n            scheduler=scheduler,\n            scaler=scaler,\n            device=device,\n        )\n        print(f"[TRAIN] Epoch {epoch} - average training loss: {avg_train_loss:.6f}")\n\n        print(f"[EVAL] Epoch {epoch} - validation pass...")\n        validation_metrics = epoch_validation_pass(\n            model=model,\n            val_loader=val_loader,\n            logit_adjuster=inference_logit_adjustment(imbalance_stats.class_priors),\n            device=device,\n            num_classes=num_classes,\n            best_macro_acc=best_macro_acc,\n            patience_counter=patience_counter,\n            patience=patience,\n        )\n\n        print(f"[EVAL] Epoch {epoch} - macro accuracy: {validation_metrics.macro_acc:.6f}")\n\n        if validation_metrics.is_best:\n            best_macro_acc = validation_metrics.macro_acc\n            patience_counter = 0\n            best_epoch = epoch\n            save_checkpoint(model, save_path)\n            print(f"[CHECKPOINT] New best model saved at epoch {epoch} with macro_acc={best_macro_acc:.6f}")\n        else:\n            patience_counter = validation_metrics.patience_counter\n            print(f"[EARLY STOP] No improvement. Patience counter: {patience_counter}/{patience}")\n\n        if patience_counter >= patience:\n            print(f"[EARLY STOP] Stopping early at epoch {epoch}.")\n            break\n\n    total_time = time.time() - start_time\n    print(f"\\n[INFO] Training finished in {total_time/60.0:.2f} minutes. Best epoch: {best_epoch} (macro_acc={best_macro_acc:.6f})")\n\n    # 12) Final test set evaluation using best checkpoint if available\n    print("[STEP] Final test set evaluation...")\n\n    if os.path.exists(save_path):\n        load_checkpoint_to_model(model, save_path)\n        print(f"[INFO] Loaded best checkpoint from {save_path}")\n    else:\n        print("[WARN] No checkpoint found; evaluating current model state.")\n\n    report = final_testset_evaluation_reporting(\n        model=model,\n        test_loader=test_loader,\n        logit_adjuster=inference_logit_adjustment(imbalance_stats.class_priors),\n        device=device,\n        num_classes=num_classes,\n    )\n\n    print("\\n[RESULT] Final Test Set Evaluation:")\n    for cls_idx, acc in report.per_class_acc.items():\n        print(f"  Class {cls_idx}: {acc:.6f}")\n    print(f"Macro accuracy: {report.macro_acc:.6f}")\n\n    print("\\n[END] Pipeline complete.")\n    return report.macro_acc\n\n\nif __name__ == "__main__":\n    final_macro_acc = run_pipeline()\n    print(f"METRIC_RESULT: {final_macro_acc}", flush=True)\n\n\n请开始审计。如果觉得有必要验证某个文件的具体实现，请调用工具读取它。'}, {'role': 'assistant', 'content': '', 'tool_calls': [{'id': 'call_hEU1ZPeWMn6rl1Ug01J2ZfBy', 'type': 'function', 'function': {'name': 'read_file', 'arguments': '{"file_path": "data_preparation_zinc_fluor/load_and_analyze_csv.py"}'}}, {'id': 'call_vkYNHLaZaqJbafXvlxeGe9ON', 'type': 'function', 'function': {'name': 'read_file', 'arguments': '{"file_path": "imbalance_strategy_design/implement_class_balanced_focal_loss.py"}'}}, {'id': 'call_rvWPkojWCbhxC7Zff6SB3Gn4', 'type': 'function', 'function': {'name': 'read_file', 'arguments': '{"file_path": "sequence_encoder_architecture/smiles_embedding_and_positional_encoding.py"}'}}]}, {'role': 'tool', 'tool_call_id': 'call_hEU1ZPeWMn6rl1Ug01J2ZfBy', 'name': 'read_file', 'content': 'import sys\nimport os\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.abspath(os.path.join(current_dir, ".."))\nsys.path.append(project_root)\n"""\nModule: load_zinc_fluor_csv_data\n\nDescription:\n    Deterministically loads the Zinc-Fluor CSV dataset and extracts the required columns\n    for downstream molecular preprocessing and modeling.\n\n    This module defines:\n    - ZincFluorData: a simple container for the filtered pandas DataFrame.\n    - load_zinc_fluor_csv_data: reads a CSV file, validates required columns, and\n      returns a ZincFluorData instance containing only the required columns in the\n      specified order.\n\nUsage:\n    See the test block under `if __name__ == "__main__":` for an example using the\n    provided dataset path.\n\nNotes:\n    - Does not perform any splitting, tokenization, augmentation, or random sampling.\n    - Relies on pandas for CSV reading; FileNotFoundError or pandas parsing errors\n      will be raised by pandas if the file is missing or malformed.\n"""\n\nfrom typing import List\nimport pandas as pd\n\n\nclass ZincFluorData:\n    """\n    Container for Zinc-Fluor molecular data.\n\n    Attributes:\n        df (pd.DataFrame): DataFrame with columns\n            [\'index\', \'SMILES\', \'pred_fluor_colour\', \'intensity\', \'color_value\']\n    """\n\n    def __init__(self, df: pd.DataFrame):\n        """\n        Initialize the container.\n\n        Args:\n            df: pandas DataFrame with required columns (order is preserved).\n        """\n        self.df: pd.DataFrame = df\n\n\ndef load_zinc_fluor_csv_data(csv_path: str) -> ZincFluorData:\n    """\n    Loads the Zinc-Fluor dataset from a CSV file, extracting relevant columns.\n\n    Args:\n        csv_path: Path to the Zinc-Fluor CSV file.\n\n    Returns:\n        ZincFluorData: Container object holding the filtered DataFrame with required columns.\n\n    Raises:\n        ValueError: If one or more required columns are missing from the CSV.\n        FileNotFoundError / pd.errors.ParserError: Raised by pandas on file issues.\n    """\n    # Read CSV into DataFrame (may raise FileNotFoundError if path invalid)\n    df = pd.read_csv(csv_path)\n\n    # Define required columns and validate presence\n    required_columns: List[str] = [\n        "index",\n        "SMILES",\n        "pred_fluor_colour",\n        "intensity",\n        "color_value",\n    ]\n    missing_columns = [c for c in required_columns if c not in df.columns]\n    if missing_columns:\n        raise ValueError(\n            f"The input CSV is missing required columns: {missing_columns}. "\n            f"Expected columns: {required_columns}."\n        )\n\n    # Extract required columns preserving original row order\n    filtered_df = df[required_columns].copy()\n\n    # Return wrapped data container\n    return ZincFluorData(filtered_df)\n\n\n\nimport sys\nimport os\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.abspath(os.path.join(current_dir, ".."))\nsys.path.append(project_root)\n"""\nModule: analyze_feature_and_label_distribution\n\nDescription:\n    Provides deterministic analysis of the in-memory Zinc-Fluor dataset (ZincFluorData).\n    Computes SMILES length statistics, unique character set, and class distribution/proportions\n    for the \'color_value\' target. Designed to be used after loading data via\n    load_zinc_fluor_csv_data.\n\nConstraints:\n    - No file I/O performed here (operates on the provided ZincFluorData object).\n    - Deterministic computations only (no randomness).\n    - Python 3.9+, pandas==2.0, numpy>=1.21\n"""\n\nfrom typing import Dict, Any, Set, List\nfrom collections import Counter\nimport numpy as np\nimport pandas as pd\n\n\nclass DatasetAnalysisReport:\n    """\n    Container for dataset analysis statistics.\n\n    Attributes:\n        smiles_length_stats: Dict with keys \'min\', \'max\', \'mean\', \'median\', \'percentiles\' (25, 75)\n        smiles_charset: Set of unique characters across all SMILES strings\n        class_distribution: Mapping from color_value to sample count\n        class_proportions: Mapping from color_value to class proportion (float)\n    """\n\n    def __init__(\n        self,\n        smiles_length_stats: Dict[str, Any],\n        smiles_charset: Set[str],\n        class_distribution: Dict[int, int],\n        class_proportions: Dict[int, float],\n    ):\n        self.smiles_length_stats = smiles_length_stats\n        self.smiles_charset = smiles_charset\n        self.class_distribution = class_distribution\n        self.class_proportions = class_proportions\n\n    def __repr__(self) -> str:\n        return (\n            f"DatasetAnalysisReport(smiles_length_stats={self.smiles_length_stats}, "\n            f"smiles_charset_size={len(self.smiles_charset)}, "\n            f"class_distribution={self.class_distribution}, "\n            f"class_proportions={self.class_proportions})"\n        )\n\n\ndef analyze_feature_and_label_distribution(zinc_data) -> DatasetAnalysisReport:\n    """\n    Analyzes SMILES sequence statistics and class label imbalance in the Zinc-Fluor dataset.\n\n    Args:\n        zinc_data: ZincFluorData object containing a pandas DataFrame attribute `df`\n                   with at least the columns [\'SMILES\', \'color_value\'].\n\n    Returns:\n        DatasetAnalysisReport: Object with statistics for downstream strategy design.\n    """\n    # Extract DataFrame reference (expects attribute df to exist)\n    df: pd.DataFrame = zinc_data.df\n\n    # Ensure columns exist - deterministic check, raise ValueError if missing\n    required_cols: List[str] = ["SMILES", "color_value"]\n    missing = [c for c in required_cols if c not in df.columns]\n    if missing:\n        raise ValueError(\n            f"Input zinc_data.df is missing required columns: {missing}. "\n            f"Expected at least: {required_cols}."\n        )\n\n    # Extract SMILES as strings, preserving row order\n    # Convert NaN to empty string to be deterministic\n    smiles_series = df["SMILES"].fillna("").astype(str)\n    total_samples = int(len(smiles_series))\n\n    # Compute lengths\n    if total_samples == 0:\n        lengths = np.array([], dtype=int)\n    else:\n        # Vectorized length computation\n        lengths = smiles_series.str.len().to_numpy(dtype=int)\n\n    # Compute length statistics deterministically\n    if lengths.size == 0:\n        smiles_length_stats = {\n            "min": 0,\n            "max": 0,\n            "mean": 0.0,\n            "median": 0.0,\n            "percentiles": {"25": 0.0, "75": 0.0},\n        }\n        smiles_charset: Set[str] = set()\n    else:\n        min_len = int(np.min(lengths))\n        max_len = int(np.max(lengths))\n        mean_len = float(np.mean(lengths))\n        median_len = float(np.median(lengths))\n        p25 = float(np.percentile(lengths, 25))\n        p75 = float(np.percentile(lengths, 75))\n        smiles_length_stats = {\n            "min": min_len,\n            "max": max_len,\n            "mean": mean_len,\n            "median": median_len,\n            "percentiles": {"25": p25, "75": p75},\n        }\n\n        # Build charset deterministically by iterating through SMILES in original order\n        charset_set: Set[str] = set()\n        for s in smiles_series:\n            # s is a Python str; iterate characters\n            # This deterministic approach preserves the union order-insensitive property\n            if s:\n                charset_set.update(s)\n        smiles_charset = charset_set\n\n    # Class distribution and proportions\n    # Extract color_value column; do not modify input df\n    color_series = df["color_value"].copy()\n    # Ensure deterministic types: attempt to cast to int where possible\n    # If non-integer values exist, leave as-is (counts will still work)\n    try:\n        color_series = color_series.astype(int)\n    except Exception:\n        # If casting fails, use original values (counts still meaningful)\n        color_series = color_series\n\n    total_count = int(len(color_series))\n    counter = Counter(color_series.tolist())\n    # Sort keys for deterministic ordering in returned dict\n    sorted_keys = sorted(counter.keys(), key=lambda x: (int(x) if isinstance(x, (int, np.integer)) else str(x)))\n    class_distribution = {int(k): int(counter[k]) for k in sorted_keys}\n    if total_count == 0:\n        class_proportions = {int(k): 0.0 for k in class_distribution.keys()}\n    else:\n        class_proportions = {int(k): float(counter[k]) / float(total_count) for k in sorted_keys}\n\n    # Package into report\n    report = DatasetAnalysisReport(\n        smiles_length_stats=smiles_length_stats,\n        smiles_charset=smiles_charset,\n        class_distribution=class_distribution,\n        class_proportions=class_proportions,\n    )\n\n    return report\n\n\n\n'}, {'role': 'tool', 'tool_call_id': 'call_vkYNHLaZaqJbafXvlxeGe9ON', 'name': 'read_file', 'content': 'import sys\nimport os\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.abspath(os.path.join(current_dir, ".."))\nsys.path.append(project_root)\n"""\nModule: implement_class_balanced_focal_loss\n\nDescription:\n    Implements a PyTorch loss module for Class-Balanced Focal Loss (CB-Focal)\n    with per-class effective number weighting (alpha), focal modulation (gamma),\n    and label smoothing. The module deterministically applies provided alpha\n    coefficients and supports usage directly in training loops.\n\nNotes:\n    - Requires torch>=1.9 and numpy>=1.21.\n    - No sampling-based rebalancing performed here.\n"""\n\nfrom typing import Optional\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\n\nclass ClassBalancedFocalLoss(nn.Module):\n    """\n    PyTorch module for a hybrid loss combining Class-Balanced Focal Loss with Label Smoothing,\n    Dice Loss, and an additional Anti-Spoofing penalty to improve robustness on rare classes.\n\n    This loss:\n      - Applies label smoothing to the one-hot targets.\n      - Uses Class-Balanced Focal Loss for hard sample mining.\n      - Uses Dice Loss for overlap-based imbalance.\n      - Adds an anti-spoofing penalty to penalize confident predictions on minority classes,\n        reducing overfitting on noisy rare-class features.\n\n    Args:\n        alpha: Tensor of normalized alpha coefficients per class (shape: [num_classes]).\n        gamma: Focal modulation parameter (default 1.5).\n        label_smoothing: Smoothing value for one-hot targets (default 0.05).\n        dice_weight: Weight for the Dice loss component (default 1.0).\n        focal_weight: Weight for the Focal loss component (default 1.0).\n        anti_spoof_weight: Weight for the anti-spoofing penalty (default 0.5).\n        anti_spoof_margin: Margin threshold for anti-spoofing penalty (default 0.7).\n        epsilon: Small value to avoid division by zero in Dice loss (default 1e-6).\n    """\n\n    def __init__(\n        self,\n        alpha: torch.Tensor,\n        gamma: float = 1.5,\n        label_smoothing: float = 0.05,\n        dice_weight: float = 1.0,\n        focal_weight: float = 1.0,\n        anti_spoof_weight: float = 0.5,\n        anti_spoof_margin: float = 0.7,\n        epsilon: float = 1e-6,\n    ):\n        super().__init__()\n        if not isinstance(alpha, torch.Tensor):\n            alpha = torch.tensor(alpha, dtype=torch.float32)\n        self.register_buffer("alpha", alpha.to(dtype=torch.float32))\n        self.gamma = float(gamma)\n        self.label_smoothing = float(label_smoothing)\n        self.dice_weight = float(dice_weight)\n        self.focal_weight = float(focal_weight)\n        self.anti_spoof_weight = float(anti_spoof_weight)\n        self.anti_spoof_margin = float(anti_spoof_margin)\n        self.epsilon = float(epsilon)\n\n    def forward(self, logits: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:\n        """\n        Compute the combined Class-Balanced Focal Loss, Dice Loss and Anti-Spoofing penalty.\n\n        Args:\n            logits: [batch_size, num_classes] unnormalized model outputs.\n            targets: [batch_size] integer class indices.\n\n        Returns:\n            loss: Scalar torch.Tensor (averaged over batch).\n        """\n        if logits.dim() != 2:\n            raise ValueError(\n                f"logits must be a 2D tensor [batch_size, num_classes], got shape {tuple(logits.shape)}"\n            )\n        batch_size, num_classes = logits.shape\n\n        alpha = self.alpha\n        if alpha.device != logits.device:\n            alpha = alpha.to(logits.device)\n\n        if alpha.numel() != num_classes:\n            raise ValueError(\n                f"Length of alpha ({alpha.numel()}) does not match number of classes in logits ({num_classes})."\n            )\n\n        targets = targets.to(dtype=torch.long, device=logits.device)\n\n        # Build smoothed one-hot targets\n        one_hot = F.one_hot(targets, num_classes=num_classes).to(\n            dtype=logits.dtype, device=logits.device\n        )\n        if self.label_smoothing > 0.0:\n            smoothing_value = self.label_smoothing\n            one_hot = one_hot * (1.0 - smoothing_value) + (smoothing_value / float(num_classes))\n\n        # --- Class-Balanced Focal Loss part ---\n        log_probs = F.log_softmax(logits, dim=-1)  # [B, C]\n        probs = torch.exp(log_probs)  # [B, C]\n\n        focal_factor = (1.0 - probs).pow(self.gamma)  # [B, C]\n        alpha_factor = alpha.view(1, -1)  # [1, C]\n\n        focal_loss_matrix = alpha_factor * focal_factor * (-one_hot * log_probs)  # [B, C]\n        focal_loss_per_sample = focal_loss_matrix.sum(dim=1)  # [B]\n        focal_loss = focal_loss_per_sample.mean()  # scalar\n\n        # --- Dice Loss part ---\n        # For Dice, compute per-class dice over batch:\n        # Intersection = sum over batch of (p * y)\n        # Union = sum over batch of p + sum over batch of y\n        intersection = (probs * one_hot).sum(dim=0)  # [C]\n        cardinality = probs.sum(dim=0) + one_hot.sum(dim=0)  # [C]\n\n        dice_score = (2.0 * intersection + self.epsilon) / (cardinality + self.epsilon)  # [C]\n        dice_loss_per_class = 1.0 - dice_score  # [C]\n\n        # Weighted average dice loss by alpha\n        dice_loss = (alpha * dice_loss_per_class).sum()  # scalar\n\n        # --- Anti-Spoofing Penalty ---\n        # Penalize highly confident predictions for minority classes (with small alpha)\n        # that exceed a margin threshold, to avoid overfitting and noisy minority features.\n\n        # Identify minority classes: classes where alpha is less than mean alpha (or a threshold)\n        mean_alpha = alpha.mean()\n        minority_mask = (alpha < mean_alpha).float()  # [C]\n\n        # For each sample, get predicted class probabilities after softmax\n        # We compute penalty only on minority classes for predictions exceeding margin\n        probs_minority = probs * minority_mask.view(1, -1)  # [B, C], zero prob for majority classes\n\n        # Compute margin violation: max(0, prob - margin)\n        margin_violation = torch.clamp(probs_minority - self.anti_spoof_margin, min=0.0)\n\n        # Square penalty to strongly penalize large violations\n        anti_spoof_loss = margin_violation.pow(2).sum(dim=1)  # [B]\n\n        # Average penalty over batch\n        anti_spoof_loss = anti_spoof_loss.mean()\n\n        # --- Combine all losses ---\n        loss = (\n            self.focal_weight * focal_loss\n            + self.dice_weight * dice_loss\n            + self.anti_spoof_weight * anti_spoof_loss\n        )\n\n        return loss\n\n\ndef implement_class_balanced_focal_loss(\n    alpha: np.ndarray,\n    gamma: float = 1.5,\n    label_smoothing: float = 0.05,\n) -> ClassBalancedFocalLoss:\n    """\n    Instantiates the Class-Balanced Focal Loss module.\n\n    Args:\n        alpha: np.ndarray of normalized alpha coefficients (from ClassImbalanceStats).\n        gamma: Focal modulation parameter (default 1.5).\n        label_smoothing: Label smoothing value (default 0.05).\n\n    Returns:\n        ClassBalancedFocalLoss: PyTorch loss module.\n    """\n    # Convert alpha (numpy) to torch tensor (float32)\n    if isinstance(alpha, np.ndarray):\n        alpha_tensor = torch.from_numpy(alpha.astype(np.float32))\n    elif isinstance(alpha, (list, tuple)):\n        alpha_tensor = torch.tensor(list(alpha), dtype=torch.float32)\n    elif isinstance(alpha, torch.Tensor):\n        alpha_tensor = alpha.to(dtype=torch.float32)\n    else:\n        # Fallback: try to construct tensor\n        alpha_tensor = torch.tensor(alpha, dtype=torch.float32)\n\n    # Instantiate and return the loss module\n    loss_module = ClassBalancedFocalLoss(alpha=alpha_tensor, gamma=gamma, label_smoothing=label_smoothing)\n    return loss_module\n\n\n\n'}, {'role': 'tool', 'tool_call_id': 'call_rvWPkojWCbhxC7Zff6SB3Gn4', 'name': 'read_file', 'content': 'import sys\nimport os\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.abspath(os.path.join(current_dir, ".."))\nsys.path.append(project_root)\n"""\nModule: smiles_token_embedding_layer\n\nDescription:\n    Implements a PyTorch nn.Embedding layer to convert SMILES token indices into dense vectors.\n    - Embedding weights are initialized with Xavier uniform initialization.\n    - PAD (pad_idx) embedding is zeroed and is not updated by the embedding layer (padding_idx feature).\n    - UNK (unk_idx) embedding is zeroed and additionally prevented from being updated by\n      zeroing its gradient via a registered hook, ensuring no learned embeddings for PAD/UNK.\n    - Provides a factory function smiles_token_embedding_layer(...) to instantiate the module.\n\nConstraints:\n    - Python 3.9+, torch>=1.9\n    - Xavier uniform initialization used; PAD and UNK embeddings are zero and not trainable.\n"""\n\nfrom typing import Optional\nimport torch\nimport torch.nn as nn\n\n\nclass SmilesTokenEmbedding(nn.Module):\n    """\n    SMILES token embedding layer with Xavier uniform initialization.\n\n    Args:\n        vocab_size: Size of the SMILES vocabulary (number of embeddings).\n        embedding_dim: Output embedding dimension.\n        pad_idx: Index for PAD token (default 0). This index will be zeroed and not updated.\n        unk_idx: Index for UNK token (default 1). This index will be zeroed and prevented from\n                 being updated by zeroing its gradient in a registered hook.\n    """\n\n    def __init__(self, vocab_size: int, embedding_dim: int, pad_idx: int = 0, unk_idx: int = 1):\n        super().__init__()\n        if vocab_size <= 0:\n            raise ValueError(f"vocab_size must be positive, got {vocab_size}")\n        if not (0 <= pad_idx < vocab_size):\n            raise ValueError(f"pad_idx ({pad_idx}) must be within [0, vocab_size-1]")\n        if not (0 <= unk_idx < vocab_size):\n            raise ValueError(f"unk_idx ({unk_idx}) must be within [0, vocab_size-1]")\n\n        self.pad_idx = int(pad_idx)\n        self.unk_idx = int(unk_idx)\n\n        # Create embedding with padding_idx to prevent padding embedding from being updated by optimizer\n        self.embedding = nn.Embedding(num_embeddings=int(vocab_size), embedding_dim=int(embedding_dim), padding_idx=self.pad_idx)\n\n        # Xavier uniform initialization for all weights\n        nn.init.xavier_uniform_(self.embedding.weight)\n\n        # Zero out PAD and UNK embeddings deterministically and ensure they are not trainable\n        with torch.no_grad():\n            # Zero PAD\n            self.embedding.weight[self.pad_idx].zero_()\n            # Zero UNK\n            self.embedding.weight[self.unk_idx].zero_()\n\n        # Register gradient hook to prevent updates to PAD and UNK rows during backward pass.\n        # This ensures PAD and UNK embeddings remain zero regardless of optimizer.\n        def _zero_pad_unk_grads(grad: torch.Tensor) -> torch.Tensor:\n            # grad is the gradient w.r.t. embedding.weight with shape [vocab_size, embedding_dim]\n            device = grad.device\n            # Create a mask of ones and set PAD and UNK rows to zero\n            mask = torch.ones_like(grad, device=device)\n            mask[self.pad_idx] = 0.0\n            mask[self.unk_idx] = 0.0\n            return grad * mask\n\n        # Attach hook to embedding weights\n        self.embedding.weight.register_hook(_zero_pad_unk_grads)\n\n    def forward(self, token_indices: torch.Tensor) -> torch.Tensor:\n        """\n        Embeds token indices into dense vectors.\n\n        Args:\n            token_indices: [batch_size, seq_len] tensor of token indices (torch.long).\n\n        Returns:\n            [batch_size, seq_len, embedding_dim] tensor of embeddings (torch.float).\n        """\n        if token_indices.dtype != torch.long and token_indices.dtype != torch.int64:\n            # Ensure indices are long tensors\n            token_indices = token_indices.to(dtype=torch.long)\n        return self.embedding(token_indices)\n\n\ndef smiles_token_embedding_layer(\n    vocab_size: int,\n    embedding_dim: int = 192,\n    pad_idx: int = 0,\n    unk_idx: int = 1,\n) -> SmilesTokenEmbedding:\n    """\n    Instantiates the SMILES token embedding layer.\n\n    Args:\n        vocab_size: Size of the SMILES vocabulary (number of embeddings).\n        embedding_dim: Embedding dimension (default 192).\n        pad_idx: PAD token index (default 0).\n        unk_idx: UNK token index (default 1).\n\n    Returns:\n        SmilesTokenEmbedding: Configured embedding module.\n    """\n    return SmilesTokenEmbedding(vocab_size=vocab_size, embedding_dim=embedding_dim, pad_idx=pad_idx, unk_idx=unk_idx)\n\n\n\nimport sys\nimport os\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.abspath(os.path.join(current_dir, ".."))\nsys.path.append(project_root)\n"""\nModule: embedding_token_dropout_and_layernorm\n\nDescription:\n    Applies token-level dropout to embedding outputs by zeroing entire token vectors\n    during training, followed by a LayerNorm operation with epsilon=1e-5. LayerNorm\n    is configured without learnable affine parameters so that zeroed tokens remain\n    exact zeros after normalization.\n\nUsage:\n    module = embedding_token_dropout_and_layernorm(embedding_dim=192, dropout_p=0.02)\n    processed = module(embeddings)  # embeddings: [batch, seq_len, embedding_dim]\n"""\n\nfrom typing import Optional\nimport torch\nimport torch.nn as nn\n\n\nclass EmbeddingTokenDropoutLayerNorm(nn.Module):\n    """\n    Token-level dropout and LayerNorm for SMILES embeddings.\n\n    Args:\n        embedding_dim: Dimension of embedding vectors.\n        dropout_p: Token dropout probability (default 0.02).\n        eps: Epsilon for LayerNorm (default 1e-5).\n    """\n\n    def __init__(self, embedding_dim: int, dropout_p: float = 0.02, eps: float = 1e-5):\n        super().__init__()\n        if embedding_dim <= 0:\n            raise ValueError(f"embedding_dim must be positive, got {embedding_dim}")\n        if not (0.0 <= dropout_p < 1.0):\n            raise ValueError(f"dropout_p must be in [0.0, 1.0), got {dropout_p}")\n        self.dropout_p = float(dropout_p)\n        # Use elementwise_affine=False so zeroed token vectors remain exact zeros after LayerNorm\n        self.layernorm = nn.LayerNorm(embedding_dim, eps=eps, elementwise_affine=False)\n\n    def forward(self, embeddings: torch.Tensor) -> torch.Tensor:\n        """\n        Applies token-level dropout and LayerNorm to embeddings.\n\n        Args:\n            embeddings: [batch_size, seq_len, embedding_dim] tensor.\n\n        Returns:\n            [batch_size, seq_len, embedding_dim] tensor after dropout and normalization.\n        """\n        if embeddings.dim() != 3:\n            raise ValueError(f"Expected embeddings of shape [B, L, D], got shape {tuple(embeddings.shape)}")\n\n        if self.training and self.dropout_p > 0.0:\n            # Generate dropout mask per token: shape [batch_size, seq_len], True means keep\n            device = embeddings.device\n            keep_mask = (torch.rand(embeddings.shape[0], embeddings.shape[1], device=device) > self.dropout_p)\n            # Expand mask to [batch_size, seq_len, 1] and align dtype for multiplication\n            keep_mask = keep_mask.unsqueeze(-1).type_as(embeddings)\n            embeddings = embeddings * keep_mask\n\n        # Apply LayerNorm (elementwise_affine=False preserves zeros)\n        embeddings = self.layernorm(embeddings)\n        return embeddings\n\n\ndef embedding_token_dropout_and_layernorm(\n    embedding_dim: int,\n    dropout_p: float = 0.02,\n    eps: float = 1e-5,\n) -> EmbeddingTokenDropoutLayerNorm:\n    """\n    Instantiates the token-level dropout and LayerNorm module.\n\n    Args:\n        embedding_dim: Dimension of embedding vectors.\n        dropout_p: Dropout probability (default 0.02).\n        eps: Epsilon for LayerNorm (default 1e-5).\n\n    Returns:\n        EmbeddingTokenDropoutLayerNorm: PyTorch module for dropout and normalization.\n    """\n    return EmbeddingTokenDropoutLayerNorm(embedding_dim=embedding_dim, dropout_p=dropout_p, eps=eps)\n\n\n\nimport sys\nimport os\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.abspath(os.path.join(current_dir, ".."))\nsys.path.append(project_root)\n"""\nModule: sinusoidal_positional_encoding_addition\n\nDescription:\n    Generates fixed sinusoidal positional encodings for sequence lengths up to a\n    configurable maximum (default 60) and adds them to embedding outputs in a\n    deterministic, non-learned manner.\n\nUsage:\n    pos_enc = sinusoidal_positional_encoding_addition(max_length=60, embedding_dim=192)\n    embeddings_with_pos = pos_enc.add(embeddings)  # embeddings: [B, L, D], L <= max_length\n"""\n\nfrom typing import Optional\nimport numpy as np\nimport torch\n\n\nclass SinusoidalPositionalEncoding:\n    """\n    Precomputes sinusoidal positional encodings and provides a method to add them\n    to embedding tensors.\n\n    Attributes:\n        max_length (int): maximum supported sequence length.\n        embedding_dim (int): embedding dimension.\n        pe_tensor (torch.Tensor): precomputed positional encodings of shape [max_length, embedding_dim].\n    """\n\n    def __init__(self, max_length: int, embedding_dim: int):\n        if max_length <= 0:\n            raise ValueError(f"max_length must be positive, got {max_length}")\n        if embedding_dim <= 0:\n            raise ValueError(f"embedding_dim must be positive, got {embedding_dim}")\n\n        self.max_length = int(max_length)\n        self.embedding_dim = int(embedding_dim)\n\n        # Compute positional encodings using numpy for determinism\n        position = np.arange(self.max_length, dtype=np.float64)[:, np.newaxis]  # [max_length, 1]\n        div_term = np.exp(np.arange(0, self.embedding_dim, 2, dtype=np.float64) * (-np.log(10000.0) / self.embedding_dim))  # [D/2]\n\n        pe = np.zeros((self.max_length, self.embedding_dim), dtype=np.float32)\n        # Even indices: sin, Odd indices: cos\n        pe[:, 0::2] = np.sin(position * div_term)\n        pe[:, 1::2] = np.cos(position * div_term)\n\n        # Store as float32 tensor for efficient usage; CPU tensor by default\n        self.pe_tensor = torch.from_numpy(pe)  # shape: [max_length, embedding_dim], dtype=float32\n\n    def add(self, embeddings: torch.Tensor) -> torch.Tensor:\n        """\n        Adds positional encodings to embeddings.\n\n        Args:\n            embeddings: torch.Tensor of shape [batch_size, seq_len, embedding_dim].\n\n        Returns:\n            torch.Tensor: embeddings + positional encodings, same dtype and device as input.\n        """\n        if embeddings.dim() != 3:\n            raise ValueError(f"Expected embeddings of shape [B, L, D], got {tuple(embeddings.shape)}")\n\n        batch_size, seq_len, emb_dim = embeddings.shape\n        if seq_len > self.max_length:\n            raise ValueError(f"Sequence length {seq_len} exceeds precomputed max_length {self.max_length}")\n        if emb_dim != self.embedding_dim:\n            raise ValueError(f"Embedding dim ({emb_dim}) does not match positional encoding dim ({self.embedding_dim})")\n\n        # Slice the positional encodings to the required sequence length\n        pos_enc = self.pe_tensor[:seq_len]  # [seq_len, embedding_dim]\n        # Move to same device and dtype as embeddings\n        pos_enc = pos_enc.to(device=embeddings.device, dtype=embeddings.dtype)\n        # Broadcast and add\n        pos_enc = pos_enc.unsqueeze(0)  # [1, seq_len, embedding_dim]\n        return embeddings + pos_enc\n\n\ndef sinusoidal_positional_encoding_addition(max_length: int = 60, embedding_dim: int = 192) -> SinusoidalPositionalEncoding:\n    """\n    Factory function to create a SinusoidalPositionalEncoding instance.\n\n    Args:\n        max_length: Maximum sequence length supported (default 60).\n        embedding_dim: Embedding dimension (default 192).\n\n    Returns:\n        SinusoidalPositionalEncoding instance.\n    """\n    return SinusoidalPositionalEncoding(max_length=max_length, embedding_dim=embedding_dim)\n\n\n\n'}, {'role': 'assistant', 'content': '', 'tool_calls': [{'id': 'call_oIoHJLmuJbENgeq1dfWjMzlE', 'type': 'function', 'function': {'name': 'read_file', 'arguments': '{"file_path":"sequence_encoder_architecture/pre_layernorm_transformer_encoder.py"}'}}]}, {'role': 'tool', 'tool_call_id': 'call_oIoHJLmuJbENgeq1dfWjMzlE', 'name': 'read_file', 'content': 'import sys\nimport os\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.abspath(os.path.join(current_dir, ".."))\nsys.path.append(project_root)\n"""\nModule: multihead_attention_with_padding_mask\n\nDescription:\n    Implements a deterministic multi-head self-attention module that respects PAD token\n    masks so that attention does not propagate information from padded positions.\n    Designed for batched SMILES sequence inputs for the transformer encoder.\n\nUsage:\n    attn_module = multihead_attention_with_padding_mask(embedding_dim=192, num_heads=6, dropout=0.1)\n    output = attn_module(embeddings, pad_mask)\n    - embeddings: torch.Tensor of shape [batch_size, seq_len, embedding_dim]\n    - pad_mask: torch.BoolTensor of shape [batch_size, seq_len], True at PAD positions\n\nNotes:\n    - Uses torch.nn.MultiheadAttention with batch_first=True.\n    - The key_padding_mask expected by nn.MultiheadAttention should be True at positions\n      that are to be masked (i.e., PAD tokens); this module passes pad_mask through directly.\n    - No random masking is performed here; masking is entirely driven by the provided pad_mask.\n"""\n\nfrom typing import Optional\nimport torch\nimport torch.nn as nn\n\n\nclass MultiheadSelfAttentionWithMask(nn.Module):\n    """\n    Multihead self-attention module with PAD masking.\n\n    Args:\n        embedding_dim: Input/output dimension.\n        num_heads: Number of attention heads.\n        dropout: Dropout probability applied inside attention module.\n    """\n\n    def __init__(self, embedding_dim: int = 192, num_heads: int = 6, dropout: float = 0.1):\n        super().__init__()\n        # Initialize nn.MultiheadAttention with batch_first so inputs are [B, L, D]\n        self.embedding_dim = int(embedding_dim)\n        self.num_heads = int(num_heads)\n        self.dropout = float(dropout)\n        self.attn = nn.MultiheadAttention(\n            embed_dim=self.embedding_dim,\n            num_heads=self.num_heads,\n            dropout=self.dropout,\n            batch_first=True\n        )\n\n    def forward(self, x: torch.Tensor, pad_mask: torch.Tensor) -> torch.Tensor:\n        """\n        Applies multihead self-attention with PAD masking.\n\n        Args:\n            x: Tensor of shape [batch_size, seq_len, embedding_dim].\n            pad_mask: Boolean tensor of shape [batch_size, seq_len]; True indicates PAD positions.\n\n        Returns:\n            Tensor of shape [batch_size, seq_len, embedding_dim] with attention outputs.\n        """\n        # Validate shapes minimally\n        if x.dim() != 3:\n            raise ValueError(f"x must be of shape [B, L, D], got {tuple(x.shape)}")\n        if pad_mask.dim() != 2:\n            raise ValueError(f"pad_mask must be of shape [B, L], got {tuple(pad_mask.shape)}")\n        if x.size(0) != pad_mask.size(0) or x.size(1) != pad_mask.size(1):\n            raise ValueError("pad_mask must match the batch and sequence dimensions of x")\n\n        # nn.MultiheadAttention accepts key_padding_mask with True indicating positions to mask\n        # Ensure pad_mask is of dtype bool\n        if pad_mask.dtype != torch.bool:\n            pad_mask = pad_mask.to(dtype=torch.bool)\n\n        attn_out, _ = self.attn(x, x, x, key_padding_mask=pad_mask)\n        return attn_out\n\n\ndef multihead_attention_with_padding_mask(\n    embedding_dim: int = 192,\n    num_heads: int = 6,\n    dropout: float = 0.1\n) -> MultiheadSelfAttentionWithMask:\n    """\n    Factory to instantiate MultiheadSelfAttentionWithMask.\n\n    Args:\n        embedding_dim: Input/output dimension (default 192).\n        num_heads: Number of attention heads (default 6).\n        dropout: Dropout probability (default 0.1).\n\n    Returns:\n        MultiheadSelfAttentionWithMask instance.\n    """\n    return MultiheadSelfAttentionWithMask(embedding_dim=embedding_dim, num_heads=num_heads, dropout=dropout)\n\n\n\n\n\nfrom typing import Optional\nimport torch\nimport torch.nn as nn\n\n\nclass MultiheadSelfAttentionWithMask(nn.Module):\n    """\n    Multihead self-attention module with PAD masking.\n\n    Uses nn.MultiheadAttention with batch_first=True.\n    """\n\n    def __init__(self, embedding_dim: int = 192, num_heads: int = 6, dropout: float = 0.1):\n        super().__init__()\n        self.embedding_dim = int(embedding_dim)\n        self.num_heads = int(num_heads)\n        self.dropout = float(dropout)\n        self.attn = nn.MultiheadAttention(\n            embed_dim=self.embedding_dim,\n            num_heads=self.num_heads,\n            dropout=self.dropout,\n            batch_first=True,\n        )\n\n    def forward(self, x: torch.Tensor, pad_mask: torch.Tensor) -> torch.Tensor:\n        """\n        Args:\n            x: [batch_size, seq_len, embedding_dim]\n            pad_mask: [batch_size, seq_len] boolean mask, True indicates PAD positions.\n\n        Returns:\n            attn_out: [batch_size, seq_len, embedding_dim]\n        """\n        if x.dim() != 3:\n            raise ValueError(f"x must be [B, L, D], got {tuple(x.shape)}")\n        if pad_mask.dim() != 2:\n            raise ValueError(f"pad_mask must be [B, L], got {tuple(pad_mask.shape)}")\n        if x.size(0) != pad_mask.size(0) or x.size(1) != pad_mask.size(1):\n            raise ValueError("pad_mask must match batch and sequence dimensions of x")\n\n        if pad_mask.dtype != torch.bool:\n            pad_mask = pad_mask.to(dtype=torch.bool)\n\n        attn_out, _ = self.attn(x, x, x, key_padding_mask=pad_mask)\n        return attn_out\n\n\nclass FeedForwardPreLayerNorm(nn.Module):\n    """\n    Feed-forward sub-layer with Pre-LayerNorm.\n\n    Architecture:\n      LayerNorm(input_dim) -> Linear(input_dim -> hidden_dim) -> GELU -> Dropout -> Linear(hidden_dim -> input_dim)\n    """\n\n    def __init__(self, input_dim: int = 192, hidden_dim: int = 768, dropout_p: float = 0.1, eps: float = 1e-5):\n        super().__init__()\n        self.layernorm = nn.LayerNorm(input_dim, eps=eps)\n        self.fc1 = nn.Linear(input_dim, hidden_dim)\n        self.act = nn.GELU()\n        self.dropout = nn.Dropout(dropout_p)\n        self.fc2 = nn.Linear(hidden_dim, input_dim)\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        """\n        Args:\n            x: [batch_size, seq_len, input_dim]\n\n        Returns:\n            out: [batch_size, seq_len, input_dim]\n        """\n        x_norm = self.layernorm(x)\n        x_ff = self.fc1(x_norm)\n        x_ff = self.act(x_ff)\n        x_ff = self.dropout(x_ff)\n        x_ff = self.fc2(x_ff)\n        return x_ff\n\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\nclass RelativePositionMultiheadSelfAttention(nn.Module):\n    """\n    Multi-head self-attention with relative position encoding (as in Transformer-XL / T5 style).\n    """\n\n    def __init__(self, embedding_dim, num_heads, dropout=0.1):\n        super().__init__()\n        assert embedding_dim % num_heads == 0, "embedding_dim must be divisible by num_heads"\n        self.embedding_dim = embedding_dim\n        self.num_heads = num_heads\n        self.head_dim = embedding_dim // num_heads\n\n        self.q_proj = nn.Linear(embedding_dim, embedding_dim, bias=False)\n        self.k_proj = nn.Linear(embedding_dim, embedding_dim, bias=False)\n        self.v_proj = nn.Linear(embedding_dim, embedding_dim, bias=False)\n        self.out_proj = nn.Linear(embedding_dim, embedding_dim, bias=False)\n\n        self.dropout = nn.Dropout(dropout)\n\n        # Relative position embeddings: max relative positions to consider (can be tuned)\n        self.max_rel_pos = 128\n        self.rel_pos_emb = nn.Embedding(2 * self.max_rel_pos + 1, self.head_dim)\n\n    def _generate_relative_positions_matrix(self, length):\n        """\n        Generate matrix of relative positions between inputs of length `length`.\n        Positions clipped to the range [-max_rel_pos, max_rel_pos].\n        """\n        range_vec = torch.arange(length, device=self.rel_pos_emb.weight.device)\n        distance_mat = range_vec[None, :] - range_vec[:, None]\n        distance_mat_clipped = torch.clamp(distance_mat, -self.max_rel_pos, self.max_rel_pos)\n        # Shift values to be >= 0 for embedding lookup\n        final_mat = distance_mat_clipped + self.max_rel_pos\n        return final_mat  # shape: [length, length]\n\n    def forward(self, x: torch.Tensor, pad_mask: torch.Tensor) -> torch.Tensor:\n        """\n        Args:\n            x: [batch_size, seq_len, embedding_dim]\n            pad_mask: [batch_size, seq_len] boolean mask (True where padding)\n\n        Returns:\n            out: [batch_size, seq_len, embedding_dim]\n        """\n        batch_size, seq_len, _ = x.size()\n\n        q = self.q_proj(x)  # [B, L, D]\n        k = self.k_proj(x)\n        v = self.v_proj(x)\n\n        # reshape and transpose for multihead: [B, num_heads, L, head_dim]\n        q = q.view(batch_size, seq_len, self.num_heads, self.head_dim).transpose(1, 2)\n        k = k.view(batch_size, seq_len, self.num_heads, self.head_dim).transpose(1, 2)\n        v = v.view(batch_size, seq_len, self.num_heads, self.head_dim).transpose(1, 2)\n\n        # Scale queries\n        q = q / (self.head_dim ** 0.5)\n\n        # Compute content-based attention scores\n        attn_content = torch.matmul(q, k.transpose(-2, -1))  # [B, num_heads, L, L]\n\n        # Compute relative position embeddings for keys\n        rel_pos_mat = self._generate_relative_positions_matrix(seq_len)  # [L, L]\n        rel_pos_emb = self.rel_pos_emb(rel_pos_mat)  # [L, L, head_dim]\n\n        # For relative position attention scores, we need to do batched matmul between q and rel_pos_emb\n        # q: [B, num_heads, L, head_dim]\n        # rel_pos_emb: [L, L, head_dim] -> need to reshape for matmul\n        # We transpose rel_pos_emb to [L, head_dim, L] to multiply with q\n\n        # We\'ll do einsum: attn_pos[b,h,i,j] = sum_d q[b,h,i,d] * rel_pos_emb[i,j,d]\n        attn_pos = torch.einsum(\'bhid,ijd->bhij\', q, rel_pos_emb)  # [B, num_heads, L, L]\n\n        attn = attn_content + attn_pos\n\n        # Mask positions: pad_mask is True where padding, so mask out attention to those positions\n        if pad_mask is not None:\n            # pad_mask: [B, L], we want to mask keys dimension\n            mask = pad_mask.unsqueeze(1).unsqueeze(2)  # [B,1,1,L]\n            attn = attn.masked_fill(mask, float(\'-inf\'))\n\n        attn_weights = F.softmax(attn, dim=-1)  # [B, num_heads, L, L]\n        attn_weights = self.dropout(attn_weights)\n\n        out = torch.matmul(attn_weights, v)  # [B, num_heads, L, head_dim]\n\n        out = out.transpose(1, 2).contiguous().view(batch_size, seq_len, self.embedding_dim)\n\n        out = self.out_proj(out)\n\n        return out\n\n\nclass BottleneckFeedForwardPreLayerNorm(nn.Module):\n    """\n    FeedForward network with pre-layernorm and a deeper bottleneck structure:\n    1x1 linear to reduce dimension, non-linearity, then 1x1 linear to expand back.\n    """\n\n    def __init__(self, input_dim, bottleneck_dim, dropout_p=0.1, eps=1e-5):\n        super().__init__()\n        self.layer_norm = nn.LayerNorm(input_dim, eps=eps)\n        self.reduce_linear = nn.Linear(input_dim, bottleneck_dim)\n        self.activation = nn.GELU()\n        self.expand_linear = nn.Linear(bottleneck_dim, input_dim)\n        self.dropout = nn.Dropout(dropout_p)\n\n    def forward(self, x):\n        x_norm = self.layer_norm(x)\n        x_reduced = self.reduce_linear(x_norm)\n        x_activated = self.activation(x_reduced)\n        x_expanded = self.expand_linear(x_activated)\n        return self.dropout(x_expanded)\n\n\nclass TransformerEncoderLayer(nn.Module):\n    """\n    One transformer encoder layer combining attention with relative position encoding and \n    a deeper bottleneck feed-forward network with residuals.\n    """\n\n    def __init__(self, embedding_dim=192, num_heads=6, ff_hidden_dim=768, dropout=0.1, eps=1e-5):\n        super().__init__()\n        # Replace original attention with relative position attention\n        self.attn = RelativePositionMultiheadSelfAttention(embedding_dim=embedding_dim, num_heads=num_heads, dropout=dropout)\n        self.attn_dropout = nn.Dropout(p=dropout)\n        # Use bottleneck feed-forward: bottleneck_dim chosen smaller than ff_hidden_dim for efficiency\n        bottleneck_dim = ff_hidden_dim // 4  # typical bottleneck ratio\n        self.ffn = BottleneckFeedForwardPreLayerNorm(input_dim=embedding_dim, bottleneck_dim=bottleneck_dim, dropout_p=dropout, eps=eps)\n        self.ffn_dropout = nn.Dropout(p=dropout)\n\n    def forward(self, x: torch.Tensor, pad_mask: torch.Tensor) -> torch.Tensor:\n        """\n        Forward pass:\n\n          attn_out = attn(x, pad_mask)\n          x = x + Dropout(attn_out)\n          ffn_out = ffn(x)\n          x = x + Dropout(ffn_out)\n\n        Args:\n            x: [batch_size, seq_len, embedding_dim]\n            pad_mask: [batch_size, seq_len] boolean mask\n\n        Returns:\n            x: [batch_size, seq_len, embedding_dim]\n        """\n        attn_out = self.attn(x, pad_mask)\n        attn_out = self.attn_dropout(attn_out)\n        x = x + attn_out\n\n        ffn_out = self.ffn(x)\n        ffn_out = self.ffn_dropout(ffn_out)\n        x = x + ffn_out\n\n        return x\n\n\nclass TransformerEncoderStack(nn.Module):\n    """\n    Stack of TransformerEncoderLayer modules with weight sharing to reduce parameters,\n    inspired by ALBERT\'s parameter sharing technique.\n    """\n\n    def __init__(self, num_layers=4, embedding_dim=192, num_heads=6, ff_hidden_dim=768, dropout=0.1, eps=1e-5):\n        super().__init__()\n        # Instantiate only one shared TransformerEncoderLayer and reuse it\n        self.shared_layer = TransformerEncoderLayer(\n            embedding_dim=embedding_dim,\n            num_heads=num_heads,\n            ff_hidden_dim=ff_hidden_dim,\n            dropout=dropout,\n            eps=eps,\n        )\n        self.num_layers = int(num_layers)\n\n    def forward(self, x: torch.Tensor, pad_mask: torch.Tensor) -> torch.Tensor:\n        """\n        Sequentially applies the same encoder layer multiple times (weight sharing).\n\n        Args:\n            x: [batch_size, seq_len, embedding_dim]\n            pad_mask: [batch_size, seq_len] boolean mask\n\n        Returns:\n            x: [batch_size, seq_len, embedding_dim]\n        """\n        for _ in range(self.num_layers):\n            x = self.shared_layer(x, pad_mask)\n        return x\n\n\ndef encoder_layer_stacking_and_residuals(\n    num_layers: int = 4,\n    embedding_dim: int = 192,\n    num_heads: int = 6,\n    ff_hidden_dim: int = 768,\n    dropout: float = 0.1,\n    eps: float = 1e-5,\n) -> TransformerEncoderStack:\n    """\n    Factory to create the stacked transformer encoder.\n    """\n    return TransformerEncoderStack(\n        num_layers=num_layers,\n        embedding_dim=embedding_dim,\n        num_heads=num_heads,\n        ff_hidden_dim=ff_hidden_dim,\n        dropout=dropout,\n        eps=eps,\n    )\n\n\n\n'}, {'role': 'assistant', 'content': '', 'tool_calls': [{'id': 'call_9z5Ajg6vWW79dR4X0ITsWJx0', 'type': 'function', 'function': {'name': 'read_file', 'arguments': '{"file_path":"sequence_encoder_architecture/masked_mean_pooling_and_classifier_head.py"}'}}]}, {'role': 'tool', 'tool_call_id': 'call_9z5Ajg6vWW79dR4X0ITsWJx0', 'name': 'read_file', 'content': 'import sys\nimport os\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.abspath(os.path.join(current_dir, ".."))\nsys.path.append(project_root)\n"""\nModule: masked_mean_pooling_and_classifier_head\n\nDescription:\n    Implements masked mean pooling to aggregate transformer outputs over non-PAD token positions,\n    followed by a fully connected linear classifier mapping the pooled sequence representation to\n    class logits. Classifier weights are initialized with Xavier uniform and bias set to zero.\n\nUsage:\n    classifier = masked_mean_pooling_and_classifier_head(embedding_dim=192, num_classes=8)\n    logits = classifier(transformer_outputs, pad_mask)\n    - transformer_outputs: torch.Tensor [batch_size, seq_len, embedding_dim]\n    - pad_mask: torch.BoolTensor [batch_size, seq_len], True indicates PAD tokens\n"""\n\nfrom typing import Tuple\nimport torch\nimport torch.nn as nn\n\n\nclass MaskedMeanPoolingClassifier(nn.Module):\n    """\n    Masked mean pooling and classifier head.\n\n    Args:\n        embedding_dim: Dimension of pooled sequence representation.\n        num_classes: Number of output classes.\n    """\n\n    def __init__(self, embedding_dim: int, num_classes: int):\n        super().__init__()\n        self.embedding_dim = int(embedding_dim)\n        self.num_classes = int(num_classes)\n        self.classifier = nn.Linear(self.embedding_dim, self.num_classes)\n        # Xavier uniform initialization for weights\n        nn.init.xavier_uniform_(self.classifier.weight)\n        # Zero initialize bias\n        if self.classifier.bias is not None:\n            nn.init.zeros_(self.classifier.bias)\n\n    def forward(self, x: torch.Tensor, pad_mask: torch.Tensor) -> torch.Tensor:\n        """\n        Applies masked mean pooling and classification.\n\n        Args:\n            x: [batch_size, seq_len, embedding_dim] transformer output (float tensor).\n            pad_mask: [batch_size, seq_len] boolean mask (True for PAD positions).\n\n        Returns:\n            logits: [batch_size, num_classes] tensor.\n        """\n        # Validate dimensions minimally\n        if x.dim() != 3:\n            raise ValueError(f"x must be [batch_size, seq_len, embedding_dim], got shape {tuple(x.shape)}")\n        if pad_mask.dim() != 2:\n            raise ValueError(f"pad_mask must be [batch_size, seq_len], got shape {tuple(pad_mask.shape)}")\n        if x.size(0) != pad_mask.size(0) or x.size(1) != pad_mask.size(1):\n            raise ValueError("pad_mask must match the batch and sequence dimensions of x")\n\n        # Invert pad_mask: valid positions are where pad_mask is False\n        # Convert to float on the same device as x for computation\n        valid_mask = (~pad_mask).to(dtype=x.dtype, device=x.device)  # shape [B, L], 1.0 for valid tokens\n\n        # Sum embeddings over valid positions\n        sum_embeddings = (x * valid_mask.unsqueeze(-1)).sum(dim=1)  # [B, D]\n\n        # Count valid (non-PAD) tokens per sequence, clamp to min=1 to avoid division by zero\n        valid_counts = valid_mask.sum(dim=1).clamp(min=1).unsqueeze(-1)  # [B, 1]\n\n        # Mean pooling\n        pooled = sum_embeddings / valid_counts  # [B, D]\n\n        # Classifier to produce logits\n        logits = self.classifier(pooled)  # [B, num_classes]\n        return logits\n\n\ndef masked_mean_pooling_and_classifier_head(embedding_dim: int, num_classes: int) -> MaskedMeanPoolingClassifier:\n    """\n    Factory to instantiate the MaskedMeanPoolingClassifier.\n\n    Args:\n        embedding_dim: Dimension of pooled representations.\n        num_classes: Number of classes.\n\n    Returns:\n        MaskedMeanPoolingClassifier instance.\n    """\n    return MaskedMeanPoolingClassifier(embedding_dim=embedding_dim, num_classes=num_classes)\n\n\n\n'}, {'role': 'assistant', 'content': '', 'tool_calls': [{'id': 'call_aZ13VOMChPVpHGxS5AIzWwMR', 'type': 'function', 'function': {'name': 'read_file', 'arguments': '{"file_path":"training_evaluation_pipeline/setup_optim_scheduler_amp.py"}'}}]}, {'role': 'tool', 'tool_call_id': 'call_aZ13VOMChPVpHGxS5AIzWwMR', 'name': 'read_file', 'content': 'import sys\nimport os\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.abspath(os.path.join(current_dir, ".."))\nsys.path.append(project_root)\n"""\nModule: setup_optim_scheduler_amp\n\nDescription:\n    Configures optimizer (AdamW), cosine learning rate scheduler with linear warmup,\n    AMP GradScaler for mixed precision, and enforces reproducibility settings\n    (global seeds and cuDNN deterministic flags).\n\nUsage:\n    setup = setup_optim_scheduler_amp(model.parameters(), epochs=40, steps_per_epoch=100, seed=42)\n    optimizer = setup.optimizer\n    scheduler = setup.scheduler\n    scaler = setup.scaler\n"""\n\nfrom typing import Iterable\nimport math\nimport numpy as np\nimport torch\nfrom torch.optim import AdamW\nfrom torch.optim.lr_scheduler import LambdaLR\n\n\nclass TrainingSetup:\n    """\n    Container for optimizer, scheduler, and AMP scaler.\n\n    Attributes:\n        optimizer: AdamW optimizer instance.\n        scheduler: Learning rate scheduler instance (LambdaLR).\n        scaler: torch.cuda.amp.GradScaler instance for mixed precision.\n    """\n\n    def __init__(self, optimizer: torch.optim.Optimizer, scheduler: LambdaLR, scaler: torch.cuda.amp.GradScaler):\n        self.optimizer = optimizer\n        self.scheduler = scheduler\n        self.scaler = scaler\n\n\ndef setup_optim_scheduler_amp(\n    model_params: Iterable,\n    epochs: int,\n    steps_per_epoch: int,\n    seed: int = 42,\n    lr: float = 2e-4,\n    weight_decay: float = 0.01,\n    warmup_epochs: int = 4,\n) -> TrainingSetup:\n    """\n    Configures optimizer, LR scheduler (cosine with linear warmup), AMP GradScaler, and reproducibility flags.\n\n    Args:\n        model_params: Iterable of model parameters to optimize.\n        epochs: Total number of training epochs.\n        steps_per_epoch: Number of steps (batches) per epoch.\n        seed: Random seed for reproducibility (default 42).\n        lr: Initial learning rate (default 2e-4).\n        weight_decay: Weight decay for AdamW (default 0.01).\n        warmup_epochs: Number of warmup epochs (default 4).\n\n    Returns:\n        TrainingSetup: Container with optimizer, scheduler, and AMP GradScaler.\n    """\n    # Enforce reproducibility globally\n    seed_int = int(seed)\n    torch.manual_seed(seed_int)\n    # Seed all CUDA devices if available; safe to call regardless\n    try:\n        torch.cuda.manual_seed_all(seed_int)\n    finally:\n        # Ensure cuDNN flags set deterministically; do not suppress exceptions from torch if any\n        torch.backends.cudnn.deterministic = True\n        torch.backends.cudnn.benchmark = False\n\n    # Instantiate AdamW optimizer\n    optimizer = AdamW(params=model_params, lr=float(lr), weight_decay=float(weight_decay))\n\n    # Compute total and warmup steps (ensure at least 1 to avoid division by zero)\n    epochs_int = max(1, int(epochs))\n    steps_per_epoch_int = max(1, int(steps_per_epoch))\n    total_steps = epochs_int * steps_per_epoch_int\n    warmup_steps = max(0, int(warmup_epochs) * steps_per_epoch_int)\n\n    # Define lr lambda function for LambdaLR\n    def lr_lambda(current_step: int) -> float:\n        """\n        Returns multiplicative factor for learning rate given current_step (0-based).\n        Implements linear warmup followed by cosine decay to zero.\n        """\n        if current_step < 0:\n            return 0.0\n        if warmup_steps > 0 and current_step < warmup_steps:\n            return float(current_step) / float(max(1, warmup_steps))\n        # After warmup\n        if total_steps <= warmup_steps:\n            # Degenerate case: no decay period, return 1.0 after warmup\n            return 1.0\n        progress = float(current_step - warmup_steps) / float(max(1, total_steps - warmup_steps))\n        # Clamp progress to [0,1]\n        if progress < 0.0:\n            progress = 0.0\n        if progress > 1.0:\n            progress = 1.0\n        return 0.5 * (1.0 + math.cos(math.pi * progress))\n\n    # Instantiate LambdaLR scheduler (multiplicative factor applied to optimizer.lr)\n    scheduler = LambdaLR(optimizer=optimizer, lr_lambda=lr_lambda)\n\n    # Instantiate AMP GradScaler for mixed precision\n    scaler = torch.cuda.amp.GradScaler()\n\n    return TrainingSetup(optimizer=optimizer, scheduler=scheduler, scaler=scaler)\n\n\n\n'}, {'role': 'assistant', 'content': '', 'tool_calls': [{'id': 'call_OFW8m7Dtb3lwr2I2J4iqdfwm', 'type': 'function', 'function': {'name': 'read_file', 'arguments': '{"file_path":"training_evaluation_pipeline/train_loop_with_early_stopping.py"}'}}]}, {'role': 'tool', 'tool_call_id': 'call_OFW8m7Dtb3lwr2I2J4iqdfwm', 'name': 'read_file', 'content': 'import sys\nimport os\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.abspath(os.path.join(current_dir, ".."))\nsys.path.append(project_root)\n"""\nModule: epoch_train_pass\n\nDescription:\n    Executes a single training epoch pass with deterministic behavior, mixed precision (AMP),\n    Class-Balanced Focal Loss, gradient clipping, and per-batch LR scheduler stepping.\n\nFunction:\n    epoch_train_pass(model, train_loader, loss_fn, optimizer, scheduler, scaler, device) -> float\n\nNotes:\n    - The function uses torch.cuda.amp for mixed precision when running on CUDA.\n    - Gradients are clipped with max_norm=1.0 via torch.nn.utils.clip_grad_norm_.\n    - Scheduler.step() is called once per optimizer step (per batch).\n    - All tensors are moved to the provided device.\n    - Returns average epoch loss (0.0 if no batches processed).\n"""\n\nfrom typing import Tuple\nimport torch\n\n\ndef epoch_train_pass(\n    model: torch.nn.Module,\n    train_loader: torch.utils.data.DataLoader,\n    loss_fn: torch.nn.Module,\n    optimizer: torch.optim.Optimizer,\n    scheduler: torch.optim.lr_scheduler._LRScheduler,\n    scaler: torch.cuda.amp.GradScaler,\n    device: torch.device,\n) -> float:\n    """\n    Executes a single training epoch with mixed precision, CB-Focal loss, LR scheduling,\n    and a novel class embedding distance based dynamic sample resampling strategy,\n    integrated with center-based fine-grained class balance loss weighting.\n\n    This method enhances training by selectively repeating samples from tail/edge classes\n    and classes that are close neighbors in the embedding space to improve discriminability,\n    macro accuracy, and dynamically adapts loss weights based on per-class feature centroid drift.\n\n    Args:\n        model: PyTorch model. Expected to accept (tokens, attention_mask) in forward().\n        train_loader: DataLoader yielding (tokens, attention_mask, labels) tuples.\n        loss_fn: Loss module (ClassBalancedFocalLoss) supporting set_alpha_gamma(alpha, gamma).\n        optimizer: Optimizer (AdamW).\n        scheduler: Learning rate scheduler (LambdaLR or similar).\n        scaler: torch.cuda.amp.GradScaler for mixed precision.\n        device: Target torch.device (\'cuda\' or \'cpu\').\n\n    Returns:\n        Average epoch loss (float).\n    """\n    import numpy as np\n    from collections import defaultdict\n\n    model.train()\n    running_loss = 0.0\n    batch_count = 0\n\n    use_amp = (device.type == "cuda")\n\n    # Infer number of classes if not provided by loss_fn\n    num_classes = getattr(loss_fn, \'num_classes\', None)\n    if num_classes is None:\n        try:\n            sample_batch = next(iter(train_loader))\n            tokens, attention_mask, _ = sample_batch\n            tokens = tokens.to(device, non_blocking=True)\n            attention_mask = attention_mask.to(device, non_blocking=True)\n            with torch.no_grad():\n                model.eval()\n                with torch.cuda.amp.autocast(enabled=use_amp):\n                    logits_sample = model(tokens, attention_mask)\n                model.train()\n            num_classes = logits_sample.shape[-1]\n        except Exception:\n            raise ValueError("Cannot determine number of classes from loss_fn or model output.")\n\n    # Initialize alpha and gamma as tensors on device\n    alpha = torch.full((num_classes,), 0.25, device=device, dtype=torch.float32)\n    gamma = torch.full((num_classes,), 2.0, device=device, dtype=torch.float32)\n\n    # Parameters for dynamic adjustment of alpha and gamma\n    alpha_min, alpha_max = 0.05, 0.75\n    gamma_min, gamma_max = 0.0, 5.0\n    adjustment_rate = 0.1\n\n    # Step 1: Compute class embedding centroids by aggregating model\'s penultimate layer embeddings\n    # We assume model has a method or attribute to extract embeddings; if not, fallback to logits as proxy embeddings\n    # Here, we first collect all embeddings and labels from train_loader once for centroid computation.\n\n    embedding_list = []\n    label_list = []\n\n    # We disable grads here since it\'s only for centroid calculation\n    model.eval()\n    with torch.no_grad():\n        for batch in train_loader:\n            tokens, attention_mask, labels = batch\n            tokens = tokens.to(device, non_blocking=True)\n            attention_mask = attention_mask.to(device, non_blocking=True)\n            labels = labels.to(device, non_blocking=True)\n\n            with torch.cuda.amp.autocast(enabled=use_amp):\n                # Try to obtain embeddings from model - assume model returns tuple (logits, embeddings) if possible\n                output = model(tokens, attention_mask)\n                if isinstance(output, tuple) and len(output) == 2:\n                    logits_batch, embeddings_batch = output\n                else:\n                    # If not available, use logits as embeddings proxy (detach to avoid grads)\n                    embeddings_batch = output.detach()\n            embedding_list.append(embeddings_batch.cpu())\n            label_list.append(labels.cpu())\n    model.train()\n\n    all_embeddings = torch.cat(embedding_list, dim=0)  # (N, D)\n    all_labels = torch.cat(label_list, dim=0)          # (N,)\n\n    # Compute centroid per class in embedding space\n    class_centroids = torch.zeros((num_classes, all_embeddings.size(1)), dtype=torch.float32)\n    class_counts = torch.zeros(num_classes, dtype=torch.int64)\n    for c in range(num_classes):\n        mask = (all_labels == c)\n        if mask.sum() > 0:\n            class_centroids[c] = all_embeddings[mask].mean(dim=0)\n            class_counts[c] = mask.sum()\n        else:\n            # For classes with no samples just keep zero centroid\n            class_centroids[c] = torch.zeros(all_embeddings.size(1))\n\n    # Store centroids for next epoch to compute centroid drift; use a static attribute to persist\n    if not hasattr(epoch_train_pass, "_prev_centroids"):\n        epoch_train_pass._prev_centroids = class_centroids.clone()\n    prev_centroids = epoch_train_pass._prev_centroids\n    centroid_shifts = torch.norm(class_centroids - prev_centroids, dim=1)  # (num_classes,)\n    epoch_train_pass._prev_centroids = class_centroids.clone()\n\n    # Normalize centroid shifts to [0,1]\n    if centroid_shifts.max() - centroid_shifts.min() > 1e-12:\n        normalized_centroid_shifts = (centroid_shifts - centroid_shifts.min()) / (centroid_shifts.max() - centroid_shifts.min())\n    else:\n        normalized_centroid_shifts = torch.zeros_like(centroid_shifts)\n\n    # Compute pairwise distance matrix between class centroids (Euclidean)\n    centroids_np = class_centroids.numpy()\n    from scipy.spatial.distance import cdist\n    dist_matrix = cdist(centroids_np, centroids_np, metric=\'euclidean\')  # shape (num_classes, num_classes)\n    # Zero diagonal, distance to self is 0\n\n    # Identify tail classes: classes with sample count below median\n    median_count = class_counts.median().item()\n    tail_classes = (class_counts < median_count).nonzero(as_tuple=False).view(-1).tolist()\n\n    # For each class, find k nearest neighbor classes (excluding itself)\n    k_neighbors = 2  # hyperparameter: how many neighbors to consider\n    neighbors_dict = {}\n    for c in range(num_classes):\n        distances = dist_matrix[c]\n        # Exclude self distance by setting it to large number\n        distances[c] = np.inf\n        nearest_idx = np.argsort(distances)[:k_neighbors]\n        neighbors_dict[c] = nearest_idx.tolist()\n\n    # Define sampling weights per class based on:\n    # - Tail class gets higher weight\n    # - Classes that are neighbors to tail classes get medium weight\n    # - Others get base weight\n    base_weight = 1.0\n    tail_weight = 3.0\n    neighbor_weight = 2.0\n\n    sample_weights_per_class = np.full(num_classes, base_weight, dtype=np.float32)\n\n    # Mark tail classes weight\n    for c in tail_classes:\n        sample_weights_per_class[c] = tail_weight\n\n    # Mark neighbors of tail classes\n    tail_neighbors = set()\n    for c in tail_classes:\n        tail_neighbors.update(neighbors_dict[c])\n    # Remove tail classes themselves from neighbors set\n    tail_neighbors.difference_update(tail_classes)\n    for c in tail_neighbors:\n        sample_weights_per_class[c] = max(sample_weights_per_class[c], neighbor_weight)\n\n    # Build a map from class to weight tensor on device\n    sample_weights_per_class_tensor = torch.from_numpy(sample_weights_per_class).to(device)\n\n    # Step 2: Perform weighted resampling of dataset indices according to sample_weights_per_class\n    # To do this, first collect all indices and labels from train_loader.dataset\n    # We assume train_loader.dataset supports indexing and __len__ and provides labels accessible via attribute or indexing\n\n    # Attempt to extract labels from dataset:\n    dataset = train_loader.dataset\n    # Try several common ways to get labels:\n    # 1) dataset.labels\n    # 2) dataset.tensors[2] (if TensorDataset)\n    # 3) dataset.get_labels() method\n    # 4) else fallback to iterating entire dataset (slow but safe)\n    try:\n        if hasattr(dataset, \'labels\'):\n            dataset_labels = dataset.labels\n            if isinstance(dataset_labels, torch.Tensor):\n                dataset_labels = dataset_labels.cpu().numpy()\n            elif isinstance(dataset_labels, list):\n                dataset_labels = np.array(dataset_labels)\n        elif hasattr(dataset, \'tensors\') and len(dataset.tensors) >= 3:\n            dataset_labels = dataset.tensors[2].cpu().numpy()\n        elif hasattr(dataset, \'get_labels\') and callable(dataset.get_labels):\n            dataset_labels = np.array(dataset.get_labels())\n        else:\n            # Fallback: iterate dataset fully to collect labels\n            dataset_labels = []\n            for i in range(len(dataset)):\n                item = dataset[i]\n                if isinstance(item, (tuple, list)) and len(item) >= 3:\n                    dataset_labels.append(item[2])\n                else:\n                    raise RuntimeError("Dataset items do not have label at index 2")\n            dataset_labels = np.array(dataset_labels)\n    except Exception:\n        raise RuntimeError("Failed to extract labels from dataset for resampling")\n\n    # Compute sample weights for all samples according to their class\n    sample_weights = sample_weights_per_class[dataset_labels]  # shape (N,)\n\n    # Normalize weights to probabilities\n    prob_weights = sample_weights / sample_weights.sum()\n\n    # Number of samples to draw: same as original dataset size\n    num_samples = len(dataset)\n\n    # Draw indices with replacement according to prob_weights\n    sampled_indices_np = np.random.choice(num_samples, size=num_samples, replace=True, p=prob_weights)\n    sampled_indices = torch.tensor(sampled_indices_np, dtype=torch.long)\n\n    # Step 3: Create a new DataLoader with resampled indices for this epoch\n    # We reuse train_loader.collate_fn, batch_size, and other settings\n\n    # Construct a Subset of dataset with sampled indices that repeats samples accordingly\n    from torch.utils.data import Subset, DataLoader\n\n    resampled_dataset = Subset(dataset, sampled_indices)\n\n    # Construct a DataLoader with same batch size, collate_fn, shuffle=False (already random by resampling)\n    epoch_train_loader = DataLoader(\n        resampled_dataset,\n        batch_size=train_loader.batch_size,\n        shuffle=False,\n        num_workers=train_loader.num_workers if hasattr(train_loader, \'num_workers\') else 0,\n        pin_memory=train_loader.pin_memory if hasattr(train_loader, \'pin_memory\') else False,\n        collate_fn=train_loader.collate_fn if hasattr(train_loader, \'collate_fn\') else None,\n        drop_last=False,\n    )\n\n    # For per-class alpha/gamma adjustment, maintain running stats\n    # Re-initialize alpha and gamma for this epoch\n    alpha = torch.full((num_classes,), 0.25, device=device, dtype=torch.float32)\n    gamma = torch.full((num_classes,), 2.0, device=device, dtype=torch.float32)\n\n    class_correct_accum = torch.zeros(num_classes, device=device, dtype=torch.float32)\n    class_count_accum = torch.zeros(num_classes, device=device, dtype=torch.float32)\n\n    # Additional tensor to accumulate centroid-shift based hardness per class\n    # We\'ll combine this hardness with accuracy-based hardness to modulate alpha/gamma\n    centroid_shift_hardness = normalized_centroid_shifts.to(device)\n\n    for batch in epoch_train_loader:\n        tokens, attention_mask, labels = batch\n\n        tokens = tokens.to(device, non_blocking=True)\n        attention_mask = attention_mask.to(device, non_blocking=True)\n        labels = labels.to(device, non_blocking=True)\n\n        optimizer.zero_grad()\n\n        # Update loss_fn\'s alpha and gamma parameters dynamically before forward\n        if hasattr(loss_fn, "set_alpha_gamma"):\n            loss_fn.set_alpha_gamma(alpha, gamma)\n        else:\n            if hasattr(loss_fn, "alpha"):\n                loss_fn.alpha = alpha\n            if hasattr(loss_fn, "gamma"):\n                loss_fn.gamma = gamma\n\n        if use_amp:\n            with torch.cuda.amp.autocast():\n                logits = model(tokens, attention_mask)\n                loss = loss_fn(logits, labels)\n        else:\n            logits = model(tokens, attention_mask)\n            loss = loss_fn(logits, labels)\n\n        scaler.scale(loss).backward()\n        scaler.unscale_(optimizer)\n        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n        scaler.step(optimizer)\n        scaler.update()\n        scheduler.step()\n\n        running_loss += float(loss.item())\n        batch_count += 1\n\n        # Calculate per-class accuracy or loss to adjust alpha/gamma\n        with torch.no_grad():\n            preds = torch.argmax(logits, dim=1)\n            labels_one_hot = torch.nn.functional.one_hot(labels, num_classes=num_classes).float()\n            preds_one_hot = torch.nn.functional.one_hot(preds, num_classes=num_classes).float()\n\n            class_correct = (preds_one_hot * labels_one_hot).sum(dim=0)  # (C,)\n            class_counts = labels_one_hot.sum(dim=0)  # (C,)\n\n            class_correct_accum += class_correct.to(device)\n            class_count_accum += class_counts.to(device)\n\n            # Avoid division by zero\n            safe_counts = torch.where(class_count_accum == 0, torch.ones_like(class_count_accum), class_count_accum)\n            class_acc = class_correct_accum / safe_counts  # (C,)\n\n            # Accuracy-based hardness\n            acc_hardness = 1.0 - class_acc\n            acc_hardness = (acc_hardness - acc_hardness.min()) / (acc_hardness.max() - acc_hardness.min() + 1e-12)\n\n            # Combine accuracy hardness and centroid shift hardness (weighted sum)\n            # Weights can be tuned; here equal weight is used\n            combined_hardness = 0.5 * acc_hardness + 0.5 * centroid_shift_hardness\n            combined_hardness = (combined_hardness - combined_hardness.min()) / (combined_hardness.max() - combined_hardness.min() + 1e-12)\n\n            new_alpha = alpha + adjustment_rate * (alpha_min + combined_hardness * (alpha_max - alpha_min) - alpha)\n            new_gamma = gamma + adjustment_rate * (gamma_min + combined_hardness * (gamma_max - gamma_min) - gamma)\n\n            alpha = torch.clamp(new_alpha, alpha_min, alpha_max)\n            gamma = torch.clamp(new_gamma, gamma_min, gamma_max)\n\n    if batch_count == 0:\n        return 0.0\n    return running_loss / batch_count\n\n\n\nimport sys\nimport os\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.abspath(os.path.join(current_dir, ".."))\nsys.path.append(project_root)\n"""\nModule: epoch_validation_pass\n\nDescription:\n    Performs deterministic evaluation on a validation DataLoader. The function:\n      - sets model to eval mode,\n      - forwards batches without token dropout,\n      - applies inference-time logit adjustment (log-prior subtraction),\n      - computes per-class accuracies and macro accuracy,\n      - updates early stopping counters based on macro accuracy.\n\nUsage:\n    metrics = epoch_validation_pass(\n        model,\n        val_loader,\n        logit_adjuster,\n        device,\n        num_classes,\n        best_macro_acc,\n        patience_counter,\n        patience=10\n    )\n"""\n\nfrom typing import Dict\nimport numpy as np\nimport torch\n\n\nclass ValidationMetrics:\n    """\n    Container for validation metrics and early stopping status.\n\n    Attributes:\n        per_class_acc: Dict[int, float] mapping class index -> accuracy.\n        macro_acc: float, mean of per-class accuracies.\n        is_best: bool, True if macro_acc improved over best_macro_acc.\n        patience_counter: int, updated patience counter.\n    """\n\n    def __init__(self, per_class_acc: Dict[int, float], macro_acc: float, is_best: bool, patience_counter: int):\n        self.per_class_acc = per_class_acc\n        self.macro_acc = macro_acc\n        self.is_best = is_best\n        self.patience_counter = patience_counter\n\n    def __repr__(self) -> str:\n        return (\n            f"ValidationMetrics(macro_acc={self.macro_acc:.6f}, is_best={self.is_best}, "\n            f"patience_counter={self.patience_counter}, per_class_acc_keys={list(self.per_class_acc.keys())})"\n        )\n\n\ndef epoch_validation_pass(\n    model: torch.nn.Module,\n    val_loader: torch.utils.data.DataLoader,\n    logit_adjuster,\n    device: torch.device,\n    num_classes: int,\n    best_macro_acc: float,\n    patience_counter: int,\n    patience: int = 10,\n) -> ValidationMetrics:\n    """\n    Evaluates model on validation set, computes per-class and macro accuracy, manages early stopping.\n\n    Args:\n        model: PyTorch model. Expected to accept (tokens, attention_mask) in forward().\n        val_loader: DataLoader yielding (tokens, attention_mask, labels) tuples.\n        logit_adjuster: Object with .adjust(logits: torch.Tensor) -> torch.Tensor.\n        device: Target device for computation.\n        num_classes: Number of classes (int).\n        best_macro_acc: Current best macro accuracy (float).\n        patience_counter: Current patience counter (int).\n        patience: Early stopping patience (default 10).\n\n    Returns:\n        ValidationMetrics: Object with per-class accuracies, macro accuracy, is_best flag, updated patience counter.\n    """\n    model.eval()\n\n    # Initialize counters\n    correct_counts = np.zeros(int(num_classes), dtype=np.int64)\n    total_counts = np.zeros(int(num_classes), dtype=np.int64)\n\n    # Use AMP autocast on CUDA for potential speed; safe to use on CPU (it\'s a no-op)\n    use_amp = (device.type == "cuda")\n\n    with torch.no_grad():\n        for batch in val_loader:\n            tokens, attention_mask, labels = batch\n            tokens = tokens.to(device, non_blocking=True)\n            attention_mask = attention_mask.to(device, non_blocking=True)\n            labels = labels.to(device, non_blocking=True)\n\n            if use_amp:\n                with torch.cuda.amp.autocast():\n                    logits = model(tokens, attention_mask)\n            else:\n                logits = model(tokens, attention_mask)\n\n            # Apply inference-time logit adjustment (subtract log priors)\n            adjusted_logits = logit_adjuster.adjust(logits)\n\n            # Predictions\n            preds = torch.argmax(adjusted_logits, dim=-1)\n\n            # Move to CPU numpy for deterministic aggregation\n            preds_np = preds.detach().cpu().numpy()\n            labels_np = labels.detach().cpu().numpy()\n\n            # Accumulate per-class totals and corrects\n            for true_label, pred_label in zip(labels_np.tolist(), preds_np.tolist()):\n                t = int(true_label)\n                p = int(pred_label)\n                if 0 <= t < num_classes:\n                    total_counts[t] += 1\n                    if p == t:\n                        correct_counts[t] += 1\n                else:\n                    # If label out-of-range, skip counting to remain robust\n                    continue\n\n    # Compute per-class accuracies safely (handle zero totals)\n    per_class_acc: Dict[int, float] = {}\n    acc_list = []\n    for cls in range(int(num_classes)):\n        total = int(total_counts[cls])\n        correct = int(correct_counts[cls])\n        if total == 0:\n            acc = 0.0\n        else:\n            acc = float(correct) / float(total)\n        per_class_acc[cls] = acc\n        acc_list.append(acc)\n\n    # Macro accuracy: mean of per-class accuracies\n    if len(acc_list) == 0:\n        macro_acc = 0.0\n    else:\n        macro_acc = float(np.mean(np.array(acc_list, dtype=float)))\n\n    # Early stopping logic\n    if macro_acc > float(best_macro_acc):\n        is_best = True\n        patience_counter = 0\n    else:\n        is_best = False\n        patience_counter = int(patience_counter) + 1\n        # Cap patience_counter to patience to avoid unbounded growth (optional)\n        if patience_counter > int(patience):\n            patience_counter = int(patience)\n\n    return ValidationMetrics(per_class_acc=per_class_acc, macro_acc=macro_acc, is_best=is_best, patience_counter=patience_counter)\n\n\n\n'}, {'role': 'assistant', 'content': '', 'tool_calls': [{'id': 'call_BwLMOepYsZHfwXEFhB4lRnPq', 'type': 'function', 'function': {'name': 'read_file', 'arguments': '{"file_path":"training_evaluation_pipeline/final_testset_evaluation_reporting.py"}'}}]}, {'role': 'tool', 'tool_call_id': 'call_BwLMOepYsZHfwXEFhB4lRnPq', 'name': 'read_file', 'content': 'import sys\nimport os\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.abspath(os.path.join(current_dir, ".."))\nsys.path.append(project_root)\n"""\nModule: final_testset_evaluation_reporting\n\nDescription:\n    Performs deterministic evaluation of a trained model on the held-out test set.\n    Applies inference-time logit adjustment (subtract log class priors), computes per-class\n    accuracies and macro accuracy, prints results, and returns a TestSetEvaluationReport.\n\nConstraints:\n    - Deterministic computation using provided class priors from training split.\n    - No model updates; no random operations during evaluation.\n    - Uses torch.no_grad and torch.cuda.amp.autocast for deterministic, efficient evaluation.\n"""\n\nfrom typing import Dict\nimport numpy as np\nimport torch\n\n\nclass TestSetEvaluationReport:\n    """\n    Container for test set evaluation metrics.\n\n    Attributes:\n        per_class_acc: Dict mapping class index to accuracy (float).\n        macro_acc: Macro accuracy (float).\n    """\n\n    def __init__(self, per_class_acc: Dict[int, float], macro_acc: float):\n        self.per_class_acc = per_class_acc\n        self.macro_acc = macro_acc\n\n    def __repr__(self) -> str:\n        return f"TestSetEvaluationReport(macro_acc={self.macro_acc:.6f}, num_classes={len(self.per_class_acc)})"\n\n\ndef final_testset_evaluation_reporting(\n    model: torch.nn.Module,\n    test_loader: torch.utils.data.DataLoader,\n    logit_adjuster,\n    device: torch.device,\n    num_classes: int,\n) -> TestSetEvaluationReport:\n    """\n    Evaluates model on held-out test set, computes and prints per-class and macro accuracy.\n\n    Args:\n        model: Trained PyTorch model. Expected to accept (tokens, attention_mask) in forward().\n        test_loader: DataLoader yielding (tokens, attention_mask, labels) tuples for the test split.\n        logit_adjuster: LogitAdjustment-like object with .adjust(logits: torch.Tensor) -> torch.Tensor.\n        device: Target torch.device for computation.\n        num_classes: Number of classes (int).\n\n    Returns:\n        TestSetEvaluationReport: Object containing per-class accuracies and macro accuracy.\n    """\n    model.eval()\n\n    correct_counts = np.zeros(int(num_classes), dtype=np.int64)\n    total_counts = np.zeros(int(num_classes), dtype=np.int64)\n\n    use_amp = (device.type == "cuda")\n\n    with torch.no_grad():\n        for batch in test_loader:\n            tokens, attention_mask, labels = batch\n            tokens = tokens.to(device, non_blocking=True)\n            attention_mask = attention_mask.to(device, non_blocking=True)\n            labels = labels.to(device, non_blocking=True)\n\n            if use_amp:\n                with torch.cuda.amp.autocast():\n                    logits = model(tokens, attention_mask)\n            else:\n                logits = model(tokens, attention_mask)\n\n            # Apply deterministic inference-time logit adjustment\n            adjusted_logits = logit_adjuster.adjust(logits)\n\n            preds = torch.argmax(adjusted_logits, dim=-1)\n\n            preds_np = preds.detach().cpu().numpy()\n            labels_np = labels.detach().cpu().numpy()\n\n            for true_label, pred_label in zip(labels_np.tolist(), preds_np.tolist()):\n                t = int(true_label)\n                p = int(pred_label)\n                if 0 <= t < num_classes:\n                    total_counts[t] += 1\n                    if p == t:\n                        correct_counts[t] += 1\n                else:\n                    # Skip out-of-range labels deterministically\n                    continue\n\n    per_class_acc: Dict[int, float] = {}\n    acc_list = []\n    for cls in range(int(num_classes)):\n        total = int(total_counts[cls])\n        correct = int(correct_counts[cls])\n        if total == 0:\n            acc = 0.0\n        else:\n            acc = float(correct) / float(total)\n        per_class_acc[cls] = acc\n        acc_list.append(acc)\n\n    if len(acc_list) == 0:\n        macro_acc = 0.0\n    else:\n        macro_acc = float(np.mean(np.array(acc_list, dtype=float)))\n\n    # Print deterministic summary\n    print("Test set evaluation summary:")\n    for cls in sorted(per_class_acc.keys()):\n        print(f"  Class {cls}: accuracy = {per_class_acc[cls]:.6f} (count = {int(total_counts[cls])})")\n    print(f"\\nMacro accuracy: {macro_acc:.6f}")\n\n    return TestSetEvaluationReport(per_class_acc=per_class_acc, macro_acc=macro_acc)\n\n\n\n'}], 'model': 'gpt-4.1-mini', 'temperature': 0.2, 'tools': [{'type': 'function', 'function': {'name': 'read_file', 'description': 'Read the content of a file under the project root directory. Only relative paths are allowed.', 'parameters': {'type': 'object', 'properties': {'file_path': {'type': 'string', 'description': "The relative path to the target 
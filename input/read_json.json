{
  "name": "read_json",
  "description": "异步读取本地 JSON 文件并解析为对象，适合加载结构化配置或数据",
  "long_running": false,
  "module": "utils.input_utils",
  "function": "read_json",
  "async": true,
  "parameters": {
    "type": "object",
    "required": ["path"],
    "properties": {
      "path": { "type": "string", "description": "JSON 文件路径（绝对路径或相对路径）" }
    }
  }
}

{
  "name": "papw_build_database",
  "description": "将下载的论文 PDF 解析为 Markdown，并建立用于实验分析（experiment_vb）和章节写作（full_text_vb）的双 Chroma 向量数据库",
  "module": "utils.papw_input",
  "function": "papw_build_database",
  "async": true,
  "parameters": {
    "type": "object",
    "required": ["papw_root", "bib_path"],
    "properties": {
      "papw_root":              { "type": "string",  "description": "papw 工作根目录" },
      "bib_path":               { "type": "string",  "description": "合并后的 .bib 文件路径（papw_build_references 输出）" },
      "embedding_model":        { "type": "string",  "description": "嵌入模型名称", "default": "BAAI/bge-m3" },
      "embedding_model_source": { "type": "string",  "description": "'local' 或 'api'", "default": "api" },
      "pdf_transform_mode":     { "type": "string",  "description": "PDF 解析模式 'local' 或 'api'", "default": "api" },
      "api_parsing_method":     { "type": "string",  "description": "API 解析方式 'file' 或 'url'", "default": "file" },
      "database_device":        { "type": "string",  "description": "'cpu' 或 'cuda:N'", "default": "cpu" },
      "s2_api_key":             { "type": "string",  "description": "Semantic Scholar API Key", "default": "" },
      "pdf_md_token":           { "type": "string",  "description": "MineRU PDF 解析 API Token，pdf_transform_mode 为 api 时必需", "default": "" },
      "unpaywall_email":        { "type": "string",  "description": "Unpaywall API 所需的邮箱地址，用于下载论文 PDF", "default": "" },
      "all_paper_num":          { "type": "integer", "description": "最大论文数", "default": 70 }
    }
  }
}

{
  "name": "papw_vdb_search_rerank",
  "description": "加载 Chroma VDB 并执行检索 + 重排（不含 LLM 调用）",
  "module": "utils.papw_vdb_input",
  "function": "papw_vdb_search_rerank",
  "async": true,
  "parameters": {
    "type": "object",
    "required": ["persist_directory_path", "query"],
    "properties": {
      "persist_directory_path": { "type": "string", "description": "Chroma 数据库路径" },
      "query": { "type": "string", "description": "检索查询文本" },
      "retrieval_num": { "type": "integer", "description": "检索数量", "default": 10 },
      "embedding_model": { "type": "string", "description": "嵌入模型", "default": "BAAI/bge-m3" },
      "embedding_model_source": { "type": "string", "description": "'local' 或 'api'", "default": "api" },
      "reranker_path": { "type": "string", "description": "重排模型", "default": "BAAI/bge-reranker-v2-m3" },
      "reranker_model_source": { "type": "string", "description": "'local' 或 'api'", "default": "api" },
      "database_device": { "type": "string", "description": "设备", "default": "cpu" }
    }
  }
}

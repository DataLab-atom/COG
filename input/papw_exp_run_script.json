{
  "name": "papw_exp_run_script",
  "description": "在子进程中执行 Python 脚本，返回 stdout/stderr/returncode",
  "module": "utils.papw_exp_input",
  "function": "papw_exp_run_script",
  "async": true,
  "parameters": {
    "type": "object",
    "required": ["script_content", "work_dir"],
    "properties": {
      "script_content": { "type": "string", "description": "Python 脚本内容" },
      "work_dir":       { "type": "string", "description": "脚本执行的工作目录" },
      "script_name":    { "type": "string", "description": "脚本文件名", "default": "tmp_script.py" },
      "timeout":        { "type": "integer", "description": "执行超时（秒）", "default": 300 }
    }
  }
}

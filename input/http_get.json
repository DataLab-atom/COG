{
  "name": "http_get",
  "description": "通过 HTTP GET 请求从外部 URL 获取数据，返回响应正文与状态码",
  "long_running": false,
  "module": "utils.input_utils",
  "function": "http_get",
  "async": true,
  "parameters": {
    "type": "object",
    "required": ["url"],
    "properties": {
      "url":     { "type": "string",  "description": "目标 URL，需包含协议前缀（如 https://）" },
      "headers": { "type": "object",  "description": "附加请求头，键值均为字符串", "default": {} },
      "timeout": { "type": "number",  "description": "请求超时秒数", "default": 10.0 }
    }
  }
}

{
  "name": "http_post",
  "description": "通过 HTTP POST 请求向外部服务提交数据并获取响应正文",
  "long_running": false,
  "module": "utils.input_utils",
  "function": "http_post",
  "async": true,
  "parameters": {
    "type": "object",
    "required": ["url"],
    "properties": {
      "url":     { "type": "string",  "description": "目标 URL" },
      "body":    { "type": ["string", "object"], "description": "请求正文；传 dict 自动序列化为 JSON", "default": null },
      "headers": { "type": "object",  "description": "附加请求头", "default": {} },
      "timeout": { "type": "number",  "description": "请求超时秒数", "default": 10.0 }
    }
  }
}

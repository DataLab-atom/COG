{
  "name": "u2e_mutator",
  "description": "以精英个体代码为基础，结合长期反思，生成变异后的函数 Python 实现",
  "long_running": false,
  "owned_by": "configs/u2e_mutator.json",
  "input_schema": {
    "type": "object",
    "required": ["user_generator", "reflection", "func_signature", "elitist_code", "func_name"],
    "properties": {
      "user_generator": { "type": "string", "description": "user_generator 提示词" },
      "reflection":     { "type": "string", "description": "长期反思 + 外部知识拼合字符串" },
      "func_signature": { "type": "string", "description": "目标函数签名" },
      "elitist_code":   { "type": "string", "description": "精英个体完整代码（所有函数拼合）" },
      "func_name":      { "type": "string", "description": "目标函数名" }
    }
  },
  "output_schema": {
    "type": "string",
    "description": "包含 Python 代码块（```python ... ```）的原始 LLM 响应文本"
  }
}

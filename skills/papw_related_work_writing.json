{
  "name": "papw_related_work_writing",
  "description": "相关工作章节写作：RAG 检索 + 多领域分句写作，输出 related_work.tex 及本章节 bib",
  "long_running": true,
  "owned_by": "graphs/papw_related_work_writing.json",
  "input_schema": {
    "type": "object",
    "required": ["papw_root", "full_text_vb_path", "tex_template_path"],
    "properties": {
      "papw_root": { "type": "string", "description": "papw 工作根目录" },
      "full_text_vb_path": { "type": "string", "description": "全文 Chroma DB 路径" },
      "tex_template_path": { "type": "string", "description": "LaTeX 模板路径" },
      "text_model_name": { "type": "string", "description": "文本生成模型" },
      "embedding_model": { "type": "string", "description": "嵌入模型" },
      "embedding_model_source": { "type": "string", "description": "嵌入模型来源" },
      "reranker_path": { "type": "string", "description": "重排模型" },
      "reranker_model_source": { "type": "string", "description": "重排模型来源" },
      "database_device": { "type": "string", "description": "设备" },
      "field_num": { "type": "integer", "description": "研究领域数" },
      "sentence_num": { "type": "integer", "description": "每领域句数" },
      "used_cite_num": { "type": "integer", "description": "每句引用数" },
      "used_data_num": { "type": "integer", "description": "每引用数据条数" }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "tex_path": { "type": "string", "description": "输出 tex 路径" },
      "bib_result_path": { "type": "string", "description": "输出 bib 路径" },
      "bib_result_list_path": { "type": "string", "description": "输出 bib 列表路径" }
    }
  }
}

{
  "name": "mcts_critic",
  "description": "针对指定结构算子，从项目代码中识别最优两节点改造目标并提出方向",
  "long_running": false,
  "owned_by": "configs/mcts_critic.json",
  "input_schema": {
    "type": "object",
    "required": ["op", "demand", "tree_text", "history_prompt", "baseline_log"],
    "properties": {
      "op":             { "type": "string", "description": "结构算子类型（insert/merge/decouple/split/extract/parallelize/pipeline/stratify）" },
      "demand":         { "type": "string", "description": "任务需求描述" },
      "tree_text":      { "type": "string", "description": "搜索树状态文本" },
      "history_prompt": { "type": "string", "description": "历史优化记录" },
      "baseline_log":   { "type": "string", "description": "当前最优节点的 main.py 输出" }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["node_a_file", "node_a_type", "node_a_name", "node_b_file", "node_b_type", "node_b_name", "direction", "reasoning"],
    "properties": {
      "node_a_file":  { "type": "string", "description": "主节点所在文件相对路径" },
      "node_a_type":  { "type": "string", "description": "主节点类型：function 或 class" },
      "node_a_name":  { "type": "string", "description": "主节点名称" },
      "node_b_file":  { "type": "string", "description": "次节点所在文件相对路径" },
      "node_b_type":  { "type": "string", "description": "次节点类型：function 或 class" },
      "node_b_name":  { "type": "string", "description": "次节点名称" },
      "direction":    { "type": "string", "description": "一句话结构改造方向描述" },
      "reasoning":    { "type": "string", "description": "改造理由" },
      "new_nodes": {
        "type": "array",
        "description": "insert/split/extract 算子需要新建的节点列表（可选）",
        "items": {
          "type": "object",
          "properties": {
            "name":        { "type": "string" },
            "description": { "type": "string" }
          }
        }
      }
    }
  }
}

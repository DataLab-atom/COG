{
  "name": "arch_enrich_descriptions",
  "description": "批量为无 docstring 的函数/类生成语义描述",
  "long_running": false,
  "owned_by": "configs/arch_enrich_descriptions.json",
  "input_schema": {
    "type": "object",
    "required": ["undescribed_json"],
    "properties": {
      "undescribed_json": {
        "type": "array",
        "description": "arch_extract_undescribed 返回的待补全函数列表"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "descriptions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "fn_id":       { "type": "string" },
            "description": { "type": "string" }
          }
        }
      }
    }
  }
}

{
  "name": "mcts_single_combo",
  "description": "MCTS 单个 op 算子完整评估：Critic → 拆解原子任务 → 并行 Engineer+AST → 收集 patch → 沙盒评分",
  "long_running": true,
  "owned_by": "graphs/mcts_single_combo.json",
  "input_schema": {
    "type": "object",
    "required": ["op", "demand", "tree_text", "history_prompt", "baseline_log", "project_root", "ancestor_patches", "sandbox_timeout", "tree"],
    "properties": {
      "op":               { "type": "string" },
      "demand":           { "type": "string" },
      "tree_text":        { "type": "string" },
      "history_prompt":   { "type": "string" },
      "baseline_log":     { "type": "string" },
      "project_root":     { "type": "string" },
      "ancestor_patches": { "type": "array" },
      "sandbox_timeout":  { "type": "number" },
      "tree":             { "type": "array", "description": "架构树节点列表" }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "op":       { "type": "string" },
      "proposal": { "type": "object", "description": "Critic 原始输出（node_a/node_b/direction/reasoning/new_nodes）" },
      "ast_ok":   { "type": "boolean", "description": "所有原子任务均通过 AST 检查时为 true" },
      "result":   { "type": "object", "description": "沙盒评估结果（ok/score/metrics/output_log/all_patches）" }
    }
  }
}

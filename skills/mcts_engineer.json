{
  "name": "mcts_engineer",
  "description": "根据原子任务（action/target/direction）生成替换或新建代码",
  "long_running": false,
  "owned_by": "configs/mcts_engineer.json",
  "input_schema": {
    "type": "object",
    "required": ["action", "target_file", "target_type", "target_name", "direction", "reasoning"],
    "properties": {
      "action":        { "type": "string", "description": "rewrite 或 create" },
      "target_file":   { "type": "string" },
      "target_type":   { "type": "string" },
      "target_name":   { "type": "string" },
      "original_code": { "type": "string", "description": "当前实现（create 时为空）" },
      "direction":     { "type": "string" },
      "reasoning":     { "type": "string" }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["code"],
    "properties": {
      "code": { "type": "string", "description": "替换或新建的代码字符串" }
    }
  }
}

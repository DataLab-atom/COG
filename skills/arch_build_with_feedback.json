{
  "name": "arch_build_with_feedback",
  "description": "将人类反馈与原始需求合并后重新运行 arch_build，生成融入反馈意见的新架构树",
  "long_running": false,
  "owned_by": "graphs/arch_build_with_feedback.json",
  "input_schema": {
    "type": "object",
    "required": ["requirement", "feedback"],
    "properties": {
      "requirement": {
        "type": "string",
        "description": "原始需求描述"
      },
      "feedback": {
        "type": "string",
        "description": "人类反馈文本"
      },
      "metric_name": {
        "type": "string",
        "description": "评估指标名（非空时锁定，防止重建后改变）",
        "default": ""
      },
      "direction": {
        "type": "string",
        "description": "优化方向 max 或 min",
        "default": ""
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "tree":        {"type": "array",   "description": "重建后的架构树（设计树，无 code 字段）"},
      "ok":          {"type": "boolean", "description": "静态校验是否通过"},
      "errors":      {"type": "array",   "description": "校验错误列表"},
      "metric_name": {"type": "string",  "description": "优化指标名称"},
      "direction":   {"type": "string",  "description": "优化方向（max / min）"}
    }
  }
}

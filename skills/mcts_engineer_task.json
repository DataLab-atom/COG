{
  "name": "mcts_engineer_task",
  "description": "单个原子 Engineer 任务：接收 action/target/direction，LLM 生成代码并经 AST 检查后返回 patch",
  "long_running": false,
  "owned_by": "graphs/mcts_engineer_task.json",
  "input_schema": {
    "type": "object",
    "required": ["action", "target_file", "target_type", "target_name", "direction", "reasoning"],
    "properties": {
      "action":        { "type": "string", "description": "rewrite 或 create" },
      "target_file":   { "type": "string", "description": "目标文件相对路径" },
      "target_type":   { "type": "string", "description": "function 或 class" },
      "target_name":   { "type": "string", "description": "目标节点名称" },
      "original_code": { "type": "string", "description": "当前实现代码（create 时为空）" },
      "direction":     { "type": "string", "description": "改造方向描述" },
      "reasoning":     { "type": "string", "description": "改造理由" }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok":    { "type": "boolean", "description": "是否通过 AST 检查" },
      "patch": { "type": ["object", "null"], "description": "通过检查的 patch 对象，含 action/target_file/target_type/target_name/code" },
      "error": { "type": "string", "description": "语法错误信息（ok=false 时有效）" }
    }
  }
}

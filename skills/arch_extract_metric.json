{
  "name": "arch_extract_metric",
  "description": "从用户需求描述中提取优化目标指标名称：若 metric_name 已提供则直接使用，否则从 requirement 文本中智能提取",
  "long_running": false,
  "owned_by": "configs/arch_extract_metric.json",
  "input_schema": {
    "type": "object",
    "required": ["metric_name", "requirement"],
    "properties": {
      "metric_name": {"type": "string", "description": "用户填写的指标名（可为空或占位符）"},
      "requirement": {"type": "string", "description": "用户需求描述文本"}
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "metric_name": {"type": "string", "description": "最终确定的优化指标名称"}
    }
  }
}

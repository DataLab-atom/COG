{
  "name": "mcts_ast_check",
  "description": "AST 语法检查：验证 LLM 生成的代码并构建 patch 对象",
  "long_running": false,
  "owned_by": "tools/mcts_ast_check.json",
  "input_schema": {
    "type": "object",
    "required": ["code", "target_file", "target_type", "target_name"],
    "properties": {
      "code":        { "type": "string" },
      "target_file": { "type": "string" },
      "target_type": { "type": "string" },
      "target_name": { "type": "string" }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["ok", "patch", "error"],
    "properties": {
      "ok":    { "type": "boolean" },
      "patch": { "type": ["object", "null"] },
      "error": { "type": "string" }
    }
  }
}

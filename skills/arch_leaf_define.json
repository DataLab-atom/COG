{
  "name": "arch_leaf_define",
  "description": "并发为每个文件定义叶子节点（无内部依赖的 type/fn），回填到文件树",
  "long_running": false,
  "owned_by": "graphs/arch_leaf_define.json",
  "input_schema": {
    "type": "object",
    "required": ["files", "requirement"],
    "properties": {
      "files": {
        "type": "array",
        "description": "arch_file_split 输出的文件列表"
      },
      "requirement": {
        "type": "string",
        "description": "原始需求描述"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["files", "global_ids"],
    "properties": {
      "files": {
        "type": "array",
        "description": "含叶子节点的文件列表"
      },
      "global_ids": {
        "type": "array",
        "description": "叶子阶段结束后的全局 id 列表"
      }
    }
  }
}

{
  "name": "papw_experiment_writing",
  "description": "实验章节写作：收集实验结果 → 规划大纲 → 递归执行 think/write 子任务 → 整合 → 优化 → 生成 LaTeX → 排版",
  "long_running": true,
  "owned_by": "graphs/papw_experiment_writing.json",
  "input_schema": {
    "type": "object",
    "required": ["papw_root", "result_perspective_path", "tex_template_path"],
    "properties": {
      "papw_root": { "type": "string", "description": "papw 工作根目录" },
      "result_perspective_path": { "type": "string", "description": "实验结果透视维度目录路径" },
      "tex_template_path": { "type": "string", "description": "LaTeX 模板路径" },
      "write_model_name": { "type": "string", "description": "写作模型名称" },
      "integration_model_name": { "type": "string", "description": "整合模型名称" },
      "improve_round": { "type": "integer", "description": "优化轮数" }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "tex_path": { "type": "string", "description": "输出 tex 文件路径" },
      "tex_code": { "type": "string", "description": "LaTeX 代码内容" }
    }
  }
}

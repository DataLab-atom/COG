{
  "name": "u2e_func_iter_patch",
  "description": "单函数单代进化（patch 模式）：多样性感知选择 → 短期反思 → 交叉生成 → 沙盒评估 → 结构化长期反思 → 变异生成 → 沙盒评估，返回本代所有已评估 individual（含 patches 字段）与更新后的结构化记忆",
  "long_running": true,
  "owned_by": "graphs/u2e_func_iter_patch.json",
  "input_schema": {
    "type": "object",
    "required": [
      "func_index", "func_name", "func_desc", "func_signature",
      "target_file", "target_type", "initial_funcs",
      "user_generator_prompt", "external_knowledge",
      "func_population", "problem_desc", "structured_memory",
      "func_elitist_for_func", "elitist", "elite_archive",
      "pop_size", "mutation_rate",
      "sandbox_in_ch", "iteration", "function_evals"
    ],
    "properties": {
      "func_index":            { "type": "integer",        "description": "当前函数下标" },
      "func_name":             { "type": "string",         "description": "当前函数名" },
      "func_desc":             { "type": "string",         "description": "当前函数描述" },
      "func_signature":        { "type": "string",         "description": "当前函数签名" },
      "target_file":           { "type": "string",         "description": "目标函数所在文件相对路径" },
      "target_type":           { "type": "string",         "description": "目标节点类型（function / class）" },
      "initial_funcs":         { "type": "array",          "description": "所有函数的初始代码列表（base_patches 应用后）" },
      "user_generator_prompt": { "type": "string",         "description": "user_generator 提示词" },
      "external_knowledge":    { "type": "string",         "description": "外部知识字符串" },
      "func_population":       { "type": "array",          "description": "此函数的历史 individual 列表（含 patches 字段）" },
      "problem_desc":          { "type": "string",         "description": "问题描述" },
      "structured_memory": {
        "type": "object",
        "description": "结构化长期记忆（principles / failed_patterns / best_tricks）；初始为 {}"
      },
      "func_elitist_for_func": { "type": ["object","null"], "description": "此函数的精英个体（可为 null）" },
      "elitist":               { "type": ["object","null"], "description": "全局精英个体（可为 null）" },
      "elite_archive":         { "type": "array",           "description": "当前精英档案列表；初始为 []" },
      "pop_size":              { "type": "integer",         "description": "种群大小" },
      "mutation_rate":         { "type": "number",          "description": "变异比例" },
      "sandbox_in_ch":         { "type": "string",          "description": "共享沙箱会话输入通道 ID" },
      "iteration":             { "type": "integer",         "description": "当前迭代号" },
      "function_evals":        { "type": "integer",         "description": "当前累计评估次数（各函数从 0 起独立计数）" }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["population", "new_structured_memory", "function_evals"],
    "properties": {
      "population":            { "type": "array",  "description": "本代所有已评估 individual 列表（含 patches / exec_success / obj / score）" },
      "new_structured_memory": { "type": "object", "description": "更新后的结构化记忆（principles / failed_patterns / best_tricks）" },
      "crossed_population":    { "type": "array",  "description": "交叉子代列表（含 exec_success / obj）" },
      "function_evals":        { "type": "integer","description": "本代结束后的累计评估次数" }
    }
  }
}

{
  "name": "arch_file_split",
  "description": "将模块列表并发拆分为文件列表，并验证文件间依赖无环",
  "long_running": false,
  "owned_by": "graphs/arch_file_split.json",
  "input_schema": {
    "type": "object",
    "required": ["modules", "requirement"],
    "properties": {
      "modules": {
        "type": "array",
        "description": "arch_module_split 输出的模块列表"
      },
      "requirement": {
        "type": "string",
        "description": "原始需求描述"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["files"],
    "properties": {
      "files": {
        "type": "array",
        "description": "所有文件定义列表（扁平 JSON）"
      }
    }
  }
}

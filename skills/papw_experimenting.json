{
  "name": "papw_experimenting",
  "description": "实验分析：摘要提取 → 研究方向推断 → 方法命名/陈述 → 分析角度生成 → 实验代码生成与执行 → 可视化 → 分析总结",
  "long_running": true,
  "owned_by": "graphs/papw_experimenting.json",
  "input_schema": {
    "type": "object",
    "required": ["papw_root", "bib_path", "experiment_vb_path", "md_dir"],
    "properties": {
      "papw_root":              { "type": "string",  "description": "papw 工作根目录" },
      "bib_path":               { "type": "string",  "description": "合并后的 .bib 文件路径" },
      "experiment_vb_path":     { "type": "string",  "description": "实验用 Chroma DB 路径" },
      "md_dir":                 { "type": "string",  "description": "论文 Markdown 文件目录" },
      "text_model_name":        { "type": "string",  "description": "文本模型" },
      "embedding_model":        { "type": "string",  "description": "嵌入模型" },
      "embedding_model_source": { "type": "string",  "description": "嵌入模型来源" },
      "reranker_path":          { "type": "string",  "description": "重排模型" },
      "reranker_model_source":  { "type": "string",  "description": "重排模型来源" },
      "database_device":        { "type": "string",  "description": "设备" }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "result_perspective_path": { "type": "string",  "description": "实验角度根目录" },
      "research_info_path":      { "type": "string",  "description": "研究信息 JSON 路径" },
      "perspectives":            { "type": "array",   "description": "角度名称列表" }
    }
  }
}

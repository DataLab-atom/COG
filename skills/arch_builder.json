{
  "name": "arch_builder",
  "description": "根据需求描述自动构建完整的 Python 项目架构树（module/file/type/fn），并通过静态检查",
  "long_running": false,
  "owned_by": "graphs/arch_build.json",
  "input_schema": {
    "type": "object",
    "required": ["requirement"],
    "properties": {
      "requirement": {
        "type": "string",
        "description": "自然语言需求描述，说明项目要实现什么功能"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["ok", "errors", "warnings", "tree"],
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "静态检查是否全部通过"
      },
      "errors": {
        "type": "array",
        "items": { "type": "string" },
        "description": "检查失败的错误列表"
      },
      "warnings": {
        "type": "array",
        "items": { "type": "string" },
        "description": "警告列表（如死函数）"
      },
      "tree": {
        "type": "array",
        "description": "完整的项目架构树（扁平 JSON 列表）"
      }
    }
  }
}

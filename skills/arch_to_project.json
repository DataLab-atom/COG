{
  "name": "arch_to_project",
  "description": "将架构树（arch_builder 输出）转换为可运行的 Python 项目文件",
  "long_running": false,
  "owned_by": "graphs/arch_to_project.json",
  "input_schema": {
    "type": "object",
    "required": ["tree", "output_dir", "metric_name"],
    "properties": {
      "tree": {
        "type": "array",
        "description": "arch_builder 输出的完整架构树"
      },
      "output_dir": {
        "type": "string",
        "description": "项目生成的目标目录路径"
      },
      "metric_name": {
        "type": "string",
        "description": "指标名称，例如 nmse、accuracy"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["ok", "syntax_errors", "written", "tree"],
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "语法检查是否全部通过"
      },
      "syntax_errors": {
        "type": "array",
        "items": { "type": "string" },
        "description": "语法错误列表"
      },
      "written": {
        "type": "array",
        "items": { "type": "string" },
        "description": "成功写入的文件路径列表"
      },
      "tree": {
        "type": "array",
        "description": "富化后的架构树，每个 fn:: 节点含 code 字段（函数实现代码字符串）"
      }
    }
  }
}
